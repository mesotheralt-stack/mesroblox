-- GetDataStore itself can throw before a Roblox experience is published.
local player=makePlayer(500)
task.spawn(function() Players.PlayerAdded:Fire(player) end)
advance(4)
local remote=ReplicatedStorage:WaitForChild("BrainrotRemotes"):WaitForChild("Action")
local result=remote.OnServerInvoke(player,"GetState")
assert(result.ok and result.state.persistenceEnabled==false,"Unpublished Studio must start in temporary mode")
assert(result.state.coins==Config.StartCoins,"Temporary mode must initialize normal starting progression")
assert(player.KickMessage==nil,"Studio player must not be kicked when DataStore initialization fails")
advance(61)
Players.PlayerRemoving:Fire(player)
assert(records.Player_500==nil and writes.Player_500==nil,"Unpublished Studio must never write temporary data")
assert(#warnings==3,"Expected initialization failure and two temporary-mode warnings")
print("PASS unpublished Studio DataStore initialization fallback (5 assertions)")
