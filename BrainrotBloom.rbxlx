      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- All economy and content tuning lives here. No paid products or external assets.
local Config = {}
Config.StartCoins = 150
Config.MaxBrainrots = 50
Config.MaxLevel = 100
Config.RotationSeconds = 300
Config.DigDuration = 10

Config.Rarities = {
	{id = "Common", name = "Common", color = Color3.fromRGB(177, 191, 180), weight = 5800, multiplier = 1, taps = 6},
	{id = "Uncommon", name = "Uncommon", color = Color3.fromRGB(131, 227, 108), weight = 2600, multiplier = 2.5, taps = 9},
	{id = "Rare", name = "Rare", color = Color3.fromRGB(84, 180, 255), weight = 1100, multiplier = 7, taps = 12},
	{id = "Epic", name = "Epic", color = Color3.fromRGB(193, 133, 255), weight = 380, multiplier = 20, taps = 16},
	{id = "Legendary", name = "Legendary", color = Color3.fromRGB(255, 200, 74), weight = 100, multiplier = 60, taps = 20},
	{id = "Mythic", name = "Mythic", color = Color3.fromRGB(255, 112, 157), weight = 19, multiplier = 160, taps = 25},
	{id = "Secret", name = "Secret", color = Color3.fromRGB(131, 255, 237), weight = 1, multiplier = 500, taps = 30},
}

Config.Worlds = {
	{id = "Meadow", name = "Clover Commons", unlockCost = 0, minPower = 1, maxRarity = 4, color = Color3.fromRGB(150, 229, 118), description = "A green beginning. Dig up Common through Epic creatures."},
	{id = "Dunes", name = "Sunset Sands", unlockCost = 8000, minPower = 4, maxRarity = 6, color = Color3.fromRGB(255, 193, 111), description = "A bigger signal. Mythic creatures hide below the warm sand."},
	{id = "Cosmic", name = "Moonbloom Crater", unlockCost = 125000, minPower = 6, maxRarity = 7, color = Color3.fromRGB(188, 161, 255), description = "The final frontier. A tiny chance of a Secret discovery."},
}

Config.Detectors = {
	{id = "twig", name = "Tin Twig", power = 2, speed = 4, price = 0, world = "Meadow", color = Color3.fromRGB(163, 177, 159)},
	{id = "copper", name = "Copper Chirper", power = 3, speed = 3.5, price = 650, world = "Meadow", color = Color3.fromRGB(230, 160, 107)},
	{id = "clover", name = "Clover Scanner", power = 4, speed = 3, price = 4200, world = "Meadow", color = Color3.fromRGB(162, 237, 124)},
	{id = "sunbeam", name = "Sunbeam Seeker", power = 5, speed = 2.5, price = 16000, world = "Dunes", color = Color3.fromRGB(255, 208, 102)},
	{id = "prism", name = "Prism Pulse", power = 6, speed = 2, price = 70000, world = "Dunes", color = Color3.fromRGB(255, 143, 183)},
	{id = "moon", name = "Moonbeam Array", power = 7, speed = 1.4, price = 240000, world = "Cosmic", color = Color3.fromRGB(180, 156, 255)},
	{id = "void", name = "Void Whisperer", power = 7, speed = 0.8, price = 800000, world = "Cosmic", color = Color3.fromRGB(129, 255, 230)},
}

Config.Foods = {
	{id = "crumb", name = "Suspicious Crumb", emoji = "🍞", xp = 25, price = 15, stock = 24},
	{id = "carrot", name = "Crunchy Carrot", emoji = "🥕", xp = 60, price = 40, stock = 20},
	{id = "apple", name = "Wobble Apple", emoji = "🍎", xp = 110, price = 80, stock = 18},
	{id = "banana", name = "Bonkers Banana", emoji = "🍌", xp = 180, price = 150, stock = 16},
	{id = "cookie", name = "Chaos Cookie", emoji = "🍪", xp = 300, price = 280, stock = 14},
	{id = "taco", name = "Turbo Taco", emoji = "🌮", xp = 500, price = 500, stock = 12},
	{id = "donut", name = "Disco Donut", emoji = "🍩", xp = 800, price = 900, stock = 10},
	{id = "pizza", name = "Party Pizza", emoji = "🍕", xp = 1250, price = 1600, stock = 9},
	{id = "sushi", name = "Silly Sushi", emoji = "🍣", xp = 2000, price = 2800, stock = 8},
	{id = "burger", name = "Galaxy Burger", emoji = "🍔", xp = 3200, price = 5000, stock = 7},
	{id = "cake", name = "Cloud Cake", emoji = "🍰", xp = 5000, price = 8500, stock = 6},
	{id = "melon", name = "Meteor Melon", emoji = "🍉", xp = 7500, price = 14000, stock = 5},
	{id = "honey", name = "Mythic Honey", emoji = "🍯", xp = 11000, price = 23000, stock = 4},
	{id = "star", name = "Stardust Sorbet", emoji = "🍨", xp = 16000, price = 36000, stock = 3},
	{id = "feast", name = "Secret Midnight Feast", emoji = "🍱", xp = 24000, price = 60000, stock = 2},
}

Config.Boosts = {
	Growth = {name = "Growth Juice", price = 500, duration = 300},
	Income = {name = "Golden Hour", price = 1000, duration = 300},
}

-- Original names and procedural silhouettes; every species has its own palette.
Config.Creatures = {
	{id = "sprout", name = "Sproutini Spaghetti", rarity = "Common", color = Color3.fromRGB(144, 211, 113), accent = Color3.fromRGB(255, 226, 135), shape = "sprout"},
	{id = "toast", name = "Toasto Bamboozlo", rarity = "Common", color = Color3.fromRGB(231, 171, 109), accent = Color3.fromRGB(255, 230, 168), shape = "toast"},
	{id = "pebble", name = "Pebblino Wobblino", rarity = "Common", color = Color3.fromRGB(172, 185, 201), accent = Color3.fromRGB(249, 176, 188), shape = "rock"},
	{id = "frog", name = "Froggolini Ravioli", rarity = "Uncommon", color = Color3.fromRGB(111, 211, 127), accent = Color3.fromRGB(255, 226, 130), shape = "frog"},
	{id = "mushroom", name = "Mushmello Jellino", rarity = "Uncommon", color = Color3.fromRGB(255, 174, 199), accent = Color3.fromRGB(255, 246, 217), shape = "mushroom"},
	{id = "bee", name = "Buzzetti Confetti", rarity = "Uncommon", color = Color3.fromRGB(255, 207, 92), accent = Color3.fromRGB(97, 76, 63), shape = "bee"},
	{id = "shark", name = "Sharkuccino Slippers", rarity = "Rare", color = Color3.fromRGB(111, 181, 236), accent = Color3.fromRGB(255, 210, 129), shape = "shark"},
	{id = "cactus", name = "Cactini Linguini", rarity = "Rare", color = Color3.fromRGB(94, 195, 161), accent = Color3.fromRGB(255, 145, 197), shape = "cactus"},
	{id = "cloud", name = "Cloudolini Macaroni", rarity = "Rare", color = Color3.fromRGB(188, 225, 255), accent = Color3.fromRGB(140, 150, 245), shape = "cloud"},
	{id = "octopus", name = "Octopesto Presto", rarity = "Epic", color = Color3.fromRGB(189, 138, 242), accent = Color3.fromRGB(255, 208, 143), shape = "octopus"},
	{id = "disco", name = "Disco Dodo Deluxe", rarity = "Epic", color = Color3.fromRGB(239, 133, 220), accent = Color3.fromRGB(139, 245, 219), shape = "bird"},
	{id = "wizard", name = "Wizzaroni Pepperoni", rarity = "Epic", color = Color3.fromRGB(160, 142, 240), accent = Color3.fromRGB(255, 210, 109), shape = "wizard"},
	{id = "lion", name = "Lionardo Lemonardo", rarity = "Legendary", color = Color3.fromRGB(255, 208, 98), accent = Color3.fromRGB(224, 131, 76), shape = "lion"},
	{id = "dragon", name = "Dragolato Gelato", rarity = "Legendary", color = Color3.fromRGB(255, 164, 116), accent = Color3.fromRGB(158, 242, 195), shape = "dragon"},
	{id = "sun", name = "Solini Gnocchini", rarity = "Legendary", color = Color3.fromRGB(255, 227, 115), accent = Color3.fromRGB(255, 157, 110), shape = "sun"},
	{id = "phoenix", name = "Phoeniccini Fettuccine", rarity = "Mythic", color = Color3.fromRGB(255, 116, 151), accent = Color3.fromRGB(255, 216, 126), shape = "phoenix"},
	{id = "moon", name = "Lunatici Mochi", rarity = "Mythic", color = Color3.fromRGB(202, 166, 255), accent = Color3.fromRGB(255, 194, 233), shape = "moon"},
	{id = "jelly", name = "Jellybean Astronautini", rarity = "Mythic", color = Color3.fromRGB(255, 160, 218), accent = Color3.fromRGB(164, 244, 255), shape = "jelly"},
	{id = "void", name = "Voidolini Neveroni", rarity = "Secret", color = Color3.fromRGB(73, 62, 117), accent = Color3.fromRGB(130, 255, 224), shape = "void"},
	{id = "cosmic", name = "Cosmic Capybaroni", rarity = "Secret", color = Color3.fromRGB(153, 230, 218), accent = Color3.fromRGB(255, 220, 151), shape = "capybara"},
	{id = "crown", name = "Emperor Noodlestar", rarity = "Secret", color = Color3.fromRGB(220, 202, 255), accent = Color3.fromRGB(255, 218, 113), shape = "crown"},
}

function Config.get(list, id)
	for _, item in ipairs(list) do
		if item.id == id then return item end
	end
	return nil
end

function Config.xpNeeded(level: number): number
	return math.floor(40 + 18 * level ^ 1.2)
end

function Config.income(specId: string, level: number): number
	local spec = Config.get(Config.Creatures, specId)
	if not spec then return 0 end
	local rarity = Config.get(Config.Rarities, spec.rarity)
	local growth = math.clamp(level, 1, Config.MaxLevel) - 1
	return math.floor(2 * rarity.multiplier * (1 + growth * 0.24) ^ 1.15) + growth
end

function Config.sellValue(specId: string, level: number): number
	return Config.income(specId, level) * 45
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">CreatureFactory</string>
          <string name="Source"><![CDATA[-- Original, dependency-free toy creatures. Every piece is anchored for use in
-- world displays and ViewportFrames; callers move the result with PivotTo.
local CreatureFactory = {}

local function piece(model, name, size, position, color, shape, rotation)
	local part = Instance.new(shape == "Wedge" and "WedgePart" or "Part")
	part.Name = name
	part.Size = size
	part.CFrame = CFrame.new(position) * (rotation or CFrame.new())
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if shape and shape ~= "Wedge" then part.Shape = shape end
	part.Parent = model
	return part
end

function CreatureFactory.create(spec, scale)
	local model = Instance.new("Model")
	model.Name = spec.name or "Brainrot"
	local color = spec.color or Color3.fromRGB(158, 225, 110)
	local accent = spec.accent or Color3.fromRGB(255, 210, 91)
	local white = Color3.fromRGB(255, 253, 242)
	local ink = Color3.fromRGB(28, 38, 42)
	local shape = string.lower(spec.shape or "blob")
	local root = piece(model, "Root", Vector3.new(0.2, 0.2, 0.2), Vector3.zero, color)
	root.Transparency = 1
	model.PrimaryPart = root
	local proportions = {
		toast = Vector3.new(2.65, 2.9, 1.6), rock = Vector3.new(2.9, 2.65, 2.4),
		frog = Vector3.new(3.15, 2.7, 2.5), bee = Vector3.new(2.6, 2.9, 2.5),
		shark = Vector3.new(2.7, 3.2, 2.7), cactus = Vector3.new(2.3, 3.35, 2.0),
		octopus = Vector3.new(3.1, 2.85, 2.5), bird = Vector3.new(2.5, 3.0, 2.4),
		dragon = Vector3.new(2.7, 3.25, 2.5), capybara = Vector3.new(3.0, 2.8, 2.7),
	}
	piece(model, "Body", proportions[shape] or Vector3.new(2.8, 3.1, 2.2), Vector3.new(0, 2.3, 0), color, Enum.PartType.Ball)
	piece(model, "BellyPatch", Vector3.new(1.55, 1.3, 0.22), Vector3.new(0, 1.58, -0.96), color:Lerp(white, 0.36), Enum.PartType.Ball)
	piece(model, "LeftFoot", Vector3.new(0.95, 0.55, 1.4), Vector3.new(-0.75, 0.45, -0.3), accent, Enum.PartType.Ball)
	piece(model, "RightFoot", Vector3.new(0.95, 0.55, 1.4), Vector3.new(0.75, 0.45, -0.3), accent, Enum.PartType.Ball)
	for _, side in {-1, 1} do
		local x = side * 0.62
		piece(model, "EyeWhite", Vector3.new(0.88, 1.05, 0.4), Vector3.new(x, 2.9, -1.02), white, Enum.PartType.Ball)
		piece(model, "Pupil", Vector3.new(0.38, 0.54, 0.18), Vector3.new(x + 0.06, 2.9, -1.24), ink, Enum.PartType.Ball)
		piece(model, "Glint", Vector3.new(0.12, 0.16, 0.08), Vector3.new(x - 0.02, 3.05, -1.34), white, Enum.PartType.Ball)
		piece(model, "Cheek", Vector3.new(0.45, 0.22, 0.15), Vector3.new(side * 0.99, 2.34, -0.93), Color3.fromRGB(255, 151, 143), Enum.PartType.Ball)
		piece(model, "Arm", Vector3.new(0.55, 1.3, 0.6), Vector3.new(side * 1.35, 2.0, 0), accent, Enum.PartType.Ball, CFrame.Angles(0, 0, side * 0.5))
	end
	piece(model, "Smile", Vector3.new(0.65, 0.14, 0.18), Vector3.new(0, 2.13, -1.08), ink, Enum.PartType.Ball)

	-- Familiar silhouettes with silly original combinations; unrecognised shape
	-- names still produce a complete creature with a tuft.
	if string.find(shape, "toast") or string.find(shape, "bread") then
		piece(model, "ToastCrust", Vector3.new(3.0, 2.9, 0.8), Vector3.new(0, 2.5, 0.65), accent)
		piece(model, "ToastCenter", Vector3.new(2.5, 2.4, 0.12), Vector3.new(0, 2.55, -0.05), color)
	elseif string.find(shape, "mush") then
		piece(model, "MushroomCap", Vector3.new(4.0, 1.4, 3.4), Vector3.new(0, 3.9, 0), accent, Enum.PartType.Ball)
		for i = 1, 5 do
			local angle = i * math.pi * 2 / 5
			piece(model, "CapSpot", Vector3.new(0.5, 0.16, 0.5), Vector3.new(math.cos(angle) * 1.1, 4.45, math.sin(angle) * 0.8), white, Enum.PartType.Ball)
		end
	elseif string.find(shape, "cat") or string.find(shape, "bunny") then
		for _, side in {-1, 1} do
			piece(model, "Ear", Vector3.new(0.72, string.find(shape, "bunny") and 2.1 or 1.25, 0.7), Vector3.new(side * 0.9, 4.0, 0), accent, Enum.PartType.Ball, CFrame.Angles(0, 0, side * -0.2))
		end
	elseif string.find(shape, "crown") or string.find(shape, "king") then
		piece(model, "CrownBand", Vector3.new(2.4, 0.45, 2.0), Vector3.new(0, 3.9, 0), accent)
		for i = -1, 1 do
			piece(model, "CrownPoint", Vector3.new(0.45, 0.9, 0.45), Vector3.new(i * 0.8, 4.45, 0), accent)
		end
	elseif string.find(shape, "planet") or string.find(shape, "cosmic") then
		local ring = piece(model, "Orbit", Vector3.new(0.18, 5.0, 5.0), Vector3.new(0, 2.5, 0), accent, Enum.PartType.Cylinder, CFrame.Angles(0, 0, math.rad(65)))
		ring.Transparency = 0.32
		ring.Material = Enum.Material.Neon
	elseif string.find(shape, "cactus") then
		for i = 1, 6 do
			local angle = i * math.pi / 3
			piece(model, "Spine", Vector3.new(0.16, 0.65, 0.16), Vector3.new(math.cos(angle) * 1.2, 3.3, math.sin(angle)), white, nil, CFrame.Angles(0, 0, angle))
		end
	elseif string.find(shape, "coffee") or string.find(shape, "cup") then
		piece(model, "CupRim", Vector3.new(0.25, 2.7, 2.7), Vector3.new(0, 3.7, 0), accent, Enum.PartType.Cylinder, CFrame.Angles(0, 0, math.pi / 2))
		piece(model, "Coffee", Vector3.new(0.28, 2.25, 2.25), Vector3.new(0, 3.85, 0), Color3.fromRGB(92, 49, 33), Enum.PartType.Cylinder, CFrame.Angles(0, 0, math.pi / 2))
		piece(model, "Handle", Vector3.new(1.0, 1.6, 0.7), Vector3.new(1.65, 2.65, 0), accent, Enum.PartType.Ball)
	elseif shape == "sprout" then
		piece(model, "Stem", Vector3.new(0.22, 1.4, 0.22), Vector3.new(0, 4.0, 0), accent)
		for _, side in {-1, 1} do
			piece(model, "Leaf", Vector3.new(1.4, 0.4, 0.8), Vector3.new(side * 0.6, 4.5, 0), color, Enum.PartType.Ball, CFrame.Angles(0, 0, side * 0.4))
		end
	elseif shape == "rock" then
		for i = 1, 5 do
			local angle = i * math.pi * 2 / 5
			piece(model, "PebbleCrest", Vector3.new(0.7, 0.6, 0.7), Vector3.new(math.cos(angle) * 0.65, 3.65, math.sin(angle) * 0.5), accent, Enum.PartType.Ball)
		end
	elseif shape == "frog" then
		for _, side in {-1, 1} do
			piece(model, "FrogEyeStalk", Vector3.new(1.0, 1.0, 0.9), Vector3.new(side * 0.83, 3.65, -0.2), color, Enum.PartType.Ball)
			piece(model, "FrogSpot", Vector3.new(0.4, 0.15, 0.5), Vector3.new(side * 0.95, 3.92, -0.45), accent, Enum.PartType.Ball)
		end
	elseif shape == "bee" then
		for _, side in {-1, 1} do
			local wing = piece(model, "Wing", Vector3.new(1.9, 2.8, 0.25), Vector3.new(side * 1.5, 3.1, 0.7), white, Enum.PartType.Ball, CFrame.Angles(0, 0, side * -0.6))
			wing.Transparency = 0.3
			piece(model, "Antenna", Vector3.new(0.15, 1.1, 0.15), Vector3.new(side * 0.7, 4.1, 0), accent, nil, CFrame.Angles(0, 0, side * -0.3))
			piece(model, "AntennaTip", Vector3.new(0.4, 0.4, 0.4), Vector3.new(side * 0.85, 4.6, 0), accent, Enum.PartType.Ball)
		end
		piece(model, "BeeStripe", Vector3.new(2.7, 0.35, 0.3), Vector3.new(0, 1.7, -0.8), accent)
	elseif shape == "shark" then
		piece(model, "DorsalFin", Vector3.new(0.45, 1.7, 1.2), Vector3.new(0, 4.0, 0.4), accent, nil, CFrame.Angles(math.rad(-25), 0, 0))
		piece(model, "SharkTail", Vector3.new(0.7, 2.3, 0.5), Vector3.new(0, 2.4, 1.7), color, nil, CFrame.Angles(0, 0, math.rad(35)))
		for _, side in {-1, 1} do
			piece(model, "SideFin", Vector3.new(1.5, 0.35, 1.0), Vector3.new(side * 1.65, 2.5, 0.1), color, nil, CFrame.Angles(0, 0, side * -0.3))
		end
	elseif shape == "cloud" then
		for i = -1, 1 do
			piece(model, "CloudPuff", Vector3.new(1.7, 1.6, 1.7), Vector3.new(i * 0.85, 3.8 + (1 - math.abs(i)) * 0.3, 0), white, Enum.PartType.Ball)
		end
	elseif shape == "octopus" or shape == "jelly" then
		for i = 1, 8 do
			local angle = i * math.pi / 4
			piece(model, "Tentacle", Vector3.new(0.6, 0.8, 1.7), Vector3.new(math.sin(angle) * 1.1, 0.65, math.cos(angle) * 0.9), accent, Enum.PartType.Ball, CFrame.Angles(0, angle, 0))
		end
		if shape == "jelly" then
			local dome = piece(model, "SpaceHelmet", Vector3.new(3.6, 3.8, 3.0), Vector3.new(0, 2.7, 0), white, Enum.PartType.Ball)
			dome.Transparency = 0.8
		end
	elseif shape == "bird" or shape == "phoenix" or shape == "dragon" then
		for _, side in {-1, 1} do
			for feather = 1, 3 do
				piece(model, "WingFeather", Vector3.new(0.6, 2.6 - feather * 0.3, 0.65), Vector3.new(side * (1.3 + feather * 0.35), 2.65, 0.2), feather % 2 == 0 and color or accent, Enum.PartType.Ball, CFrame.Angles(0, 0, side * -0.65))
			end
		end
		piece(model, "Beak", Vector3.new(0.65, 0.55, 0.7), Vector3.new(0, 2.4, -1.2), accent, Enum.PartType.Ball)
		if shape == "dragon" then
			for _, side in {-1, 1} do
				piece(model, "DragonHorn", Vector3.new(0.45, 1.5, 0.45), Vector3.new(side * 0.8, 4.0, 0), white, nil, CFrame.Angles(0, 0, side * -0.3))
			end
			piece(model, "DragonTail", Vector3.new(0.7, 0.8, 2.7), Vector3.new(0, 1.3, 1.7), color, Enum.PartType.Ball)
		elseif shape == "phoenix" then
			for i = -1, 1 do
				local flame = piece(model, "FlameCrest", Vector3.new(0.45, 1.7 - math.abs(i) * 0.3, 0.5), Vector3.new(i * 0.55, 4.1, 0), accent, Enum.PartType.Ball, CFrame.Angles(0, 0, i * -0.2))
				flame.Material = Enum.Material.Neon
			end
			piece(model, "PhoenixTail", Vector3.new(1.5, 0.5, 2.5), Vector3.new(0, 1.8, 1.5), accent, Enum.PartType.Ball)
		else
			for i = -1, 1 do
				piece(model, "DiscoCrest", Vector3.new(0.45, 1.2, 0.45), Vector3.new(i * 0.45, 4.0, 0), accent, Enum.PartType.Ball)
			end
		end
	elseif shape == "wizard" then
		piece(model, "HatBrim", Vector3.new(0.2, 3.5, 3.5), Vector3.new(0, 3.8, 0), accent, Enum.PartType.Cylinder, CFrame.Angles(0, 0, math.pi / 2))
		piece(model, "WizardHat", Vector3.new(1.7, 1.8, 1.7), Vector3.new(0, 4.5, 0), color)
		piece(model, "HatTip", Vector3.new(0.8, 1.1, 0.8), Vector3.new(0.3, 5.7, 0), accent, nil, CFrame.Angles(0, 0, -0.3))
	elseif shape == "sun" or shape == "lion" then
		for i = 1, 12 do
			local angle = i * math.pi / 6
			piece(model, "ManeRay", Vector3.new(0.6, 1.3, 0.5), Vector3.new(math.sin(angle) * 1.8, 2.6 + math.cos(angle) * 1.8, 0.3), accent, shape == "lion" and Enum.PartType.Ball or nil, CFrame.Angles(0, 0, -angle))
		end
	elseif shape == "moon" or shape == "void" then
		for i = 1, 5 do
			local angle = i * math.pi * 2 / 5
			local star = piece(model, "OrbitStar", Vector3.new(0.45, 0.45, 0.45), Vector3.new(math.cos(angle) * 2.2, 3.1 + math.sin(angle) * 1.6, 0), accent, nil, CFrame.Angles(0, 0, math.pi / 4))
			star.Material = Enum.Material.Neon
		end
		if shape == "void" then
			for i = 1, 20 do
				local a, b = i * math.pi / 10, (i + 1) * math.pi / 10
				local p = Vector3.new(math.cos(a) * 2.35, 2.65 + math.sin(a) * 1.1, math.sin(a) * 1.9)
				local q = Vector3.new(math.cos(b) * 2.35, 2.65 + math.sin(b) * 1.1, math.sin(b) * 1.9)
				local ring = piece(model, "VoidHalo", Vector3.new(0.12, 0.12, (q - p).Magnitude + 0.05), (p + q) / 2, accent, nil, CFrame.lookAt(Vector3.zero, q - p))
				ring.Material = Enum.Material.Neon
			end
		else
			for i = 0, 7 do
				local a = -1.1 + i * 0.32
				piece(model, "MoonCrescent", Vector3.new(0.65, 0.65, 0.5), Vector3.new(1.1 + math.cos(a) * 1.2, 3.1 + math.sin(a) * 1.2, 0.3), accent, Enum.PartType.Ball)
			end
		end
	elseif shape == "capybara" then
		for _, side in {-1, 1} do
			piece(model, "RoundEar", Vector3.new(0.8, 0.9, 0.6), Vector3.new(side * 1.0, 3.65, 0), accent, Enum.PartType.Ball)
		end
		piece(model, "Snout", Vector3.new(1.2, 0.75, 0.5), Vector3.new(0, 2.0, -1.08), accent, Enum.PartType.Ball)
		piece(model, "Nose", Vector3.new(0.4, 0.2, 0.16), Vector3.new(0, 2.25, -1.38), ink, Enum.PartType.Ball)
	else
		for i = -1, 1 do
			piece(model, "SillyTuft", Vector3.new(0.55, 1.05 - math.abs(i) * 0.2, 0.55), Vector3.new(i * 0.55, 3.9, 0), accent, Enum.PartType.Ball, CFrame.Angles(0, 0, i * -0.35))
		end
	end
	-- Small, deliberately placed details give each collectible a toy-like finish.
	-- Keep the geometry bounded: no textures, emitters, scripts, or downloaded models.
	local pale = accent:Lerp(white, 0.45)
	local shade = color:Lerp(ink, 0.22)
	local function dot(name, position, size, tint)
		return piece(model, name, Vector3.new(size, size, size), position, tint or pale, Enum.PartType.Ball)
	end
	local function rod(name, a, b, width, tint)
		return piece(model, name, Vector3.new(width, width, (b-a).Magnitude), (a+b)/2, tint or accent, nil, CFrame.lookAt(Vector3.zero, b-a))
	end
	local function orbit(name, center, radius, tint, count)
		for i = 1, count or 12 do
			local a = (i-1) * math.pi*2/(count or 12)
			local b = i * math.pi*2/(count or 12)
			rod(name, center+Vector3.new(math.cos(a)*radius,0,math.sin(a)*radius), center+Vector3.new(math.cos(b)*radius,0,math.sin(b)*radius), 0.12, tint)
		end
	end
	for _, side in {-1, 1} do
		piece(model, "Eyebrow", Vector3.new(0.65, 0.12, 0.14), Vector3.new(side*0.62,3.5,-0.97), shade, Enum.PartType.Ball, CFrame.Angles(0,0,side*-0.12))
		dot("TinyEyeGlint", Vector3.new(side*0.62+0.16,2.77,-1.35),0.09,white)
		for toe = 1, 2 do
			piece(model, "ToeSeam", Vector3.new(0.045,0.07,0.32),Vector3.new(side*0.75+(toe-1.5)*0.21,0.64,-0.8),accent:Lerp(ink,0.22))
		end
	end
	if shape == "toast" then
		for i = 1, 7 do
			local x = ((i*7)%11-5)*0.19
			dot("ToastedFreckle",Vector3.new(x,1.6+(i%3)*0.5,-0.89),0.13,shade)
		end
		piece(model,"ButterPat",Vector3.new(0.75,0.15,0.7),Vector3.new(0.2,3.9,0),Color3.fromRGB(255,231,132),nil,CFrame.Angles(0,0.2,0.1))
	elseif shape == "sprout" then
		piece(model,"PastaScarf",Vector3.new(2.1,0.25,1.7),Vector3.new(0,1.1,0),accent,Enum.PartType.Ball)
		for i=1,3 do
			rod("NoodleStrand",Vector3.new(0.75+i*0.12,1.2,-0.45),Vector3.new(0.75+i*0.12,0.65,-0.65),0.12,accent)
		end
		for _,side in {-1,1} do
			rod("LeafVein",Vector3.new(side*0.13,4.55,-0.05),Vector3.new(side*1.06,4.7,-0.05),0.06,pale)
		end
	elseif shape == "rock" then
		for i=1,5 do
			dot("MineralFleck",Vector3.new(-1.0+(i%3)*0.28,1.4+math.floor(i/3)*0.26,-0.98),0.17,pale)
		end
		rod("StoneCrack",Vector3.new(0.7,3.65,-0.45),Vector3.new(0.94,3.32,-0.85),0.07,shade)
		rod("StoneCrack",Vector3.new(0.94,3.32,-0.85),Vector3.new(1.15,3.22,-0.7),0.07,shade)
	elseif shape == "frog" then
		for _,side in {-1,1} do
			piece(model,"Haunch",Vector3.new(1.15,1.0,1.25),Vector3.new(side*1.27,1.05,0.35),shade,Enum.PartType.Ball)
			for i=1,3 do dot("WebbedToe",Vector3.new(side*1.35+(i-2)*0.22,0.35,-0.3),0.3,accent) end
			dot("FrogEye",Vector3.new(side*0.83,3.79,-0.64),0.48,white)
			dot("FrogPupil",Vector3.new(side*0.83,3.79,-0.86),0.24,ink)
		end
	elseif shape == "mushroom" then
		for i=1,9 do
			local a=i*math.pi*2/9
			rod("CapGills",Vector3.new(math.cos(a)*0.55,3.65,math.sin(a)*0.4),Vector3.new(math.cos(a)*1.65,3.65,math.sin(a)*1.25),0.065,pale)
		end
		piece(model,"MushroomCollar",Vector3.new(2.3,0.24,1.8),Vector3.new(0,1.1,0),white,Enum.PartType.Ball)
	elseif shape == "bee" then
		for i=1,3 do
			piece(model,"BackStripe",Vector3.new(2.1,0.18,0.35),Vector3.new(0,1.65+i*0.45,1.0),accent,Enum.PartType.Ball)
		end
		for _,side in {-1,1} do
			rod("WingVein",Vector3.new(side*1.2,2.6,0.55),Vector3.new(side*2.0,4.0,0.55),0.06,pale)
		end
		piece(model,"Stinger",Vector3.new(0.45,0.7,0.65),Vector3.new(0,1.0,1.2),accent,"Wedge")
	elseif shape == "shark" then
		for _,side in {-1,1} do
			for i=1,3 do rod("Gill",Vector3.new(side*1.1,2.0+i*0.22,-0.7),Vector3.new(side*1.3,1.88+i*0.22,-0.25),0.065,shade) end
			piece(model,"SlipperSole",Vector3.new(1.1,0.15,1.8),Vector3.new(side*0.75,0.22,-0.35),white,Enum.PartType.Ball)
		end
		for i=-1,1 do piece(model,"SharkTooth",Vector3.new(0.14,0.23,0.1),Vector3.new(i*0.18,2.01,-1.19),white,"Wedge") end
	elseif shape == "cactus" then
		for _,side in {-1,1} do
			piece(model,"CactusBranch",Vector3.new(0.65,1.6,0.65),Vector3.new(side*1.5,2.6,0),color,Enum.PartType.Ball)
			for i=1,4 do dot("SpineBud",Vector3.new(side*0.9,1.35+i*0.43,-0.67),0.11,white) end
		end
		for i=1,5 do local a=i*math.pi*2/5; dot("FlowerPetal",Vector3.new(math.cos(a)*0.38,4.0,math.sin(a)*0.38),0.53,accent) end
		dot("FlowerCenter",Vector3.new(0,4.18,0),0.35,Color3.fromRGB(255,220,128))
	elseif shape == "cloud" then
		for i=1,5 do
			dot("CloudCurl",Vector3.new(-1.4+i*0.45,1.05,0.55),0.65,white)
		end
		for _,side in {-1,1} do
			rod("RaindropTrail",Vector3.new(side*1.65,1.9,0),Vector3.new(side*1.65,1.4,0),0.08,accent)
			dot("Raindrop",Vector3.new(side*1.65,1.25,0),0.28,accent)
		end
	elseif shape == "octopus" or shape == "jelly" then
		for i=1,8 do
			local a=i*math.pi/4
			for j=1,2 do dot("SuctionCup",Vector3.new(math.sin(a)*(1.1+j*0.21),0.41,math.cos(a)*(1+j*0.21)),0.2,pale) end
		end
		if shape == "jelly" then
			orbit("HelmetSeal",Vector3.new(0,1.05,0),1.43,white,12)
			piece(model,"OxygenPack",Vector3.new(1.35,1.45,0.65),Vector3.new(0,2.3,1.3),accent)
			dot("SuitBadge",Vector3.new(0,1.55,-1.12),0.4,accent)
		else
			for i=1,4 do dot("HeadFreckle",Vector3.new(-0.7+i*0.28,3.52,-0.55),0.16,pale) end
		end
	elseif shape == "bird" or shape == "phoenix" or shape == "dragon" then
		for _,side in {-1,1} do
			for i=1,3 do
				rod("FeatherVein",Vector3.new(side*(1.3+i*0.35),2.2,0.0),Vector3.new(side*(1.6+i*0.35),3.1,0.0),0.065,pale)
			end
		end
		if shape == "dragon" then
			for i=1,5 do
				piece(model,"SpineScale",Vector3.new(0.42,0.6,0.55),Vector3.new(0,3.6-i*0.33,0.9+i*0.22),accent,"Wedge")
			end
			for _,side in {-1,1} do dot("Nostril",Vector3.new(side*0.23,2.52,-1.5),0.13,ink) end
		elseif shape == "phoenix" then
			for i=-1,1 do
				piece(model,"LongTailPlume",Vector3.new(0.38,0.3,2.6-math.abs(i)*0.3),Vector3.new(i*0.42,1.5,2.0),i==0 and color or accent,Enum.PartType.Ball,CFrame.Angles(0,i*0.22,0))
			end
		else
			piece(model,"DiscoVisor",Vector3.new(1.9,0.18,0.2),Vector3.new(0,3.22,-1.13),accent)
			for i=-1,1 do dot("DiscoSequin",Vector3.new(i*0.45,1.6,-1.11),0.19,pale) end
		end
	elseif shape == "wizard" then
		orbit("HatRibbon",Vector3.new(0,4.1,0),0.98,accent,10)
		for i=1,3 do
			piece(model,"HatRune",Vector3.new(0.18,0.18,0.08),Vector3.new((i-2)*0.4,4.6+(i%2)*0.35,-0.89),pale,nil,CFrame.Angles(0,0,math.pi/4))
		end
		rod("MagicWand",Vector3.new(1.55,1.3,-0.1),Vector3.new(1.95,3.4,-0.1),0.15,shade)
		dot("WandGem",Vector3.new(1.95,3.5,-0.1),0.44,accent)
	elseif shape == "lion" then
		for _,side in {-1,1} do
			piece(model,"Muzzle",Vector3.new(0.63,0.53,0.3),Vector3.new(side*0.27,2.05,-1.05),pale,Enum.PartType.Ball)
			for i=1,2 do rod("Whisker",Vector3.new(side*0.65,2.0,-1.1),Vector3.new(side*1.15,2.1+(i-1)*0.15,-1.02),0.035,ink) end
		end
		dot("LionNose",Vector3.new(0,2.24,-1.27),0.26,shade)
	elseif shape == "sun" then
		orbit("SunCrown",Vector3.new(0,3.85,0),0.8,pale,10)
		for i=1,6 do
			local a=i*math.pi/3
			dot("SunSpark",Vector3.new(math.sin(a)*2.12,2.6+math.cos(a)*2.12,0.3),0.24,pale)
		end
	elseif shape == "moon" then
		for i=1,4 do
			dot("MoonCrater",Vector3.new(-1.0+(i%2)*0.28,1.4+math.floor(i/2)*0.43,-0.85),0.23,shade)
		end
		piece(model,"MochiWrap",Vector3.new(2.4,0.45,2.0),Vector3.new(0,0.9,0),accent,Enum.PartType.Ball)
	elseif shape == "void" then
		for i=1,4 do
			local glyph=piece(model,"VoidGlyph",Vector3.new(0.18,0.18,0.09),Vector3.new(-0.48+(i%3)*0.24,1.2+math.floor(i/3)*0.3,-1.03),accent,nil,CFrame.Angles(0,0,math.pi/4))
			glyph.Material=Enum.Material.Neon
		end
		orbit("SatelliteOrbit",Vector3.new(0,4.25,0),1.15,accent,12)
	elseif shape == "capybara" then
		for _,side in {-1,1} do
			piece(model,"InnerEar",Vector3.new(0.43,0.52,0.13),Vector3.new(side*1.0,3.68,-0.27),pale,Enum.PartType.Ball)
			dot("SnoutFreckle",Vector3.new(side*0.36,2.05,-1.34),0.12,shade)
		end
		piece(model,"StarSatchel",Vector3.new(0.8,0.85,0.55),Vector3.new(1.45,1.25,0.15),accent)
		rod("SatchelStrap",Vector3.new(-0.9,3.4,-0.85),Vector3.new(1.25,1.65,-0.85),0.12,accent)
	elseif shape == "crown" then
		orbit("RoyalCollar",Vector3.new(0,1.12,0),1.1,accent,12)
		for i=-1,1 do
			dot("CrownGem",Vector3.new(i*0.8,4.15,-1.06),0.24,i==0 and color or pale)
			dot("CrownPearl",Vector3.new(i*0.8,4.92,0),0.25,pale)
		end
		piece(model,"RoyalCape",Vector3.new(2.5,2.45,0.25),Vector3.new(0,2.0,1.05),color:Lerp(ink,0.35))
	end
	local rarity = string.lower(spec.rarity or "")
	if rarity == "secret" or rarity == "mythic" then
		local light = Instance.new("PointLight")
		light.Color = accent
		light.Brightness = 0.7
		light.Range = 9
		light.Parent = root
	end
	if scale and scale ~= 1 then model:ScaleTo(math.clamp(scale, 0.1, 5)) end
	return model
end

return CreatureFactory
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">BrainrotServer</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">DetectorTool</string>
          <string name="Source"><![CDATA[-- Cosmetic, physically welded detector. Capture authority stays in Main.server.
local DetectorTool = {}

local function removeOld(container)
	if not container then return end
	for _, child in container:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("BrainrotDetector") then child:Destroy() end
	end
end

function DetectorTool.equip(player, spec)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	if not backpack or not character then return end
	removeOld(backpack)
	removeOld(character)
	local tool = Instance.new("Tool")
	tool.Name = spec.name
	tool.ToolTip = "Search the sand • use DIG or press E"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("BrainrotDetector", true)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.38, 1.15, 0.4)
	handle.Color = Color3.fromRGB(35, 43, 49)
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.CanTouch = false
	handle.Massless = true
	handle.Parent = tool
	local function piece(name, size, frame, color, shape)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.CFrame = frame
		part.Color = color
		part.Material = Enum.Material.Metal
		part.CanCollide = false
		part.CanTouch = false
		part.Massless = true
		if shape then part.Shape = shape end
		part.Parent = tool
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = part
		weld.Parent = part
		return part
	end
	piece("Shaft", Vector3.new(0.18, 3.4, 0.18), CFrame.new(0, -1.8, -0.65) * CFrame.Angles(math.rad(25), 0, 0), spec.color)
	piece("SearchCoil", Vector3.new(0.15, 2.0, 2.0), CFrame.new(0, -3.3, -1.4) * CFrame.Angles(0, 0, math.pi / 2), spec.color, Enum.PartType.Cylinder)
	piece("CoilInset", Vector3.new(0.18, 1.45, 1.45), CFrame.new(0, -3.3, -1.4) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(27, 36, 41), Enum.PartType.Cylinder)
	piece("ControlBox", Vector3.new(0.85, 0.6, 0.5), CFrame.new(0, -0.6, -0.35), spec.color)
	local screen = piece("SignalDisplay", Vector3.new(0.63, 0.08, 0.32), CFrame.new(0, -0.27, -0.35), Color3.fromRGB(166, 255, 179))
	screen.Material = Enum.Material.Neon
	tool.Grip = CFrame.new(0, -0.25, 0)
	tool.Parent = backpack
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then humanoid:EquipTool(tool) end
	return tool
end

return DetectorTool
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Brainrot Bloom: all currency, collections, rolls and capture rewards live on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("BrainrotShared")
local Config = require(Shared:WaitForChild("Config"))
local CreatureFactory = require(Shared:WaitForChild("CreatureFactory"))
local World = require(script.Parent:WaitForChild("World"))
local DetectorTool = require(script.Parent:WaitForChild("DetectorTool"))
local map = World.build(Config)

local remoteFolder = Instance.new("Folder")
remoteFolder.Name = "BrainrotRemotes"
local Action = Instance.new("RemoteFunction")
Action.Name = "Action"
Action.Parent = remoteFolder
local State = Instance.new("RemoteEvent")
State.Name = "State"
State.Parent = remoteFolder
local Notify = Instance.new("RemoteEvent")
Notify.Name = "Notify"
Notify.Parent = remoteFolder
remoteFolder.Parent = ReplicatedStorage

local storeOk, store = pcall(function()
	return DataStoreService:GetDataStore("BrainrotBloom_Player_v1")
end)
if not storeOk then
	warn("[Brainrot Bloom] Save store could not initialize: " .. tostring(store))
	store = nil
end
local sessionId = game.JobId .. ":" .. HttpService:GenerateGUID(false)
local profiles = {}
local savesInFlight = {}
local closing = false
local rng = Random.new()
local MAX_COINS = 1e15
local LOCK_SECONDS = 180
local cachedEpoch = -1
local rotation = {}

local function integer(value, minimum, maximum, fallback)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
		return fallback
	end
	return math.clamp(math.floor(value), minimum, maximum)
end

local function lookup(list, id)
	if type(id) ~= "string" then return nil end
	return Config.get(list, id)
end

local function owned(list, id)
	return table.find(list, id) ~= nil
end

local function newData()
	return {
		coins = Config.StartCoins,
		brainrots = {},
		foods = { [Config.Foods[1].id] = 3 },
		ownedDetectors = { Config.Detectors[1].id },
		detector = Config.Detectors[1].id,
		unlockedWorlds = { Config.Worlds[1].id },
		activeBrainrot = nil,
		discoveryCount = 0,
	}
end

local function sanitize(raw)
	local data = newData()
	if type(raw) ~= "table" then return data end
	data.coins = integer(raw.coins, 0, MAX_COINS, Config.StartCoins)
	data.discoveryCount = integer(raw.discoveryCount, 0, 1e9, 0)
	data.foods = {}
	for _, food in Config.Foods do
		data.foods[food.id] = integer(type(raw.foods) == "table" and raw.foods[food.id], 0, 9999, 0)
	end
	for _, spec in Config.Detectors do
		if type(raw.ownedDetectors) == "table" and owned(raw.ownedDetectors, spec.id) and not owned(data.ownedDetectors, spec.id) then
			table.insert(data.ownedDetectors, spec.id)
		end
	end
	if owned(data.ownedDetectors, raw.detector) then data.detector = raw.detector end
	for _, world in Config.Worlds do
		if type(raw.unlockedWorlds) == "table" and owned(raw.unlockedWorlds, world.id) and not owned(data.unlockedWorlds, world.id) then
			table.insert(data.unlockedWorlds, world.id)
		end
	end
	local seen = {}
	if type(raw.brainrots) == "table" then
		for _, saved in raw.brainrots do
			if #data.brainrots >= Config.MaxBrainrots then break end
			if type(saved) == "table" and lookup(Config.Creatures, saved.specId) then
				local uid = type(saved.uid) == "string" and #saved.uid <= 64 and saved.uid or HttpService:GenerateGUID(false)
				if not seen[uid] then
					seen[uid] = true
					local level = integer(saved.level, 1, Config.MaxLevel, 1)
					table.insert(data.brainrots, {
						uid = uid, specId = saved.specId, level = level,
						xp = level < Config.MaxLevel and integer(saved.xp, 0, Config.xpNeeded(level) - 1, 0) or 0,
						growthBoostUntil = integer(saved.growthBoostUntil, 0, os.time() + Config.Boosts.Growth.duration, 0),
						incomeBoostUntil = integer(saved.incomeBoostUntil, 0, os.time() + Config.Boosts.Income.duration, 0),
					})
				end
			end
		end
	end
	if seen[raw.activeBrainrot] then data.activeBrainrot = raw.activeBrainrot end
	if not data.activeBrainrot and data.brainrots[1] then data.activeBrainrot = data.brainrots[1].uid end
	return data
end

local function findBrainrot(profile, uid)
	if type(uid) ~= "string" then return nil end
	for index, brainrot in profile.data.brainrots do
		if brainrot.uid == uid then return brainrot, index end
	end
	return nil
end

local function brainrotIncome(brainrot)
	local boost = brainrot.incomeBoostUntil > os.time() and 2 or 1
	return Config.income(brainrot.specId, brainrot.level) * boost
end

local function totalIncome(profile)
	local total = 0
	for _, brainrot in profile.data.brainrots do total += brainrotIncome(brainrot) end
	return total
end

-- Same rotation for every server at the same five-minute UTC boundary. Quantities are per player.
local function refreshRotation()
	local epoch = math.floor(os.time() / Config.RotationSeconds)
	if epoch ~= cachedEpoch then
		cachedEpoch = epoch
		local random = Random.new(epoch)
		local candidates = {}
		for index = 2, #Config.Foods do table.insert(candidates, Config.Foods[index]) end
		for index = #candidates, 2, -1 do
			local other = random:NextInteger(1, index)
			candidates[index], candidates[other] = candidates[other], candidates[index]
		end
		rotation = { Config.Foods[1] }
		for index = 1, math.min(5, #candidates) do table.insert(rotation, candidates[index]) end
	end
	return epoch
end

local function ensureStock(profile)
	local epoch = refreshRotation()
	if profile.stockEpoch ~= epoch then
		profile.stockEpoch = epoch
		profile.purchased = {}
	end
end

local function publicState(profile)
	ensureStock(profile)
	local brainrots = {}
	for _, brainrot in profile.data.brainrots do
		local spec = lookup(Config.Creatures, brainrot.specId)
		table.insert(brainrots, {
			uid = brainrot.uid, specId = brainrot.specId, name = spec.name, rarity = spec.rarity,
			level = brainrot.level, xp = brainrot.xp, xpNeeded = Config.xpNeeded(brainrot.level),
			income = brainrotIncome(brainrot), growthBoostUntil = brainrot.growthBoostUntil,
			incomeBoostUntil = brainrot.incomeBoostUntil,
		})
	end
	local stock = {}
	for _, food in rotation do
		table.insert(stock, { id = food.id, remaining = math.max(0, food.stock - (profile.purchased[food.id] or 0)) })
	end
	return {
		coins = math.floor(profile.data.coins), income = totalIncome(profile), world = profile.world,
		detector = profile.data.detector, ownedDetectors = table.clone(profile.data.ownedDetectors),
		unlockedWorlds = table.clone(profile.data.unlockedWorlds), activeBrainrot = profile.data.activeBrainrot,
		brainrots = brainrots, foods = table.clone(profile.data.foods), stock = stock,
		rotationEnds = (cachedEpoch + 1) * Config.RotationSeconds, discoveryCount = profile.data.discoveryCount,
		serverTime = os.time(), persistenceEnabled = profile.persistent,
	}
end

local function push(player, profile)
	if player.Parent == Players then State:FireClient(player, publicState(profile)) end
end

local function updateCompanion(profile)
	if profile.companion then profile.companion:Destroy(); profile.companion = nil end
	local brainrot = findBrainrot(profile, profile.data.activeBrainrot)
	if not brainrot then return end
	local spec = lookup(Config.Creatures, brainrot.specId)
	local model = CreatureFactory.create(spec, 0.7 + (brainrot.level - 1) * 0.015)
	model.Name = profile.player.Name .. "'s " .. spec.name
	model.Parent = workspace
	local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if primary then
		model.PrimaryPart = primary
		local label = Instance.new("BillboardGui")
		label.Name = "CompanionLabel"
		label.Size = UDim2.fromOffset(164, 38)
		label.StudsOffset = Vector3.new(0, 5.3 * (0.7 + (brainrot.level - 1) * 0.015), 0)
		label.MaxDistance = 28
		label.Parent = primary
		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.BuilderSansMedium
		text.TextSize = 12
		text.TextColor3 = Color3.new(1, 1, 1)
		text.TextStrokeTransparency = 0.3
		text.Text = string.format("%s  •  Lv.%d\n$%s / sec", spec.name, brainrot.level, tostring(brainrotIncome(brainrot)))
		text.Parent = label
	end
	profile.companion = model
end

local function snapshot(profile)
	local copy = {
		coins = math.floor(profile.data.coins), discoveryCount = profile.data.discoveryCount,
		foods = table.clone(profile.data.foods), detector = profile.data.detector,
		ownedDetectors = table.clone(profile.data.ownedDetectors), unlockedWorlds = table.clone(profile.data.unlockedWorlds),
		activeBrainrot = profile.data.activeBrainrot, brainrots = {},
	}
	for _, brainrot in profile.data.brainrots do table.insert(copy.brainrots, table.clone(brainrot)) end
	return copy
end

local function save(profile, release)
	if not profile.persistent then return true end
	local userId = profile.player.UserId
	-- A removal waits for an autosave so the final snapshot cannot be skipped.
	if savesInFlight[userId] then
		if not release then return false end
		local deadline = os.clock() + 12
		repeat task.wait(0.1) until not savesInFlight[userId] or os.clock() >= deadline
		if savesInFlight[userId] then return false end
	end
	savesInFlight[userId] = true
	local data = snapshot(profile)
	local ok, result = pcall(function()
		return store:UpdateAsync("Player_" .. userId, function(previous)
			if type(previous) ~= "table" or type(previous.session) ~= "table" or previous.session.id ~= sessionId then
				return nil -- Never overwrite a profile whose session lock we no longer own.
			end
			return { schema = 1, data = data, session = not release and { id = sessionId, expires = os.time() + LOCK_SECONDS } or nil }
		end)
	end)
	savesInFlight[userId] = nil
	if not ok then
		warn("[Brainrot Bloom] Save failed for user " .. userId .. ": " .. tostring(result))
		return false
	end
	if not result then
		profile.persistent = false
		if profile.player.Parent == Players then profile.player:Kick("Your save session moved to another server. Please rejoin to protect your collection.") end
		return false
	end
	return true
end

local function acquire(player)
	local finalError
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return store:UpdateAsync("Player_" .. player.UserId, function(previous)
				if type(previous) == "table" and type(previous.session) == "table"
					and previous.session.id ~= sessionId and (tonumber(previous.session.expires) or 0) > os.time() then
					return nil
				end
				local data = type(previous) == "table" and previous.data or nil
				return { schema = 1, data = sanitize(data), session = { id = sessionId, expires = os.time() + LOCK_SECONDS } }
			end)
		end)
		if ok then
			if type(result) == "table" and type(result.session) == "table" and result.session.id == sessionId then
				return sanitize(result.data), true
			end
			return nil, false, "Your collection is still open on another server. Wait a moment and rejoin."
		end
		finalError = result
		if attempt < 3 then task.wait(attempt) end
	end
	warn("[Brainrot Bloom] DataStore unavailable: " .. tostring(finalError))
	if RunService:IsStudio() then
		warn("[Brainrot Bloom] Studio uses temporary progress until the experience is published and API Services are enabled. No failed load will be saved.")
		return newData(), false
	end
	return nil, false, "Your collection could not be loaded safely. Please rejoin in a moment."
end

local function rootFor(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return nil end
	return character:FindFirstChild("HumanoidRootPart")
end

local function pitForPosition(position)
	for id, pit in map.pits do
		local relative = position - pit.center
		if math.abs(relative.X) <= pit.size.X / 2 and math.abs(relative.Z) <= pit.size.Z / 2 and math.abs(relative.Y) < 35 then
			return lookup(Config.Worlds, id)
		end
	end
	return nil
end

local function teleport(player, profile, destination)
	local frame = type(destination) == "string" and map.destinations[destination]
	if not frame then return false, "That destination does not exist." end
	local world = lookup(Config.Worlds, destination)
	if world and not owned(profile.data.unlockedWorlds, world.id) then return false, "Unlock this world in the Worlds menu first." end
	local root = rootFor(player)
	if not root then return false, "Wait for your character to spawn." end
	profile.dig = nil
	player.Character:PivotTo(frame)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	profile.world = world and world.id or Config.Worlds[1].id
	return true
end

local function charge(profile, cost)
	if profile.data.coins < cost then return false end
	profile.data.coins -= cost
	return true
end

local function fail(message)
	return { ok = false, message = message }
end

local function rollCreature(world, detector)
	local choices = {}
	local total = 0
	local ceiling = math.min(world.maxRarity, detector.power)
	for index, rarity in Config.Rarities do
		if index <= ceiling then
			local species = {}
			for _, spec in Config.Creatures do
				if spec.rarity == rarity.id then table.insert(species, spec) end
			end
			if #species > 0 then
				local weight = rarity.weight * (1 + math.max(0, detector.power - 1) * (index - 1) * 0.25)
				total += weight
				table.insert(choices, { rarity = rarity, species = species, threshold = total })
			end
		end
	end
	local roll = rng:NextNumber(0, total)
	for _, choice in choices do
		if roll <= choice.threshold then return choice.species[rng:NextInteger(1, #choice.species)], choice.rarity end
	end
	error("No valid creature roll; check world and rarity configuration")
end

local handlers = {}

function handlers.GetState(_player, _profile, _payload)
	return { ok = true }
end

function handlers.Teleport(player, profile, payload)
	local ok, message = teleport(player, profile, payload.destination)
	return { ok = ok, message = message }
end

function handlers.EquipDetector(_player, profile, payload)
	if not lookup(Config.Detectors, payload.id) or not owned(profile.data.ownedDetectors, payload.id) then return fail("You do not own that detector.") end
	if profile.dig and profile.dig.deadline > os.clock() then return fail("Finish your current capture first.") end
	profile.data.detector = payload.id
	DetectorTool.equip(profile.player, lookup(Config.Detectors, payload.id))
	return { ok = true, message = "Detector equipped." }
end

function handlers.BuyDetector(_player, profile, payload)
	local spec = lookup(Config.Detectors, payload.id)
	if not spec then return fail("Unknown detector.") end
	if profile.dig and profile.dig.deadline > os.clock() then return fail("Finish your current capture first.") end
	if owned(profile.data.ownedDetectors, spec.id) then return fail("You already own this detector.") end
	if not owned(profile.data.unlockedWorlds, spec.world) then return fail("Unlock " .. spec.world .. " before buying this detector.") end
	if not charge(profile, spec.price) then return fail("You need more coins for this detector.") end
	table.insert(profile.data.ownedDetectors, spec.id)
	profile.data.detector = spec.id
	DetectorTool.equip(profile.player, spec)
	return { ok = true, message = spec.name .. " purchased and equipped!" }
end

function handlers.BuyFood(_player, profile, payload)
	ensureStock(profile)
	local food = lookup(Config.Foods, payload.id)
	if not food then return fail("Unknown food.") end
	if not table.find(rotation, food) then return fail("This food is not in the current rotation.") end
	local quantity = integer(payload.quantity, 1, 100, 1)
	local remaining = food.stock - (profile.purchased[food.id] or 0)
	if quantity > remaining then return fail("There is not enough stock left in this rotation.") end
	if (profile.data.foods[food.id] or 0) + quantity > 9999 then return fail("Your pantry is full of this food.") end
	if not charge(profile, food.price * quantity) then return fail("You need more coins for this food.") end
	profile.data.foods[food.id] = (profile.data.foods[food.id] or 0) + quantity
	profile.purchased[food.id] = (profile.purchased[food.id] or 0) + quantity
	return { ok = true, message = "Bought " .. quantity .. " × " .. food.name .. "." }
end

function handlers.Feed(_player, profile, payload)
	local brainrot = findBrainrot(profile, payload.uid)
	local food = lookup(Config.Foods, payload.foodId)
	if not brainrot or not food then return fail("Choose a brainrot and food from your inventory.") end
	if brainrot.level >= Config.MaxLevel then return fail("This brainrot has reached the maximum level.") end
	local quantity = integer(payload.quantity, 1, 100, 1)
	if quantity > (profile.data.foods[food.id] or 0) then return fail("You do not have enough of this food.") end
	profile.data.foods[food.id] -= quantity
	local previousLevel = brainrot.level
	brainrot.xp += food.xp * quantity * (brainrot.growthBoostUntil > os.time() and 2 or 1)
	while brainrot.level < Config.MaxLevel and brainrot.xp >= Config.xpNeeded(brainrot.level) do
		brainrot.xp -= Config.xpNeeded(brainrot.level)
		brainrot.level += 1
	end
	if brainrot.level == Config.MaxLevel then brainrot.xp = 0 end
	if profile.data.activeBrainrot == brainrot.uid then updateCompanion(profile) end
	local gained = brainrot.level - previousLevel
	return { ok = true, message = gained > 0 and ("Grew " .. gained .. " level" .. (gained == 1 and "!" or "s!")) or "Yum! Growth XP added." }
end

function handlers.EquipBrainrot(_player, profile, payload)
	if not findBrainrot(profile, payload.uid) then return fail("You do not own that brainrot.") end
	profile.data.activeBrainrot = payload.uid
	updateCompanion(profile)
	return { ok = true, message = "Your companion is ready. All collected brainrots still earn income!" }
end

function handlers.Sell(_player, profile, payload)
	local brainrot, index = findBrainrot(profile, payload.uid)
	if not brainrot then return fail("Choose a brainrot to sell.") end
	local value = Config.sellValue(brainrot.specId, brainrot.level)
	table.remove(profile.data.brainrots, index)
	profile.data.coins = math.min(MAX_COINS, profile.data.coins + value)
	if profile.data.activeBrainrot == brainrot.uid then
		profile.data.activeBrainrot = profile.data.brainrots[1] and profile.data.brainrots[1].uid or nil
		updateCompanion(profile)
	end
	return { ok = true, message = "Brainrot sold for $" .. tostring(value) .. "." }
end

function handlers.BuyBoost(_player, profile, payload)
	if payload.kind ~= "Growth" and payload.kind ~= "Income" then return fail("Choose a growth or income boost.") end
	local brainrot = findBrainrot(profile, payload.uid)
	local boost = Config.Boosts[payload.kind]
	if not brainrot then return fail("Choose the brainrot you want to boost.") end
	local field = payload.kind == "Growth" and "growthBoostUntil" or "incomeBoostUntil"
	if brainrot[field] > os.time() then return fail("This boost is already active. Wait for it to finish.") end
	if payload.kind == "Growth" and brainrot.level >= Config.MaxLevel then return fail("This brainrot is already at maximum level.") end
	if not charge(profile, boost.price) then return fail("You need more coins for this boost.") end
	brainrot[field] = os.time() + boost.duration
	if profile.data.activeBrainrot == brainrot.uid then updateCompanion(profile) end
	return { ok = true, message = "2× " .. string.lower(payload.kind) .. " active for five minutes!" }
end

function handlers.UnlockWorld(player, profile, payload)
	local world = lookup(Config.Worlds, payload.id)
	if not world then return fail("Unknown world.") end
	if owned(profile.data.unlockedWorlds, world.id) then return fail("You have already unlocked this world.") end
	local index = table.find(Config.Worlds, world)
	if index > 1 and not owned(profile.data.unlockedWorlds, Config.Worlds[index - 1].id) then return fail("Unlock the previous world first.") end
	if not charge(profile, world.unlockCost) then return fail("You need more coins to unlock " .. world.name .. ".") end
	table.insert(profile.data.unlockedWorlds, world.id)
	teleport(player, profile, world.id)
	return { ok = true, message = world.name .. " unlocked! New detectors are available in the gear shop." }
end

function handlers.StartDig(player, profile, _payload)
	local root = rootFor(player)
	if not root then return fail("Wait for your character to spawn.") end
	local world = pitForPosition(root.Position)
	if not world then return fail("Stand inside a sand pit to search for brainrots.") end
	if not owned(profile.data.unlockedWorlds, world.id) then return fail("Unlock this world before digging here.") end
	local detector = lookup(Config.Detectors, profile.data.detector)
	if detector.power < world.minPower then return fail("This pit needs a stronger detector. Visit the gear shop.") end
	if #profile.data.brainrots >= Config.MaxBrainrots then return fail("Your collection is full. Sell a brainrot first.") end
	if profile.dig and os.clock() < profile.dig.deadline then return fail("A capture is already in progress.") end
	if os.clock() < profile.nextDig then return fail(string.format("Detector recharging… %.1fs", profile.nextDig - os.clock())) end
	local spec, rarity = rollCreature(world, detector)
	local duration = Config.DigDuration
	profile.world = world.id
	profile.nextDig = os.clock() + detector.speed
	profile.dig = {
		id = HttpService:GenerateGUID(false), specId = spec.id, required = rarity.taps,
		count = 0, deadline = os.clock() + duration, lastTap = 0, world = world.id,
	}
	return { ok = true, dig = { id = profile.dig.id, required = rarity.taps, duration = duration, specId = spec.id, rarity = rarity.id, name = spec.name } }
end

function handlers.TapDig(player, profile, payload)
	local dig = profile.dig
	if not dig or payload.sessionId ~= dig.id then return fail("No active capture. Search the sand again.") end
	if os.clock() > dig.deadline then profile.dig = nil; return fail("It escaped! Try digging again.") end
	local root = rootFor(player)
	local currentWorld = root and pitForPosition(root.Position)
	if not currentWorld or currentWorld.id ~= dig.world then profile.dig = nil; return fail("Stay in the sand pit during a capture.") end
	if os.clock() - dig.lastTap < 0.045 then return { ok = true, count = dig.count, taps = dig.count } end
	dig.lastTap = os.clock()
	dig.count += 1
	if dig.count < dig.required then return { ok = true, count = dig.count, taps = dig.count } end
	profile.dig = nil -- Clear the session before awarding; replayed requests cannot grant another creature.
	if #profile.data.brainrots >= Config.MaxBrainrots then return fail("Your collection is full.") end
	local brainrot = { uid = HttpService:GenerateGUID(false), specId = dig.specId, level = 1, xp = 0, growthBoostUntil = 0, incomeBoostUntil = 0 }
	table.insert(profile.data.brainrots, brainrot)
	profile.data.discoveryCount += 1
	if not profile.data.activeBrainrot then profile.data.activeBrainrot = brainrot.uid; updateCompanion(profile) end
	local spec = lookup(Config.Creatures, brainrot.specId)
	return { ok = true, complete = true, message = "Captured " .. spec.name .. "! It now earns coins every second." }
end

Action.OnServerInvoke = function(player, action, payload)
	local profile = profiles[player]
	if not profile then return fail("Your collection is loading. Try again in a moment.") end
	if closing then return fail("The server is closing. Your collection is being saved.") end
	if type(action) ~= "string" or not handlers[action] then return fail("Unknown action.") end
	if payload ~= nil and type(payload) ~= "table" then return fail("Invalid request.") end
	-- Token bucket permits rapid capture taps while bounding every other action.
	local now = os.clock()
	profile.tokens = math.min(45, profile.tokens + (now - profile.tokenAt) * 28)
	profile.tokenAt = now
	local cost = action == "TapDig" and 1 or 4
	if profile.tokens < cost then return fail("Please slow down for a moment.") end
	profile.tokens -= cost
	local ok, result = pcall(handlers[action], player, profile, payload or {})
	if not ok then
		warn("[Brainrot Bloom] Action " .. action .. " failed: " .. tostring(result))
		return fail("That action could not finish. Please try again.")
	end
	-- A state snapshot accompanies meaningful actions; individual taps only return progress.
	if action ~= "TapDig" or result.complete then
		result.state = publicState(profile)
		push(player, profile)
	end
	return result
end

local function onPlayerAdded(player)
	local data, persistent, message = acquire(player)
	if not data then player:Kick(message); return end
	local profile = {
		player = player, data = data, persistent = persistent, world = Config.Worlds[1].id,
		nextDig = 0, tokens = 45, tokenAt = os.clock(), stockEpoch = -1, purchased = {},
	}
	if player.Parent ~= Players or closing then save(profile, true); return end
	profiles[player] = profile
	local function spawnCharacter(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and profiles[player] == profile then
			character:PivotTo(map.spawnCFrame)
			profile.world = Config.Worlds[1].id
			profile.dig = nil
			DetectorTool.equip(player, lookup(Config.Detectors, profile.data.detector))
			updateCompanion(profile)
			push(player, profile)
		end
	end
	player.CharacterAdded:Connect(spawnCharacter)
	if player.Character then task.spawn(spawnCharacter, player.Character) end
	push(player, profile)
	if not persistent then
		task.delay(5, function()
			if player.Parent == Players then Notify:FireClient(player, "Studio session: progress is temporary. Publish and enable API Services to test saving.", "warning") end
		end)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do task.spawn(onPlayerAdded, player) end
Players.PlayerRemoving:Connect(function(player)
	local profile = profiles[player]
	profiles[player] = nil
	if profile then
		if profile.companion then profile.companion:Destroy() end
		for attempt = 1, 3 do
			if save(profile, true) then break end
			if attempt < 3 then task.wait(attempt) end
		end
	end
end)

-- Map ProximityPrompt UI is handled by the client; all resulting actions still pass these server checks.
task.spawn(function()
	local elapsed = 0
	while not closing do
		task.wait(1)
		elapsed += 1
		for player, profile in profiles do
			profile.data.coins = math.min(MAX_COINS, profile.data.coins + totalIncome(profile))
			if profile.dig and os.clock() > profile.dig.deadline then profile.dig = nil end
			if elapsed % 2 == 0 then push(player, profile) end
			if elapsed % 60 == 0 then task.spawn(save, profile, false) end
			if elapsed % 5 == 0 and profile.companion then
				local brainrot = findBrainrot(profile, profile.data.activeBrainrot)
				local primary = profile.companion.PrimaryPart
				local label = primary and primary:FindFirstChild("CompanionLabel")
				local text = label and label:FindFirstChild("Text")
				if brainrot and text then
					local spec = lookup(Config.Creatures, brainrot.specId)
					text.Text = string.format("%s  •  Lv.%d\n$%s / sec", spec.name, brainrot.level, tostring(brainrotIncome(brainrot)))
				end
			end
		end
	end
end)

local companionTime = 0
RunService.Heartbeat:Connect(function(delta)
	companionTime += delta
	if companionTime < 0.1 then return end
	companionTime = 0
	for player, profile in profiles do
		local root = rootFor(player)
		if root and profile.companion and profile.companion.PrimaryPart then
			local target = root.CFrame * CFrame.new(3.8, -1 + math.sin(os.clock() * 3) * 0.2, 2.5)
			profile.companion:PivotTo(target)
		end
	end
end)

game:BindToClose(function()
	closing = true
	local remaining = 0
	for _, profile in profiles do
		remaining += 1
		task.spawn(function()
			for attempt = 1, 3 do
				if save(profile, true) then break end
				if attempt < 3 then task.wait(attempt) end
			end
			remaining -= 1
		end)
	end
	local deadline = os.clock() + 25
	while remaining > 0 and os.clock() < deadline do task.wait(0.1) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CreatureFactory = require(ReplicatedStorage:WaitForChild("BrainrotShared"):WaitForChild("CreatureFactory"))

local World = {}
local dayCycleStarted = false

local function part(parent, name, size, position, color, material, shape)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.Position = position
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	object.Anchored = true
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	if shape then object.Shape = shape end
	object.Parent = parent
	return object
end

-- Signs stay attached to the scenery. No oversized floating destination pins.
local function label(adornee, title, subtitle, color, width)
	local board = adornee
	if adornee.Size.Y < 2 or adornee.Size.X < 4 then
		board = part(adornee.Parent, "WayfindingSign", Vector3.new(math.clamp((width or 250)/22,9,16),3.2,0.35), adornee.Position+Vector3.new(0,adornee.Size.Y/2+1.7,0), Color3.fromRGB(35,52,45),Enum.Material.Wood)
		board.CanCollide = false
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(520,128)
	gui.LightInfluence = 0.25
	gui.MaxDistance = 95
	gui.Parent = board
	local heading = Instance.new("TextLabel")
	heading.BackgroundTransparency = 1
	heading.Size = UDim2.new(1,-32,subtitle and 0.58 or 1,0)
	heading.Position = UDim2.fromOffset(16,0)
	heading.Font = Enum.Font.BuilderSansBold
	heading.TextSize = 32
	heading.TextColor3 = color or Color3.fromRGB(238,239,221)
	heading.Text = title
	heading.TextTruncate = Enum.TextTruncate.AtEnd
	heading.Parent = gui
	if subtitle then
		local sub = heading:Clone()
		sub.Size = UDim2.new(1,-32,0.42,0)
		sub.Position = UDim2.new(0,16,0.58,-4)
		sub.Font = Enum.Font.BuilderSans
		sub.TextSize = 18
		sub.TextColor3 = Color3.fromRGB(188,206,192)
		sub.Text = subtitle
		sub.Parent = gui
	end
end

local function tree(parent, position, scale, color)
	part(parent, "TreeTrunk", Vector3.new(2.4, 10, 2.4) * scale, position + Vector3.new(0, 5 * scale, 0), Color3.fromRGB(110, 76, 47), Enum.Material.Wood)
	part(parent, "TreeCanopy", Vector3.new(13, 13, 13) * scale, position + Vector3.new(0, 13 * scale, 0), color, Enum.Material.Grass, Enum.PartType.Ball)
	part(parent, "TreeCanopy", Vector3.new(10, 10, 10) * scale, position + Vector3.new(4 * scale, 16 * scale, 0), color:Lerp(Color3.new(1, 1, 1), 0.08), Enum.Material.Grass, Enum.PartType.Ball)
end

local function specimenPlaque(parent, position, rarity, species, color, width)
	width = width or 9
	local plaque = part(parent, "SpecimenPlaque", Vector3.new(width, 2.3, 0.3), position, Color3.fromRGB(35, 55, 46), Enum.Material.Wood)
	plaque.CFrame = CFrame.new(position) * CFrame.Angles(0, math.pi, 0)
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.CanvasSize = Vector2.new(width * 55, 150)
	surface.Parent = plaque
	local text = Instance.new("TextLabel")
	text.Size = UDim2.new(1, -20, 1, -12)
	text.Position = UDim2.fromOffset(10, 6)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.BuilderSansBold
	text.TextColor3 = color
	text.TextSize = 29
	text.TextWrapped = true
	text.Text = rarity .. "\n" .. species
	text.Parent = surface
	return plaque
end

local function prompt(target, action, name, attribute, value)
	local interaction = Instance.new("ProximityPrompt")
	interaction.ActionText = action
	interaction.ObjectText = name
	interaction.HoldDuration = 0
	interaction.KeyboardKeyCode = Enum.KeyCode.F
	interaction.MaxActivationDistance = 15
	interaction.RequiresLineOfSight = false
	interaction:SetAttribute(attribute, value)
	interaction.Parent = target
	return interaction
end

local function shop(parent, name, position, color, subtitle, shopId)
	local wood = Color3.fromRGB(134, 94, 57)
	part(parent, name .. "Platform", Vector3.new(31, 1, 22), position + Vector3.new(0, 0.6, 0), wood, Enum.Material.WoodPlanks)
	for _, x in {-13, 13} do
		for _, z in {-9, 9} do
			part(parent, "ShopPost", Vector3.new(1.2, 12, 1.2), position + Vector3.new(x, 6.5, z), wood, Enum.Material.Wood)
		end
	end
	part(parent, "ShopBack", Vector3.new(28, 7, 0.8), position + Vector3.new(0, 4.6, 9), Color3.fromRGB(238, 223, 183), Enum.Material.WoodPlanks)
	local counter = part(parent, "ShopCounter", Vector3.new(27, 4, 3), position + Vector3.new(0, 3, -6), wood, Enum.Material.WoodPlanks)
	prompt(counter, "Browse", name, "Shop", shopId)
	part(parent, "ShopAwning", Vector3.new(34, 1.4, 25), position + Vector3.new(0, 13, 0), color)
	for x = -14, 14, 7 do
		part(parent, "AwningStripe", Vector3.new(3, 0.08, 25.1), position + Vector3.new(x, 13.75, 0), color:Lerp(Color3.new(1, 1, 1), 0.45))
	end
	local sign = part(parent, "ShopSign", Vector3.new(20, 3, 0.5), position + Vector3.new(0, 11, -11), wood)
	label(sign, name, subtitle, Color3.fromRGB(255, 241, 203))
	-- Counter wares are original geometric props.
	for i = -1, 1 do
		part(parent, "ShopWares", Vector3.new(2.5, 2.5, 2.5), position + Vector3.new(i * 7, 6.2, -5), color:Lerp(Color3.fromRGB(255, 231, 136), (i + 1) * 0.22), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	end
end


local function flower(parent, position, tint, rng)
	local stem = part(parent,"FlowerStem",Vector3.new(0.14,1.1,0.14),position+Vector3.new(0,0.7,0),Color3.fromRGB(72,123,70))
	stem.CanCollide=false
	for i=1,4 do
		local a=i*math.pi/2
		local petal=part(parent,"Petal",Vector3.new(0.58,0.25,0.58),position+Vector3.new(math.cos(a)*0.24,1.3,math.sin(a)*0.24),tint,nil,Enum.PartType.Ball)
		petal.CanCollide=false
	end
end

local function bench(parent, position)
	local wood=Color3.fromRGB(151,115,78)
	part(parent,"BenchSeat",Vector3.new(9,0.45,2.6),position+Vector3.new(0,2,0),wood,Enum.Material.WoodPlanks)
	part(parent,"BenchBack",Vector3.new(9,2,0.4),position+Vector3.new(0,3.0,1.1),wood,Enum.Material.WoodPlanks)
	for _,x in {-3,3} do part(parent,"BenchLeg",Vector3.new(0.5,2,2),position+Vector3.new(x,1,0),Color3.fromRGB(60,73,66),Enum.Material.Metal) end
end

local function scenery(parent, offset, index, rng)
	-- Keep the digging rectangles completely clear. All extra exploration
	-- space lies in the outer woodland and in the garden behind the shops.
	local decor=Instance.new("Folder")
	decor.Name="LandscapeDetails"
	decor.Parent=parent
	local tints={Color3.fromRGB(240,219,151),Color3.fromRGB(255,169,125),Color3.fromRGB(187,178,244)}
	for j=1,20 do
		local side=j%2==0 and -1 or 1
		local position=offset+Vector3.new(side*rng:NextNumber(205,300),0.4,rng:NextNumber(-220,280))
		if index==1 then
			flower(decor,position,tints[index],rng)
		elseif index==2 then
			local cactus=part(decor,"WildCactus",Vector3.new(2.5,6+j%3,2.5),position+Vector3.new(0,3,0),Color3.fromRGB(103,157,106),nil,Enum.PartType.Ball)
			part(decor,"CactusBranch",Vector3.new(3.6,1.1,1.1),cactus.Position+Vector3.new(1.5,0.5,0),cactus.Color)
		else
			local crystal=part(decor,"MoonCrystal",Vector3.new(1.4,4+j%4,1.4),position+Vector3.new(0,2.5,0),tints[index],Enum.Material.Neon)
			crystal.Orientation=Vector3.new(0,j*19,12)
			crystal.Transparency=0.22
		end
	end
	for _,side in {-1,1} do
		bench(decor,offset+Vector3.new(side*125,0.4,-168))
		local hill=part(decor,"WoodlandHill",Vector3.new(58,22,50),offset+Vector3.new(side*285,-6,-244),Color3.fromRGB(99,151,97),Enum.Material.Grass,Enum.PartType.Ball)
		for j=1,5 do
			part(decor,"TrailStone",Vector3.new(5,0.18,4),offset+Vector3.new(side*(23+j*18),0.5,-170),Color3.fromRGB(186,190,160),Enum.Material.Slate)
		end
	end
	if index==1 then
		local shore=part(decor,"PondShore",Vector3.new(72,1,55),offset+Vector3.new(-236,0,-125),Color3.fromRGB(193,188,144),Enum.Material.Sand,Enum.PartType.Ball)
		local water=part(decor,"GardenPond",Vector3.new(63,0.35,46),shore.Position+Vector3.new(0,0.7,0),Color3.fromRGB(99,176,173),Enum.Material.Glass,Enum.PartType.Ball)
		water.Transparency=0.15
		water.CanCollide=false
		for j=1,4 do
			part(decor,"LilyPad",Vector3.new(4,0.15,3.6),water.Position+Vector3.new(j*8-22,0.3,j%2*8-5),Color3.fromRGB(108,155,99),nil,Enum.PartType.Ball)
		end
	else
		for j=-1,1 do
			local color=index==2 and Color3.fromRGB(202,165,117) or Color3.fromRGB(135,137,169)
			part(decor,"AncientPillar",Vector3.new(5,15+math.abs(j)*3,5),offset+Vector3.new(j*17,7,-278),color,Enum.Material.Slate)
		end
	end
end

function World.startDayNight()
	if dayCycleStarted then return end
	dayCycleStarted = true
	Lighting.ClockTime = 9
	Lighting.Brightness = 2.1
	Lighting.GlobalShadows = true
	Lighting.Ambient = Color3.fromRGB(102, 113, 141)
	Lighting.OutdoorAmbient = Color3.fromRGB(138, 151, 164)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.22
	atmosphere.Color = Color3.fromRGB(205, 232, 255)
	atmosphere.Decay = Color3.fromRGB(161, 186, 211)
	atmosphere.Parent = Lighting
	task.spawn(function()
		local start = os.clock()
		while true do
			Lighting.ClockTime = (9 + (os.clock() - start) / 30) % 24
			task.wait(0.5)
		end
	end)
end

function World.build(config)
	local old = Workspace:FindFirstChild("BrainrotWorld")
	if old then old:Destroy() end
	local folder = Instance.new("Folder")
	folder.Name = "BrainrotWorld"
	folder.Parent = Workspace
	-- Restricted Workspace settings are serialized by default.project.json.
	local ocean = part(folder, "Ocean", Vector3.new(4000, 3, 1600), Vector3.new(1040, -12, 0), Color3.fromRGB(70, 168, 195), Enum.Material.Glass)
	ocean.Transparency = 0.2
	ocean.CanCollide = false
	local result = {destinations = {}, pits = {}, displaySlots = {}}
	local ids = {"Meadow", "Dunes", "Cosmic"}
	local names = {"Sprout Meadows", "Amber Dunes", "Starlight Hollow"}
	local colors = {Color3.fromRGB(96, 175, 82), Color3.fromRGB(128, 175, 85), Color3.fromRGB(93, 151, 139)}
	local sandColors = {Color3.fromRGB(239, 215, 157), Color3.fromRGB(236, 183, 101), Color3.fromRGB(178, 159, 221)}
	local rng = Random.new(74119)
	for i, id in ids do
		local offset = Vector3.new((i - 1) * 1040, 0, 0)
		local island = Instance.new("Model")
		island.Name = id
		island.Parent = folder
		part(island, "IslandStone", Vector3.new(700, 12, 660), offset + Vector3.new(0, -9, 0), Color3.fromRGB(120, 116, 93), Enum.Material.Slate)
		part(island, "Grass", Vector3.new(700, 6, 660), offset + Vector3.new(0, -2.7, 0), colors[i], Enum.Material.Grass)
		local pitCenter = offset + Vector3.new(0, 0.65, 130)
		local pitSize = Vector3.new(320, 3, 280)
		local digZone = part(island, "DigZone", pitSize, pitCenter - Vector3.new(0, 1.4, 0), sandColors[i], Enum.Material.Sand)
		digZone:SetAttribute("WorldId", id)
		for _, x in {-162, 162} do
			part(island, "PitRim", Vector3.new(3, 1.1, 286), offset + Vector3.new(x, 0.9, 130), Color3.fromRGB(157, 117, 72), Enum.Material.WoodPlanks)
		end
		for _, z in {-12, 272} do
			part(island, "PitRim", Vector3.new(326, 1.1, 3), offset + Vector3.new(0, 0.9, z), Color3.fromRGB(157, 117, 72), Enum.Material.WoodPlanks)
		end
		result.pits[id] = {center = pitCenter, size = pitSize}
		result.destinations[id] = CFrame.new(offset + Vector3.new(0, 5, 7)) * CFrame.Angles(0, math.pi, 0)
		part(island, "MainPath", Vector3.new(17, 0.15, 135), offset + Vector3.new(0, 0.4, -78), Color3.fromRGB(225, 217, 181), Enum.Material.Cobblestone)
		local marker = part(island, "WorldMarker", Vector3.new(1, 8, 1), offset + Vector3.new(0, 5, -25), Color3.fromRGB(120, 85, 48), Enum.Material.Wood)
		local world = config.Worlds and config.Worlds[i]
		if world then names[i] = world.name end
		label(marker, world and world.name or names[i], i == 1 and "Equip your detector and search the sand" or "Unlock this world from the Worlds menu", Color3.fromRGB(255, 235, 166), 340)
		for j = 1, 34 do
			local x = (j % 2 == 0 and -1 or 1) * rng:NextNumber(208, 310)
			local z = rng:NextNumber(-290, 288)
			tree(island, offset + Vector3.new(x, 0, z), rng:NextNumber(0.65, 1.15), colors[i]:Lerp(Color3.fromRGB(32, 100, 53), 0.2))
		end
		for j = 1, 16 do
			local x = rng:NextNumber(-305, 305)
			local z = rng:NextNumber(-295, -230)
			if i == 1 and math.abs(x) < 104 then x += 130 end
			local rock = part(island, "Pebble", Vector3.new(4, 3, 4) * rng:NextNumber(0.4, 1.2), offset + Vector3.new(x, 0.6, z), sandColors[i]:Lerp(Color3.fromRGB(110, 114, 115), 0.5), Enum.Material.Rock, Enum.PartType.Ball)
			rock.Orientation = Vector3.new(0, rng:NextNumber(0, 360), 0)
		end
		scenery(island, offset, i, rng)
		-- Tiny glowing lamps keep the sand and pathways readable at night.
		for _, x in {-175, 175} do
			for _, z in {0, 130, 260} do
				part(island, "LampPost", Vector3.new(0.8, 9, 0.8), offset + Vector3.new(x, 4.5, z), Color3.fromRGB(69, 74, 62), Enum.Material.Metal)
				local bulb = part(island, "Lamp", Vector3.new(2.6, 2.6, 2.6), offset + Vector3.new(x, 9.5, z), Color3.fromRGB(255, 228, 158), Enum.Material.Neon, Enum.PartType.Ball)
				local light = Instance.new("PointLight")
				light.Color = bulb.Color
				light.Range = 38
				light.Brightness = 1.6
				light.Parent = bulb
			end
		end
		if i > 1 then
			local portal = part(island, "WorldPortal", Vector3.new(17, 20, 2), offset + Vector3.new(0, 10, -210), sandColors[i], Enum.Material.Neon)
			portal.Transparency = 0.55
			portal.CanCollide = false
			label(portal, names[i], "Access requires the matching world unlock", sandColors[i])
			prompt(portal, "World access", names[i], "WorldId", id)
		end
	end

	shop(folder, "FOOD MARKET", Vector3.new(-64, 0, -66), Color3.fromRGB(241, 139, 95), "Fresh stock every five minutes", "Food")
	shop(folder, "GEAR WORKSHOP", Vector3.new(64, 0, -66), Color3.fromRGB(95, 169, 211), "Detectors and five-minute boosts", "Gear")
	local sell = part(folder, "SellArea", Vector3.new(28, 0.4, 23), Vector3.new(-64, 0.55, -113), Color3.fromRGB(255, 207, 94), Enum.Material.SmoothPlastic)
	label(sell, "SELL BRAINROTS", "Choose a creature in your collection", Color3.fromRGB(255, 219, 109))
	prompt(sell, "Sell", "Sell brainrots", "Shop", "Sell")
	local home = part(folder, "HomePad", Vector3.new(24, 0.5, 20), Vector3.new(0, 0.6, -106), Color3.fromRGB(187, 224, 150))
	label(home, "BRAINROT BLOOM", "Find it. Feed it. Let it flourish.", Color3.fromRGB(192, 240, 139), 340)
	result.spawnCFrame = CFrame.new(0, 5, -91) * CFrame.Angles(0, math.pi, 0)
	result.destinations.Home = result.spawnCFrame
	result.destinations.Food = CFrame.new(-64, 5, -86) * CFrame.Angles(0, math.pi, 0)
	result.destinations.Gear = CFrame.new(64, 5, -86) * CFrame.Angles(0, math.pi, 0)
	result.destinations.Sell = CFrame.new(-64, 5, -113)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "GardenSpawn"
	spawn.Size = Vector3.new(8, 0.2, 8)
	spawn.CFrame = CFrame.new(0, 0.85, -91)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = folder
	-- A small rear-grove museum previews the seven rarity tiers. These are
	-- decorative specimens, separate from players' earned companion models.
	local grove = Instance.new("Folder")
	grove.Name = "RarityPreviewGrove"
	grove.Parent = folder
	local heading = specimenPlaque(grove, Vector3.new(0, 7.5, -242), "COLLECTION PREVIEW", "Seven rarities waiting beneath the sand", Color3.fromRGB(218, 236, 180), 19)
	heading.Name = "CollectionPreviewSign"
	for _, x in {-8, 8} do
		part(grove, "PreviewSignPost", Vector3.new(0.7, 7, 0.7), Vector3.new(x, 3.5, -242), Color3.fromRGB(110, 76, 47), Enum.Material.Wood)
	end
	for i, rarity in config.Rarities do
		local specimen
		for _, candidate in config.Creatures do
			if candidate.rarity == rarity.id then specimen = candidate; break end
		end
		if specimen then
			local x, z = (i - 4) * 31, -222
			part(grove, "SpecimenPlinth", Vector3.new(6, 0.8, 6), Vector3.new(x, 0.7, z), Color3.fromRGB(206, 222, 185), Enum.Material.Slate)
			local displayCFrame = CFrame.new(x, 1.2, z) * CFrame.Angles(0, math.pi, 0)
			local model = CreatureFactory.create(specimen, 0.85)
			model.Name = rarity.id .. "Preview"
			model:SetAttribute("DecorativePreview", true)
			model:PivotTo(displayCFrame)
			model.Parent = grove
			specimenPlaque(grove, Vector3.new(x, 1.6, z + 5), rarity.name, specimen.name, rarity.color)
			table.insert(result.displaySlots, displayCFrame)
		end
	end
	World.startDayNight()
	return result
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="10">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="11">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">8</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="12">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="13">
        <Properties>
          <string name="Name">BrainrotClient</string>
        </Properties>
        <Item class="LocalScript" referent="14">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client presentation only. Inventory, purchases, digging, and rewards are server-owned.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("BrainrotShared")
local Config = require(shared:WaitForChild("Config"))
local CreatureFactory = require(shared:WaitForChild("CreatureFactory"))
local remotes = ReplicatedStorage:WaitForChild("BrainrotRemotes")
local Action = remotes:WaitForChild("Action")
local State = remotes:WaitForChild("State")
local Notify = remotes:WaitForChild("Notify")

local C = {
	bg = Color3.fromRGB(17, 25, 24), panel = Color3.fromRGB(23, 34, 31),
	card = Color3.fromRGB(31, 44, 40), light = Color3.fromRGB(45, 62, 54),
	text = Color3.fromRGB(239, 243, 235), muted = Color3.fromRGB(166, 184, 172),
	lime = Color3.fromRGB(174, 222, 184), green = Color3.fromRGB(137, 202, 169),
	gold = Color3.fromRGB(233, 201, 144), red = Color3.fromRGB(238, 151, 143),
}
local state = nil
local activePage = nil
local selectedUid = nil
local gearTab = "Detectors"
local chosenQuantity = 1
local collectionSort = "Income"
local collectionFilter = "All"
local collectionQuery = ""
local collectionPageIndex = 1
local collectionPageSize = 12
local panelRestPosition = UDim2.fromScale(0.5, 0.49)
local busy = false
local capture = nil
local capturePending = false
local viewports = {}
local renderPage
local renderedSignature = nil
local request
local openPage
local startDig
local tapDig

local screen = Instance.new("ScreenGui")
screen.Name = "BrainrotBloom"
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.DisplayOrder = 10
screen.Parent = player:WaitForChild("PlayerGui")

local function make(class, props, parent)
	local obj = Instance.new(class)
	for key, value in pairs(props or {}) do obj[key] = value end
	obj.Parent = parent
	return obj
end
local function corner(obj, radius)
	make("UICorner", {CornerRadius = UDim.new(0, radius or 12)}, obj)
end
local function stroke(obj, color, transparency)
	return make("UIStroke", {Color = color or C.light, Transparency = transparency or 0, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, obj)
end
local function label(parent, text, size, color, props)
	local p = {
		BackgroundTransparency = 1, Text = text, TextColor3 = color or C.text,
		Font = Enum.Font.BuilderSans, TextSize = math.max(13, size or 16),
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
	}
	for key, value in pairs(props or {}) do p[key] = value end
	return make("TextLabel", p, parent)
end
local function button(parent, text, onClick, props)
	local p = {
		Text = text, Font = Enum.Font.BuilderSansMedium, TextSize = 14,
		TextColor3 = C.text, BackgroundColor3 = C.light, BorderSizePixel = 0,
		Size = UDim2.new(0, 140, 0, 44), AutoButtonColor = false,
	}
	for key, value in pairs(props or {}) do p[key] = value end
	if p.Size.Y.Scale==0 and p.Size.Y.Offset<44 then p.Size=UDim2.new(p.Size.X.Scale,p.Size.X.Offset,0,44) end
	local b = make("TextButton", p, parent)
	corner(b, 10)
	local border=stroke(b,C.text,0.94)
	b.MouseEnter:Connect(function() TweenService:Create(border,TweenInfo.new(0.12),{Transparency=0.75}):Play() end)
	b.MouseLeave:Connect(function() TweenService:Create(border,TweenInfo.new(0.12),{Transparency=0.94}):Play() end)
	if onClick then b.Activated:Connect(onClick) end
	return b
end
local function padding(parent, amount)
	make("UIPadding", {PaddingLeft = UDim.new(0, amount), PaddingRight = UDim.new(0, amount),
		PaddingTop = UDim.new(0, amount), PaddingBottom = UDim.new(0, amount)}, parent)
end
local function vertical(parent, gap)
	return make("UIListLayout", {Padding = UDim.new(0, gap or 10), SortOrder = Enum.SortOrder.LayoutOrder}, parent)
end
local function row(parent, height)
	return make("Frame", {Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1}, parent)
end
local function card(parent, height)
	local frame = make("Frame", {Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = C.card, BorderSizePixel = 0}, parent)
	corner(frame, 12)
	stroke(frame,C.light,0.65)
	return frame
end
local function money(value)
	value = tonumber(value) or 0
	for _, unit in ipairs({{1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"}}) do
		if value >= unit[1] then return string.format("%.1f%s", value / unit[1], unit[2]) end
	end
	return string.format("%d", math.floor(value))
end
local function seconds(value)
	value = math.max(0, math.ceil(value))
	return string.format("%d:%02d", math.floor(value / 60), value % 60)
end
local function now() return workspace:GetServerTimeNow() end
local function find(list, id)
	for _, item in ipairs(list) do if item.id == id then return item end end
	return nil
end
local function contains(list, id)
	for _, item in ipairs(list or {}) do if item == id then return true end end
	return false
end
local function selected()
	for _, brainrot in ipairs(state and state.brainrots or {}) do
		if brainrot.uid == selectedUid then return brainrot end
	end
	return nil
end
local function rarity(id)
	return find(Config.Rarities, id) or {name = tostring(id), color = C.muted}
end

