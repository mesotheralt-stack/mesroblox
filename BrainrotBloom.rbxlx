				tube("SweptHorn",{V(side*0.59,3.81,-0.83),V(side*0.8,4.25,-0.52),V(side*0.88,4.51,-0.13)},0.24,ivory)
				for panel=1,3 do
					piece("WingMembrane",V(1.12,0.18,1.45),V(side*(1.1+panel*0.54),2.75+panel*0.19,0.4+panel*0.21),trim,"Wedge",A(0,side*0.24,side*-0.28))
					rod("WingRib",V(side*0.8,2.6,0.1),V(side*(1.4+panel*0.6),3.0+panel*0.17,0.15+panel*0.55),0.09,pale)
				end
				dot("DragonNostril",V(side*0.28,3.1,-2.62),0.11,dark)
				piece("DragonFang",V(0.12,0.21,0.1),V(side*0.37,2.63,-2.64),ivory,"Wedge")
			end
			orb("DragonSmile",V(0.88,0.085,0.1),V(0,2.74,-2.65),ink)
			tube("LongDragonTail",{V(0,1.58,1.8),V(0.38,1.39,2.5),V(0.9,1.16,3.1),V(1.52,1.37,3.35),V(1.86,1.63,3.1)},0.53,base)
			for i=1,5 do piece("BackSpine",V(0.3,0.48,0.47),V(0,2.57,0.0+i*0.4),trim,"Wedge") end
		else
			orb("LionHead",V(2.0,1.8,1.75),V(0,2.61,-1.04),base)
			for _,side in {-1,1} do
				orb("LionEar",V(0.64,0.7,0.46),V(side*0.74,3.54,-0.65),base)
				orb("LionEarVelvet",V(0.36,0.4,0.09),V(side*0.74,3.57,-0.89),blush:Lerp(base,0.35))
			end
			for i=1,14 do
				local a=i*math.pi*2/14
				orb("LayeredManeLock",V(0.61,0.91,0.61),V(math.sin(a)*1.18,2.61+math.cos(a)*1.18,-0.65),i%2==0 and trim or trim:Lerp(ink,0.13),A(0,0,-a))
			end
			for _,side in {-1,1} do
				eye("LionEye",V(side*0.47,2.95,-1.86),0.44)
				orb("LionMuzzle",V(0.69,0.57,0.43),V(side*0.3,2.35,-1.9),ivory)
				for i=1,2 do rod("Whisker",V(side*0.56,2.31,-2.1),V(side*1.0,2.23+i*0.15,-2.01),0.04,dark) end
			end
			orb("LionNose",V(0.35,0.27,0.2),V(0,2.56,-2.2),dark)
			tube("LionTail",{V(0,1.63,1.95),V(0.55,1.83,2.5),V(0.78,2.24,2.7)},0.18,base)
			orb("TailTuft",V(0.45,0.69,0.45),V(0.79,2.42,2.69),trim)
		end
	elseif shape=="sun" then
		-- A sculpted sun disc with layered flame rays, rather than a ball with a hat.
		orb("SunDisc",V(2.9,2.9,0.95),V(0,2.6,0),base)
		orb("SunInnerDisc",V(2.42,2.42,0.18),V(0,2.6,-0.53),pale)
		for i=1,12 do
			local a=i*math.pi/6
			piece("FlameRay",V(0.43,1.04,0.38),V(math.sin(a)*1.86,2.6+math.cos(a)*1.86,0),i%2==0 and trim or base,"Wedge",A(0,0,-a))
			orb("RayTip",V(0.2,0.36,0.18),V(math.sin(a)*2.2,2.6+math.cos(a)*2.2,0),pale,A(0,0,-a))
		end
		face(V(0,2.84,-0.67),0.51,0.57,true)
		for _,side in {-1,1} do foot(V(side*0.55,0.31,0),V(0.7,0.38,0.85),trim,false) end
	elseif shape=="moon" then
		-- A filled crescent ribbon has a clean silhouette and continuous front
		-- surface. The inner edge stays hollow and both horns taper to a point.
		local outer,inner={},{}
		for i=0,16 do
			local t=i/16
			local a=(0.3+t*1.4)*math.pi
			local thickness=0.045+math.sin(t*math.pi)^0.8*0.96
			local center=V(math.cos(a)*1.43,2.5+math.sin(a)*1.6,0)
			local normal=V(math.cos(a),math.sin(a),0)
			outer[i+1]=center+normal*(thickness/2)
			inner[i+1]=center-normal*(thickness/2)
		end
		for i=1,16 do
			flatTriangle("CrescentRibbon",outer[i],outer[i+1],inner[i],0.72,base)
			flatTriangle("CrescentRibbon",inner[i],outer[i+1],inner[i+1],0.72,base)
		end
		orb("MochiFace",V(1.35,1.55,0.95),V(-0.57,2.65,-0.12),pale)
		face(V(-0.57,2.82,-0.59),0.28,0.35,false)
		for i=1,5 do dot("MoonCrater",V(-1.4+(i%2)*0.23,1.8+i*0.27,-0.43),0.15+(i%2)*0.1,dark) end
		for _,side in {-1,1} do foot(V(side*0.45,0.35,0),V(0.6,0.35,0.8),trim,false) end
		for i=1,4 do
			local a=i*math.pi/2
			local sparkle=piece("MoonStar",V(0.22,0.22,0.17),V(math.cos(a)*2.05,2.7+math.sin(a)*1.8,0),trim,nil,A(0,0,math.pi/4))
			sparkle.Material=Enum.Material.Neon
		end
	elseif shape=="void" then
		orb("ObsidianCore",V(1.8,2.55,1.3),V(0,2.67,0),base)
		for i=1,5 do
			piece("FloatingArmorScale",V(1.7-i*0.16,0.36,1.25-i*0.08),V(0,1.5+i*0.38,-0.04),i%2==0 and base or dark,nil,A(0,i*0.2,0))
		end
		for _,side in {-1,1} do
			local pupil=orb("VoidEye",V(0.36,0.19,0.12),V(side*0.39,2.99,-0.75),trim,A(0,0,side*-0.15))
			pupil.Material=Enum.Material.Neon
			tube("CrescentShoulder",{V(side*0.85,2.7,0),V(side*1.22,2.9,0),V(side*1.46,3.35,0)},0.26,dark)
		end
		for i=1,18 do
			local a=i*math.pi/9
			local b=(i+1)*math.pi/9
			local halo=rod("TiltedVoidHalo",V(math.cos(a)*2.15,2.7+math.sin(a)*1.65,math.sin(a)*0.75),V(math.cos(b)*2.15,2.7+math.sin(b)*1.65,math.sin(b)*0.75),0.1,trim)
			halo.Material=Enum.Material.Neon
		end
		for i=1,6 do
			local a=i*math.pi/3
			piece("OrbitShard",V(0.35,0.65,0.25),V(math.cos(a)*2.15,2.7+math.sin(a)*1.65,math.sin(a)*0.75),base,"Wedge",A(0,0,-a))
		end
		ring("LowerOrbit",V(0,0.65,0),0.86,0.07,trim,"horizontal",10)
	elseif shape=="crown" then
		-- An emperor made of folded noodles, with a separate robe and royal regalia.
		orb("RoyalRobe",V(2.7,2.25,1.95),V(0,1.4,0),base)
		piece("CapePanel",V(2.8,2.5,0.23),V(0,1.9,0.99),dark)
		for i=-2,2 do tube("NoodlePleat",{V(i*0.4,0.55,-0.78),V(i*0.3,1.2,-0.95),V(i*0.22,1.95,-0.82)},0.17,trim) end
		orb("NoodleHead",V(1.85,1.65,1.4),V(0,3.0,0),pale)
		face(V(0,3.15,-0.68),0.38,0.46,false)
		piece("CrownBand",V(2.15,0.4,1.72),V(0,3.92,0),trim)
		for i=-2,2 do
			piece("CrownProng",V(0.26,0.62+(i%2)*0.24,0.3),V(i*0.43,4.37,-0.12),trim,"Wedge")
			dot("CrownPearl",V(i*0.43,4.72+(i%2)*0.12,-0.12),0.18,ivory)
		end
		for i=-1,1 do piece("CrownJewel",V(0.24,0.25,0.11),V(i*0.57,3.95,-0.91),i==0 and base or blush,nil,A(0,0,math.pi/4)) end
		for _,side in {-1,1} do
			orb("RoyalSleeve",V(0.82,1.15,0.8),V(side*1.17,2.05,0),base,A(0,0,side*0.4))
			foot(V(side*0.57,0.25,-0.15),V(0.68,0.36,1.0),trim,false)
		end
		rod("RoyalScepter",V(1.63,0.5,-0.1),V(1.63,3.17,-0.1),0.16,trim)
		dot("ScepterGem",V(1.63,3.4,-0.1),0.45,base)
	elseif shape=="croissant" then
		-- An arched pastry with layered folds, tapered tips and a baker's scarf.
		orb("PastryBelly",V(1.65,1.75,1.1),V(0,1.41,0.02),base:Lerp(ivory,0.17))
		for i=0,8 do
			local a=math.pi*(0.12+i*0.095)
			local t=0.63+math.sin(i/8*math.pi)*0.68
			orb("PastryFold",V(t,1.04,1.25),V(math.cos(a)*1.42,1.76+math.sin(a)*0.66,0),i%2==0 and base or base:Lerp(ivory,0.14),A(0,0,a-math.pi/2))
			rod("ToastedFold",V(math.cos(a)*1.42-0.16,1.93+math.sin(a)*0.66,-0.53),V(math.cos(a)*1.42+0.06,2.17+math.sin(a)*0.66,-0.47),0.055,dark)
		end
		for _,side in {-1,1} do
			orb("CurledPastryTip",V(0.59,0.8,0.9),V(side*1.57,1.49,-0.1),base,A(0,0,side*0.38))
			foot(V(side*0.63,0.33,0),V(0.7,0.43,1.05),trim,false)
		end
		orb("PastryFace",V(1.4,1.03,0.35),V(0,2.07,-0.65),pale)
		face(V(0,2.23,-0.83),0.33,0.42,true)
		piece("BakerScarf",V(1.65,0.22,0.45),V(0,1.38,-0.48),trim)
		piece("ScarfTail",V(0.34,0.7,0.14),V(0.54,1.02,-0.7),trim,nil,A(0,0,-0.19))
		for i=1,3 do dot("FlourDust",V((i-2)*0.35,2.88+(i%2)*0.08,-0.18),0.1,ivory) end
	elseif shape=="snail" then
		-- A low foot, raised head and a genuinely coiled shell make this a snail.
		orb("SnailFoot",V(2.2,0.43,3.65),V(0,0.43,0.12),base)
		orb("SnailBody",V(1.54,0.9,2.92),V(0,0.83,0.1),pale)
		orb("SnailNeck",V(1.25,1.38,1.02),V(0,1.2,-1.13),base)
		orb("SnailHead",V(1.6,1.04,1.03),V(0,1.8,-1.27),base)
		orb("SnailMuzzle",V(1.1,0.55,0.38),V(0,1.53,-1.64),pale)
		orb("CoiledShell",V(2.4,2.35,1.5),V(0,1.98,0.6),trim)
		local previous=nil
		for i=0,18 do
			local t=i/18
			local a=t*math.pi*3.8
			local p=V(math.cos(a)*(0.13+t*0.9),1.98+math.sin(a)*(0.13+t*0.89),-0.17)
			if previous then rod("ShellSpiral",previous,p,0.1,trim:Lerp(ink,0.22)) end
			previous=p
		end
		for _,side in {-1,1} do
			rod("SnailEyeStalk",V(side*0.45,2.07,-1.38),V(side*0.64,2.9,-1.37),0.13,dark)
			eye("SnailEye",V(side*0.64,2.93,-1.48),0.43,trim:Lerp(ink,0.5))
			for i=1,3 do dot("FootFreckle",V(side*(0.84-i*0.05),0.52,-0.8+i*0.57),0.12,trim) end
		end
		orb("SnailSmile",V(0.48,0.1,0.09),V(0,1.43,-1.84),ink)
		orb("SnailCheek",V(0.27,0.12,0.08),V(-0.36,1.5,-1.84),blush)
	elseif shape=="teapot" then
		orb("GlazedTeapot",V(2.6,2.25,2.1),V(0,1.77,0),base)
		orb("TeapotFootRing",V(1.85,0.28,1.55),V(0,0.7,0),trim)
		orb("PorcelainLid",V(2.05,0.35,1.79),V(0,2.94,0),pale)
		orb("LidFinial",V(0.45,0.48,0.45),V(0,3.3,0),trim)
		tube("CurvedSpout",{V(-1.0,1.7,0),V(-1.6,1.94,0),V(-1.88,2.46,0),V(-2.13,2.7,0)},0.44,base)
		orb("SpoutRim",V(0.46,0.23,0.46),V(-2.13,2.73,0),trim,A(0,0,-0.4))
		ring("TeapotHandle",V(1.39,1.99,0.14),0.79,0.18,trim,"front",12)
		face(V(0,1.97,-1.03),0.47,0.52,true)
		for _,side in {-1,1} do foot(V(side*0.55,0.33,-0.01),V(0.66,0.4,0.96),trim,false) end
		for i=-1,1 do
			piece("PorcelainPetal",V(0.2,0.25,0.055),V(i*0.33,1.17,-0.94),trim,nil,A(0,0,i*0.55))
		end
		for i=1,3 do
			local steam=orb("TeaSteam",V(0.18,0.65,0.17),V(-0.36+(i-1)*0.36,3.67+(i%2)*0.23,0.04),ivory,A(0,0,i%2==0 and 0.25 or -0.25))
			steam.Transparency=0.48
		end
	elseif shape=="turtle" then
		orb("TerrapinBody",V(2.65,1.2,2.75),V(0,0.93,0.24),base)
		orb("TerrariumShell",V(3.25,1.8,3.1),V(0,1.7,0.45),trim)
		piece("ShellRim",V(0.3,3.4,3.2),V(0,1.13,0.45),trim:Lerp(ink,0.17),Enum.PartType.Cylinder,A(0,0,math.pi/2))
		for i=1,7 do
			local a=i*math.pi*2/7
			local x,z=math.cos(a)*0.94,math.sin(a)*0.82
			local top=math.sqrt(1-(x/1.625)^2-(z/1.55)^2)
			local normal=V(x/(1.625*1.625),top/0.9,z/(1.55*1.55))
			orb("ShellMosaic",V(0.65,0.14,0.7),V(x,1.7+0.9*top+0.065,0.45+z),i%2==0 and pale or base,CFrame.lookAt(Vector3.zero,normal,V(0,0,1))*A(math.pi/2,0,0))
		end
		orb("ShellCrownMosaic",V(1.05,0.16,1.16),V(0,2.69,0.45),pale)
		orb("TurtleNeck",V(1.15,0.74,0.95),V(0,1.14,-1.31),base)
		orb("TerrapinHead",V(1.7,1.1,1.36),V(0,1.48,-1.83),base)
		face(V(0,1.65,-2.43),0.36,0.45,false)
		for _,side in {-1,1} do
			for _,z in {-0.59,1.36} do foot(V(side*1.23,0.48,z),V(0.85,0.5,1.19),base,false) end
		end
		tube("TurtleTail",{V(0,0.91,1.59),V(0,0.7,2.08),V(0.22,0.73,2.4)},0.24,base)
		-- A living little garden grows from the shell's crown.
		rod("TerrariumSprig",V(0,2.62,0.45),V(0.06,3.33,0.45),0.1,dark)
		for _,side in {-1,1} do orb("ShellGardenLeaf",V(0.71,0.17,0.35),V(side*0.3,3.18,0.45),base,A(0,side*0.2,side*0.25)) end
		dot("ShellGardenBud",V(0.06,3.45,0.45),0.31,ivory)
	elseif shape=="koi" then
		orb("KoiBody",V(2.2,2.03,3.65),V(0,1.94,0.24),base)
		orb("KoiBelly",V(1.65,1.22,2.8),V(0,1.47,-0.1),ivory)
		orb("KoiHead",V(1.95,1.82,1.8),V(0,2.05,-1.15),base)
		orb("KoiTailPeduncle",V(0.86,0.85,1.05),V(0,1.94,2.04),base)
		face(V(0,2.24,-1.98),0.43,0.46,false)
		orb("KoiLips",V(0.54,0.24,0.18),V(0,1.65,-2.05),trim)
		for _,side in {-1,1} do
			piece("KoiFanTail",V(1.65,1.5,0.2),V(side*0.61,1.94,2.58),trim,"Wedge",A(0,0,side*0.65))
			orb("PectoralFin",V(1.72,0.2,1.1),V(side*1.4,1.76,-0.12),trim,A(0,side*0.52,side*-0.2))
			tube("KoiWhisker",{V(side*0.38,1.75,-1.99),V(side*0.77,1.57,-2.15),V(side*1.02,1.7,-2.11)},0.06,ivory)
			for i=1,3 do
				local z=-0.3+i*0.53
				local x=side*1.1*math.sqrt(1-(0.06/1.015)^2-((z-0.24)/1.825)^2)
				local normal=V(x/(1.1*1.1),0.06/(1.015*1.015),(z-0.24)/(1.825*1.825))
				orb("KoiSideScale",V(0.13,0.43,0.49),V(x+side*0.06,2.0,z),trim:Lerp(base,i*0.11),CFrame.lookAt(Vector3.zero,normal)*A(0,math.pi/2,0))
			end
			local function finSurface(u,v)
				local y=0.1*math.sqrt(1-(u/0.86)^2-(v/0.55)^2)+0.035
				local yaw,roll=side*0.52,side*-0.2
				local x=math.cos(roll)*u-math.sin(roll)*y
				return V(side*1.4+math.cos(yaw)*x+math.sin(yaw)*v,1.76+math.sin(roll)*u+math.cos(roll)*y,-0.12-math.sin(yaw)*x+math.cos(yaw)*v)
			end
			for i=1,3 do rod("FinRay",finSurface(side*-0.35,0),finSurface(side*0.6,(i-2)*0.16),0.035,ivory) end
		end
		for i=1,4 do piece("KoiDorsal",V(0.17,0.62,0.74),V(0,2.96,0.03+i*0.43),trim,"Wedge") end
		orb("KoiForeheadMark",V(0.8,0.15,0.65),V(0,2.99,-1.17),trim)
		ring("FloatingRipple",V(0,0.34,0.24),1.41,0.055,trim,"horizontal",14)
	elseif shape=="clock" then
		local brass=trim
		piece("WatchCase",V(0.79,3.15,3.15),V(0,2.13,0),brass,Enum.PartType.Cylinder,A(0,math.pi/2,0))
		piece("WatchDial",V(0.12,2.76,2.76),V(0,2.13,-0.45),pale,Enum.PartType.Cylinder,A(0,math.pi/2,0))
		for i=1,12 do
			local a=i*math.pi/6
			piece("DialHourMark",V(0.09,i%3==0 and 0.24 or 0.15,0.06),V(math.sin(a)*1.15,2.13+math.cos(a)*1.15,-0.54),brass,nil,A(0,0,-a))
		end
		rod("ClockMinuteHand",V(0,2.32,-0.59),V(-0.44,2.95,-0.59),0.09,dark)
		rod("ClockHourHand",V(0,2.32,-0.62),V(0.5,2.62,-0.62),0.13,dark)
		dot("ClockPin",V(0,2.32,-0.7),0.21,brass)
		face(V(0,1.88,-0.56),0.48,0.4,false)
		piece("WindingCrown",V(0.62,0.33,0.5),V(0,3.89,0),brass)
		ring("WatchBow",V(0,4.26,0),0.35,0.11,brass,"front",10)
		for _,side in {-1,1} do
			foot(V(side*0.64,0.29,0),V(0.78,0.4,1.05),brass,false)
			orb("WatchGlove",V(0.48,0.6,0.44),V(side*1.63,1.83,0),ivory)
		end
		for i=1,3 do
			local a=i*math.pi/2
			piece("OrbitTick",V(0.16,0.24,0.14),V(math.sin(a)*2.03,2.13+math.cos(a)*1.86,0),brass,nil,A(0,0,-a))
		end
	elseif shape=="manta" then
		-- Broad swept wings, cephalic fins and a flowing tail create a ray silhouette.
		orb("NebulaRayBody",V(2.9,1.12,3.0),V(0,1.83,0),base)
		orb("RayIvoryBelly",V(2.55,0.36,2.65),V(0,1.42,-0.07),pale)
		for _,side in {-1,1} do
			orb("RayWingShoulder",V(1.35,0.52,1.9),V(side*1.1,1.8,0.1),base)
			orb("SweptRayWing",V(4.0,0.33,2.3),V(side*2.37,1.79,0.37),base,A(0,side*0.37,side*0.14))
			tube("CephalicFin",{V(side*0.78,1.85,-1.04),V(side*1.02,1.96,-1.66),V(side*0.75,2.15,-1.91)},0.29,base)
			local function onWing(i)
				local u,v=side*(-0.9+i*0.65),(i%2)*0.2
				local y=0.165*math.sqrt(1-(u/2)^2-(v/1.15)^2)+0.055
				local yaw,roll=side*0.37,side*0.14
				local x=math.cos(roll)*u-math.sin(roll)*y
				return V(side*2.37+math.cos(yaw)*x+math.sin(yaw)*v,1.79+math.sin(roll)*u+math.cos(roll)*y,0.37-math.sin(yaw)*x+math.cos(yaw)*v)
			end
			for i=1,3 do
				dot("RayConstellationStar",onWing(i),0.15,ivory)
				if i<3 then rod("RayConstellationLine",onWing(i),onWing(i+1),0.035,trim) end
			end
			eye("RayEye",V(side*0.48,2.08,-1.38),0.41,trim:Lerp(ink,0.5))
		end
		tube("CometRayTail",{V(0,1.82,1.3),V(0.23,1.81,2.17),V(0.73,2.06,3.0),V(1.38,2.55,3.56),V(1.7,2.93,3.38)},0.26,dark)
		orb("RaySmile",V(0.48,0.1,0.13),V(0,1.68,-1.5),ink)
		for i=1,3 do
			piece("AstralRayCrest",V(0.19,0.66+(i%2)*0.23,0.18),V((i-2)*0.33,2.7,0.1),trim,"Wedge",A(0,0,(i-2)*0.22))
		end
		local crystal=piece("RayCrestGem",V(0.25,0.34,0.21),V(0,3.22,0.08),trim,"Wedge")
		crystal.Material=Enum.Material.Glass
	else
		orb("UnknownBud",V(2.4,2.6,2.0),V(0,1.8,0),base)
		face(V(0,2.2,-0.96),0.48,0.53,true)
		for _,side in {-1,1} do foot(V(side*0.6,0.35,0),V(0.7,0.45,1.0),trim,false) end
	end
	-- Selected finishes give the sculptures a deliberate material hierarchy;
	-- broad bodies stay soft while glass, cloth and royal metal read separately.
	local finishes={
		LowStone=Enum.Material.Slate,MiddleStone=Enum.Material.Slate,CrowningStone=Enum.Material.Slate,
		EmbeddedQuartz=Enum.Material.Glass,GlassWing=Enum.Material.Glass,
		ClearSpaceHelmet=Enum.Material.Glass,WandCrystal=Enum.Material.Glass,ScepterGem=Enum.Material.Glass,
		CrownBand=Enum.Material.Metal,CrownProng=Enum.Material.Metal,CrownJewel=Enum.Material.Glass,
		RoyalScepter=Enum.Material.Metal,DiscoChestTile=Enum.Material.Metal,DiscoHeadBand=Enum.Material.Metal,
		FloatingArmorScale=Enum.Material.Metal,OrbitShard=Enum.Material.Glass,
		ExplorerSatchel=Enum.Material.Fabric,SatchelFlap=Enum.Material.Fabric,
		SatchelBuckle=Enum.Material.Metal,BakerScarf=Enum.Material.Fabric,ScarfTail=Enum.Material.Fabric,
		GlazedTeapot=Enum.Material.Glass,PorcelainLid=Enum.Material.Glass,PorcelainPetal=Enum.Material.Metal,
		WatchCase=Enum.Material.Metal,WindingCrown=Enum.Material.Metal,WatchBow=Enum.Material.Metal,
		DialHourMark=Enum.Material.Metal,ClockPin=Enum.Material.Metal,OrbitTick=Enum.Material.Metal,
		LittleWalkingStick=Enum.Material.Wood,LittleWalkingStickJoint=Enum.Material.Wood,LittleWalkingStickTip=Enum.Material.Wood,
	}
	for _,object in model:GetChildren() do
		if object:IsA("BasePart") then
			if finishes[object.Name] then object.Material=finishes[object.Name] end
			-- Tiny face layers should read as a painted expression, not cast
			-- striped shadows over the eye or cheek beneath them.
			if string.match(object.Name,"White$") or string.match(object.Name,"Iris$") or string.match(object.Name,"Pupil$")
				or string.match(object.Name,"Catchlight$") or string.match(object.Name,"UpperLid$") or string.match(object.Name,"SoftReflection$")
				or object.Name=="Cheek" or object.Name=="HappyMouth" or object.Name=="Smile" or object.Name=="Tongue" then
				object.CastShadow=false
			end
		end
	end
	if spec.rarity=="Mythic" or spec.rarity=="Secret" then
		local light=Instance.new("PointLight")
		light.Color=trim
		light.Brightness=0.35
		light.Range=7
		light.Parent=root
	end
	if scale and scale~=1 then model:ScaleTo(math.clamp(scale,0.1,5)) end
	return model
end

return CreatureFactory
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">BrainrotServer</string>
      </Properties>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">DetectorTool</string>
          <string name="Source"><![CDATA[-- Cosmetic, physically welded detector. Capture authority stays in Main.server.
local DetectorTool = {}

local function removeOld(container)
	if not container then return end
	for _, child in container:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("BrainrotDetector") then child:Destroy() end
	end
end

function DetectorTool.equip(player, spec)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	if not backpack or not character then return end
	removeOld(backpack)
	removeOld(character)
	local tool = Instance.new("Tool")
	tool.Name = spec.name
	tool.ToolTip = "Search the sand • use DIG or press E"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("BrainrotDetector", true)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.38, 1.15, 0.4)
	handle.Color = Color3.fromRGB(35, 43, 49)
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.Parent = tool
	local function piece(name, size, frame, color, shape)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.CFrame = frame
		part.Color = color
		part.Material = Enum.Material.Metal
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		if shape then part.Shape = shape end
		part.Parent = tool
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = part
		weld.Parent = part
		return part
	end
	piece("Shaft", Vector3.new(0.18, 3.4, 0.18), CFrame.new(0, -1.8, -0.65) * CFrame.Angles(math.rad(25), 0, 0), spec.color)
	-- A hollow search loop reads as an instrument instead of a solid paddle.
	-- Stronger detectors have a broader coil and an additional inner winding.
	local radiusX=spec.power>=5 and 1.16 or 0.96
	local radiusZ=spec.power>=5 and 0.84 or 0.96
	local function winding(name,factor)
		for index=1,12 do
			local function at(a)
				return Vector3.new(math.cos(a)*radiusX*factor,-3.3,-1.4+math.sin(a)*radiusZ*factor)
			end
			local a=at((index-1)*math.pi/6)
			local b=at(index*math.pi/6)
			piece(name,Vector3.new(0.14,0.12,(b-a).Magnitude+0.025),CFrame.lookAt((a+b)*0.5,b),spec.color)
		end
	end
	winding("SearchCoil",1)
	if spec.power>=6 then winding("InnerWinding",0.72) end
	piece("CoilBridge",Vector3.new(radiusX*2-0.1,0.1,0.16),CFrame.new(0,-3.3,-1.4),Color3.fromRGB(49,62,65))
	piece("ShaftCoupling",Vector3.new(0.3,0.38,0.3),CFrame.new(0,-2.42,-0.94)*CFrame.Angles(math.rad(25),0,0),Color3.fromRGB(66,81,83))
	for index=1,4 do
		local grip=piece("GripRib",Vector3.new(0.41,0.07,0.43),CFrame.new(0,-0.42+index*0.2,0),Color3.fromRGB(73,83,83))
		grip.Material=Enum.Material.SmoothPlastic
	end
	piece("ControlBox", Vector3.new(0.85, 0.6, 0.5), CFrame.new(0, -0.6, -0.35), spec.color)
	piece("DisplayBezel",Vector3.new(0.85,0.07,0.49),CFrame.new(0,-0.3,-0.35),Color3.fromRGB(35,49,52))
	local screen = piece("SignalDisplay", Vector3.new(0.63, 0.08, 0.32), CFrame.new(0, -0.27, -0.35), Color3.fromRGB(166, 255, 179))
	screen.Material = Enum.Material.Neon
	for index=1,3 do
		piece("SignalTrace",Vector3.new(0.065,0.012,0.06+index*0.045),CFrame.new(-0.23+index*0.11,-0.223,-0.35),Color3.fromRGB(48,103,86))
	end
	piece("TuningDial",Vector3.new(0.08,0.18,0.18),CFrame.new(0.33,-0.235,-0.35)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(214,218,194),Enum.PartType.Cylinder)
	tool.Grip = CFrame.new(0, -0.25, 0)
	tool.Parent = backpack
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then humanoid:EquipTool(tool) end
	return tool
end

return DetectorTool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">GardenService</string>
          <string name="Source"><![CDATA[-- Six shared-world gardens. Ownership and display choices are server-managed;
-- placing creatures here does not change the collection's passive income.
local GardenService = {}
local V = Vector3.new
local rgb = Color3.fromRGB
local WOOD = rgb(145,110,76)
local DARK = rgb(70,89,72)
local CREAM = rgb(239,229,201)
local STONE = rgb(190,197,169)
local LEAF = rgb(116,164,100)

local function folder(parent,name)
	local object=Instance.new("Folder");object.Name=name;object.Parent=parent;return object
end
local function part(parent,name,size,position,color,material,shape,rotation)
	local object=Instance.new("Part")
	object.Name=name;object.Size=size;object.Position=position;object.Color=color
	object.Material=material or Enum.Material.SmoothPlastic
	object.Anchored=true;object.TopSurface=Enum.SurfaceType.Smooth;object.BottomSurface=Enum.SurfaceType.Smooth
	if shape then object.Shape=shape end
	if rotation then object.CFrame=CFrame.new(position)*rotation end
	object.Parent=parent
	return object
end
local function detail(parent,name,size,position,color,shape,rotation)
	local object=part(parent,name,size,position,color,nil,shape,rotation)
	object.CanCollide=false;object.CanTouch=false;object.CanQuery=false
	return object
end
local function sign(parent,name,position,width,text,tint)
	local board=part(parent,name,V(width,2.5,0.3),position,DARK,Enum.Material.Wood,nil,CFrame.Angles(0,math.pi,0))
	board.CanCollide=false
	local surface=Instance.new("SurfaceGui")
	surface.Name="GardenSign";surface.Face=Enum.NormalId.Front;surface.CanvasSize=Vector2.new(640,96)
	surface.MaxDistance=85;surface.LightInfluence=0.25;surface.Parent=board
	local label=Instance.new("TextLabel")
	label.Name="Text";label.BackgroundTransparency=1;label.Size=UDim2.new(1,-22,1,-8)
	label.Position=UDim2.fromOffset(11,4);label.Font=Enum.Font.BuilderSansMedium
	label.TextSize=30;label.TextColor3=tint or CREAM;label.Text=text;label.TextTruncate=Enum.TextTruncate.AtEnd
	label.Parent=surface
	return label,board
end
local function prompt(target,action,gardenId,slot)
	local object=Instance.new("ProximityPrompt")
	object.ActionText=action;object.ObjectText="Personal garden";object.KeyboardKeyCode=Enum.KeyCode.F
	object.MaxActivationDistance=13;object.RequiresLineOfSight=false;object.HoldDuration=0
	object:SetAttribute("Garden",true);object:SetAttribute("GardenId",gardenId)
	if slot then object:SetAttribute("GardenSlot",slot) end
	object.Parent=target
end
local function lamp(parent,position)
	part(parent,"LanternPost",V(0.65,7.5,0.65),position+V(0,3.75,0),WOOD,Enum.Material.Wood)
	part(parent,"LanternCap",V(2.0,0.35,2.0),position+V(0,8,0),CREAM,Enum.Material.Metal)
	local glass=detail(parent,"LanternGlass",V(1.3,1.5,1.3),position+V(0,7.1,0),rgb(255,224,164))
	glass.Material=Enum.Material.Neon
	local glow=Instance.new("PointLight");glow.Color=glass.Color;glow.Brightness=0.8;glow.Range=28;glow.Parent=glass
end
local function flowers(parent,position,tint)
	for j=1,3 do
		local x=(j-2)*2.2
		detail(parent,"FlowerStem",V(0.12,1.3,0.12),position+V(x,0.65,j%2),LEAF)
		detail(parent,"FlowerBloom",V(1.5,0.5,1.5),position+V(x,1.4,j%2),tint,Enum.PartType.Ball)
		detail(parent,"FlowerHeart",V(0.45,0.22,0.45),position+V(x,1.7,j%2),CREAM,Enum.PartType.Ball)
	end
end
local function fence(parent,position,across,width)
	local size=across and V(width,0.35,0.35) or V(0.35,0.35,width)
	for _,h in {1.7,3.0} do part(parent,"FenceRail",size,position+V(0,h,0),WOOD,Enum.Material.Wood) end
	for _,side in {-1,1} do
		local offset=across and V(side*width/2,0,0) or V(0,0,side*width/2)
		part(parent,"FencePost",V(0.8,3.8,0.8),position+offset+V(0,1.9,0),WOOD,Enum.Material.Wood)
	end
end

function GardenService.build(parent,config)
	local neighborhood=folder(parent,"GardenNeighborhood")
	part(neighborhood,"GardenIslandStone",V(466,13,404),V(0,-8,-585),rgb(128,140,115),Enum.Material.Slate)
	part(neighborhood,"GardenIslandLawn",V(460,6,400),V(0,-2.7,-585),LEAF,Enum.Material.Grass)
	part(neighborhood,"GardenEntranceRoad",V(22,0.18,52),V(0,0.45,-411),STONE,Enum.Material.Cobblestone)
	-- A walkable connection from Meadow's rear edge to the neighborhood.
	local bridge=folder(neighborhood,"NeighborhoodBridge")
	for j=0,18 do
		part(bridge,"BridgePlank",V(18,0.4,3.2),V(0,0.5,-329-j*3.2),WOOD,Enum.Material.WoodPlanks)
		if j%3==0 then
			for _,x in {-9,9} do part(bridge,"BridgePost",V(0.6,4,0.6),V(x,2.6,-329-j*3.2),DARK,Enum.Material.Wood) end
		end
	end
	for _,x in {-9,9} do part(bridge,"BridgeHandrail",V(0.4,0.4,61),V(x,4.5,-358),WOOD,Enum.Material.Wood) end
	for _,z in {-425,-590,-750} do
		part(neighborhood,"GardenCrossStreet",V(430,0.2,12),V(0,0.45,z),STONE,Enum.Material.Cobblestone)
	end
	for _,x in {-210,210} do
		part(neighborhood,"GardenBoulevard",V(12,0.2,337),V(x,0.45,-587),STONE,Enum.Material.Cobblestone)
		for _,z in {-424,-587,-750} do lamp(neighborhood,V(x,0.3,z)) end
	end
	local _,entrance=sign(neighborhood,"NeighborhoodSign",V(0,8.2,-399),32,"The personal gardens",CREAM)
	for _,x in {-14,14} do part(neighborhood,"NeighborhoodSignPost",V(0.8,8,0.8),V(x,4.2,-399),WOOD,Enum.Material.Wood) end
	entrance:SetAttribute("GardenEntrance",true)
	local plots={}
	local tints={rgb(204,168,132),rgb(151,185,151),rgb(157,179,197),rgb(188,165,200),rgb(216,190,128),rgb(158,192,184)}
	for id=1,6 do
		local column=(id-1)%3
		local row=math.floor((id-1)/3)
		local center=V((column-1)*140,0,-505-row*160)
		local model=Instance.new("Model");model.Name=string.format("Garden%02d",id);model.Parent=neighborhood
		model:SetAttribute("GardenId",id);model:SetAttribute("OwnerUserId",0)
		part(model,"GardenLawn",V(110,0.22,120),center+V(0,0.53,0),LEAF:Lerp(CREAM,0.05+id*0.012),Enum.Material.Grass)
		for _,side in {-1,1} do
			fence(model,center+V(side*55,0.65,0),false,120)
			fence(model,center+V(side*34,0.65,60),true,42)
		end
		fence(model,center+V(0,0.65,-60),true,110)
		part(model,"GardenPath",V(13,0.16,97),center+V(0,0.73,3),STONE,Enum.Material.Cobblestone)
		part(model,"GateApproach",V(20,0.15,20),center+V(0,0.57,68),STONE,Enum.Material.Cobblestone)
		local gate=part(model,"GardenGateArch",V(27,0.7,1.7),center+V(0,8.9,60),WOOD,Enum.Material.Wood)
		for _,x in {-12,12} do part(model,"GatePost",V(1.0,9.0,1.0),center+V(x,4.9,60),WOOD,Enum.Material.Wood) end
		local ownerSign=sign(model,"OwnershipPlaque",center+V(0,7.1,60.4),24,"Garden "..id.." · Unclaimed",CREAM)
		prompt(gate,"Open garden",id)
		lamp(model,center+V(46,0.6,48))
		-- A small potting shed, water feature and generous flower beds.
		part(model,"PottingShed",V(23,8,15),center+V(-34,4.65,-42),tints[id],Enum.Material.WoodPlanks)
		part(model,"ShedRoof",V(27,0.8,19),center+V(-34,9.1,-42),DARK,Enum.Material.WoodPlanks)
		part(model,"ShedDoor",V(6.0,6.4,0.25),center+V(-34,3.8,-34.35),DARK,Enum.Material.Wood)
		detail(model,"ShedWindow",V(4,3,0.2),center+V(-26,5.5,-34.2),CREAM)
		part(model,"PottingTable",V(13,0.5,5),center+V(-34,2.7,-27),WOOD,Enum.Material.Wood)
		for _,x in {-5,5} do part(model,"TableLeg",V(0.5,2.4,3),center+V(-34+x,1.4,-27),WOOD) end
		local water=part(model,"BirdBath",V(10,0.9,10),center+V(36,2.1,-42),STONE,Enum.Material.Slate,Enum.PartType.Ball)
		part(model,"BathPedestal",V(2.5,2.6,2.5),center+V(36,1.3,-42),STONE,Enum.Material.Marble)
		detail(model,"BirdBathWater",V(8,0.14,8),water.Position+V(0,0.53,0),rgb(132,188,180),Enum.PartType.Ball)
		for _,x in {-42,42} do
			part(model,"RaisedFlowerBed",V(12,0.7,9),center+V(x,1.0,39),WOOD,Enum.Material.WoodPlanks)
			flowers(model,center+V(x,1.35,39),tints[id]:Lerp(CREAM,0.18))
		end
		local slots,slotSigns={},{}
		for slot=1,6 do
			local x=((slot-1)%3-1)*29
			local z=slot<=3 and 16 or -14
			local at=center+V(x,0.95,z)
			part(model,"DisplayBorder",V(14,0.32,14),at,STONE,Enum.Material.Slate,Enum.PartType.Ball)
			local pad=part(model,"DisplayPad",V(11.5,0.18,11.5),at+V(0,0.2,0),tints[id]:Lerp(CREAM,0.25),Enum.Material.Slate,Enum.PartType.Ball)
			pad:SetAttribute("GardenId",id);pad:SetAttribute("GardenSlot",slot)
			prompt(pad,"Choose a brainrot",id,slot)
			slots[slot]=CFrame.new(center+V(x,1.28,z))*CFrame.Angles(0,math.pi,0)
			slotSigns[slot]=sign(model,"SlotPlaque",center+V(x,1.8,z+9.0),13,"Display "..slot.." · Empty",CREAM)
		end
		local displays=folder(model,"DisplayedBrainrots")
		plots[id]={id=id,model=model,spawnCFrame=CFrame.new(center+V(0,5,48)),slots=slots,ownerSign=ownerSign,slotSigns=slotSigns,displays=displays}
	end
	return plots
end

function GardenService.new(plots,config,factory)
	local manager={plots=plots,byPlayer={},owners={},rendered={}}
	function manager:getPlot(player) return self.byPlayer[player] end
	function manager:getPlotId(player)
		local plot=self:getPlot(player);return plot and plot.id or nil
	end
	function manager:getSpawnCFrame(player)
		local plot=self:getPlot(player);return plot and plot.spawnCFrame or nil
	end
	function manager:claim(player)
		local current=self:getPlot(player)
		if current then return current.id end
		for id,plot in ipairs(self.plots) do
			if not self.owners[id] then
				self.owners[id]=player;self.byPlayer[player]=plot;self.rendered[id]={}
				plot.model:SetAttribute("OwnerUserId",player.UserId)
				plot.ownerSign.Text=(player.DisplayName or player.Name).."'s garden"
				return id
			end
		end
		return nil
	end
	function manager:release(player)
		local plot=self:getPlot(player)
		if not plot then return end
		self.byPlayer[player]=nil;self.owners[plot.id]=nil;self.rendered[plot.id]=nil
		plot.model:SetAttribute("OwnerUserId",0)
		plot.ownerSign.Text="Garden "..plot.id.." · Unclaimed"
		for _,child in table.clone(plot.displays:GetChildren()) do child:Destroy() end
		for slot,label in ipairs(plot.slotSigns) do label.Text="Display "..slot.." · Empty" end
	end
	function manager:sync(player,brainrots,gardenSlots)
		local plot=self:getPlot(player)
		if not plot then return false end
		local byUID,seen={},{}
		for _,brainrot in ipairs(brainrots or {}) do
			if type(brainrot.uid)=="string" then byUID[brainrot.uid]=brainrot end
		end
		local cache=self.rendered[plot.id] or {};self.rendered[plot.id]=cache
		for slot=1,#plot.slots do
			local uid=type(gardenSlots)=="table" and gardenSlots[slot] or ""
			local brainrot=type(uid)=="string" and byUID[uid] or nil
			local spec=brainrot and config.get(config.Creatures,brainrot.specId)
			if seen[uid] then brainrot=nil;spec=nil end
			if spec then seen[uid]=true end
			local value=brainrot and brainrot.level or 1
			if type(value)~="number" or value~=value or math.abs(value)==math.huge then value=1 end
			local level=math.clamp(math.floor(value),1,config.MaxLevel)
			local signature=spec and (uid..":"..spec.id..":"..level) or ""
			local old=cache[slot]
			if not old or old.signature~=signature then
				if old and old.model then old.model:Destroy() end
				if spec then
					local model=factory.create(spec,0.75+(level-1)*0.0075)
					model.Name=spec.name;model:SetAttribute("GardenId",plot.id);model:SetAttribute("OwnerUserId",player.UserId);model:SetAttribute("BrainrotUID",uid)
					model:PivotTo(plot.slots[slot]);model.Parent=plot.displays
					plot.slotSigns[slot].Text=spec.name.." · Lv "..level
					cache[slot]={signature=signature,model=model}
				else
					plot.slotSigns[slot].Text="Display "..slot.." · Empty"
					cache[slot]={signature=""}
				end
			end
		end
		return true
	end
	return manager
end

return GardenService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Brainrot Bloom: all currency, collections, rolls and capture rewards live on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("BrainrotShared")
local Config = require(Shared:WaitForChild("Config"))
local CreatureFactory = require(Shared:WaitForChild("CreatureFactory"))
local World = require(script.Parent:WaitForChild("World"))
local DetectorTool = require(script.Parent:WaitForChild("DetectorTool"))
local GardenService = require(script.Parent:WaitForChild("GardenService"))
local map = World.build(Config)
local gardens = GardenService.new(map.gardens, Config, CreatureFactory)

local remoteFolder = Instance.new("Folder")
remoteFolder.Name = "BrainrotRemotes"
local Action = Instance.new("RemoteFunction")
Action.Name = "Action"
Action.Parent = remoteFolder
local State = Instance.new("RemoteEvent")
State.Name = "State"
State.Parent = remoteFolder
local Notify = Instance.new("RemoteEvent")
Notify.Name = "Notify"
Notify.Parent = remoteFolder
remoteFolder.Parent = ReplicatedStorage

local storeOk, store = pcall(function()
	return DataStoreService:GetDataStore("BrainrotBloom_Player_v1")
end)
if not storeOk then
	warn("[Brainrot Bloom] Save store could not initialize: " .. tostring(store))
	store = nil
end
local sessionId = game.JobId .. ":" .. HttpService:GenerateGUID(false)
local profiles = {}
local joining = {}
local joiningUsers = {}
local releasingUsers = {}
local savesInFlight = {}
local closing = false
local rng = Random.new()
local MAX_COINS = 1e15
local LOCK_SECONDS = 180
local cachedEpoch = -1
local rotation = {}

local function integer(value, minimum, maximum, fallback)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
		return fallback
	end
	return math.clamp(math.floor(value), minimum, maximum)
end

local function lookup(list, id)
	if type(id) ~= "string" then return nil end
	return Config.get(list, id)
end

local function owned(list, id)
	return table.find(list, id) ~= nil
end

local function emptyGardenSlots()
	local slots = {}
	for slot = 1, Config.GardenSlots do slots[slot] = "" end
	return slots
end

local function newData()
	return {
		coins = Config.StartCoins,
		brainrots = {},
		foods = { [Config.Foods[1].id] = 3 },
		ownedDetectors = { Config.Detectors[1].id },
		detector = Config.Detectors[1].id,
		unlockedWorlds = { Config.Worlds[1].id },
		activeBrainrot = nil,
		discoveryCount = 0,
		discovered = {},
		gardenSlots = emptyGardenSlots(),
	}
end

local function sanitize(raw)
	local data = newData()
	if type(raw) ~= "table" then return data end
	data.coins = integer(raw.coins, 0, MAX_COINS, Config.StartCoins)
	data.discoveryCount = integer(raw.discoveryCount, 0, 1e9, 0)
	data.foods = {}
	for _, food in Config.Foods do
		data.foods[food.id] = integer(type(raw.foods) == "table" and raw.foods[food.id], 0, 9999, 0)
	end
	for _, spec in Config.Detectors do
		if type(raw.ownedDetectors) == "table" and owned(raw.ownedDetectors, spec.id) and not owned(data.ownedDetectors, spec.id) then
			table.insert(data.ownedDetectors, spec.id)
		end
	end
	if owned(data.ownedDetectors, raw.detector) then data.detector = raw.detector end
	for _, world in Config.Worlds do
		if type(raw.unlockedWorlds) == "table" and owned(raw.unlockedWorlds, world.id) and not owned(data.unlockedWorlds, world.id) then
			table.insert(data.unlockedWorlds, world.id)
		end
	end
	local seen = {}
	if type(raw.brainrots) == "table" then
		for _, saved in raw.brainrots do
			if #data.brainrots >= Config.MaxBrainrots then break end
			if type(saved) == "table" and lookup(Config.Creatures, saved.specId) then
				local uid = type(saved.uid) == "string" and #saved.uid > 0 and #saved.uid <= 64 and saved.uid or HttpService:GenerateGUID(false)
				if not seen[uid] then
					seen[uid] = true
					local level = integer(saved.level, 1, Config.MaxLevel, 1)
					table.insert(data.brainrots, {
						uid = uid, specId = saved.specId, level = level,
						xp = level < Config.MaxLevel and integer(saved.xp, 0, Config.xpNeeded(level) - 1, 0) or 0,
						growthBoostUntil = integer(saved.growthBoostUntil, 0, os.time() + Config.Boosts.Growth.duration, 0),
						incomeBoostUntil = integer(saved.incomeBoostUntil, 0, os.time() + Config.Boosts.Income.duration, 0),
					})
				end
			end
		end
	end
	-- Discovery history is independent of the currently owned collection. Old
	-- saves seed the new book from owned species; past sales cannot be inferred.
	for _, spec in Config.Creatures do
		if type(raw.discovered) == "table" and raw.discovered[spec.id] == true then data.discovered[spec.id] = true end
	end
	for _, brainrot in data.brainrots do data.discovered[brainrot.specId] = true end
	if type(raw.gardenSlots) == "table" then
		local placed = {}
		for slot = 1, Config.GardenSlots do
			local uid = raw.gardenSlots[slot]
			if type(uid) == "string" and seen[uid] and not placed[uid] then
				data.gardenSlots[slot] = uid
				placed[uid] = true
			end
		end
	else
		-- A first visit after this update starts with an inviting display.
		for slot = 1, math.min(Config.GardenSlots, #data.brainrots) do data.gardenSlots[slot] = data.brainrots[slot].uid end
	end
	if seen[raw.activeBrainrot] then data.activeBrainrot = raw.activeBrainrot end
	if not data.activeBrainrot and data.brainrots[1] then data.activeBrainrot = data.brainrots[1].uid end
	return data
end

local function findBrainrot(profile, uid)
	if type(uid) ~= "string" then return nil end
	for index, brainrot in profile.data.brainrots do
		if brainrot.uid == uid then return brainrot, index end
	end
	return nil
end

local function brainrotIncome(brainrot)
	local boost = brainrot.incomeBoostUntil > os.time() and 2 or 1
	return Config.income(brainrot.specId, brainrot.level) * boost
end

local function totalIncome(profile)
	local total = 0
	for _, brainrot in profile.data.brainrots do total += brainrotIncome(brainrot) end
	return total
end

-- Same rotation for every server at the same five-minute UTC boundary. Quantities are per player.
local function refreshRotation()
	local epoch = math.floor(os.time() / Config.RotationSeconds)
	if epoch ~= cachedEpoch then
		cachedEpoch = epoch
		local random = Random.new(epoch)
		local candidates = {}
		for index = 2, #Config.Foods do table.insert(candidates, Config.Foods[index]) end
		for index = #candidates, 2, -1 do
			local other = random:NextInteger(1, index)
			candidates[index], candidates[other] = candidates[other], candidates[index]
		end
		rotation = { Config.Foods[1] }
		for index = 1, math.min(5, #candidates) do table.insert(rotation, candidates[index]) end
	end
	return epoch
end

local function ensureStock(profile)
	local epoch = refreshRotation()
	if profile.stockEpoch ~= epoch then
		profile.stockEpoch = epoch
		profile.purchased = {}
	end
end

local function publicState(profile)
	ensureStock(profile)
	local brainrots = {}
	for _, brainrot in profile.data.brainrots do
		local spec = lookup(Config.Creatures, brainrot.specId)
		table.insert(brainrots, {
			uid = brainrot.uid, specId = brainrot.specId, name = spec.name, rarity = spec.rarity,
			level = brainrot.level, xp = brainrot.xp, xpNeeded = Config.xpNeeded(brainrot.level),
			income = brainrotIncome(brainrot), growthBoostUntil = brainrot.growthBoostUntil,
			incomeBoostUntil = brainrot.incomeBoostUntil,
		})
	end
	local discoveredIds = {}
	for _, spec in Config.Creatures do
		if profile.data.discovered[spec.id] then table.insert(discoveredIds, spec.id) end
	end
	local stock = {}
	for _, food in rotation do
		table.insert(stock, { id = food.id, remaining = math.max(0, food.stock - (profile.purchased[food.id] or 0)) })
	end
	return {
		coins = math.floor(profile.data.coins), income = totalIncome(profile), world = profile.world,
		detector = profile.data.detector, ownedDetectors = table.clone(profile.data.ownedDetectors),
		unlockedWorlds = table.clone(profile.data.unlockedWorlds), activeBrainrot = profile.data.activeBrainrot,
		brainrots = brainrots, foods = table.clone(profile.data.foods), stock = stock,
		rotationEnds = (cachedEpoch + 1) * Config.RotationSeconds, discoveryCount = profile.data.discoveryCount,
		serverTime = os.time(), persistenceEnabled = profile.persistent,
		discoveredIds = discoveredIds, uniqueDiscovered = #discoveredIds,
		garden = {id = gardens:getPlotId(profile.player), slots = table.clone(profile.data.gardenSlots), capacity = Config.GardenSlots},
	}
end

local function push(player, profile)
	if player.Parent == Players then State:FireClient(player, publicState(profile)) end
end

local function updateCompanion(profile)
	if profile.companion then profile.companion:Destroy(); profile.companion = nil end
	local brainrot = findBrainrot(profile, profile.data.activeBrainrot)
	if not brainrot then return end
	local spec = lookup(Config.Creatures, brainrot.specId)
	local model = CreatureFactory.create(spec, 0.7 + (brainrot.level - 1) * 0.015)
	model.Name = profile.player.Name .. "'s " .. spec.name
	model.Parent = workspace
	local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if primary then
		model.PrimaryPart = primary
		local label = Instance.new("BillboardGui")
		label.Name = "CompanionLabel"
		label.Size = UDim2.fromOffset(164, 38)
		label.StudsOffset = Vector3.new(0, 5.3 * (0.7 + (brainrot.level - 1) * 0.015), 0)
		label.MaxDistance = 28
		label.Parent = primary
		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.BuilderSansMedium
		text.TextSize = 12
		text.TextColor3 = Color3.new(1, 1, 1)
		text.TextStrokeTransparency = 0.3
		text.Text = string.format("%s  •  Lv.%d\n$%s / sec", spec.name, brainrot.level, tostring(brainrotIncome(brainrot)))
		text.Parent = label
	end
	profile.companion = model
end

local function snapshot(profile)
	local copy = {
		coins = math.floor(profile.data.coins), discoveryCount = profile.data.discoveryCount,
		foods = table.clone(profile.data.foods), detector = profile.data.detector,
		ownedDetectors = table.clone(profile.data.ownedDetectors), unlockedWorlds = table.clone(profile.data.unlockedWorlds),
		activeBrainrot = profile.data.activeBrainrot, brainrots = {},
		discovered = table.clone(profile.data.discovered), gardenSlots = table.clone(profile.data.gardenSlots),
	}
	for _, brainrot in profile.data.brainrots do table.insert(copy.brainrots, table.clone(brainrot)) end
	return copy
end

local function save(profile, release)
	if not profile.persistent then return true end
	local userId = profile.player.UserId
	-- A removal waits for an autosave so the final snapshot cannot be skipped.
	if savesInFlight[userId] then
		if not release then return false end
		local deadline = os.clock() + 12
		repeat task.wait(0.1) until not savesInFlight[userId] or os.clock() >= deadline
		if savesInFlight[userId] then return false end
	end
	savesInFlight[userId] = true
	local data = snapshot(profile)
	local ok, result = pcall(function()
		return store:UpdateAsync("Player_" .. userId, function(previous)
			if type(previous) ~= "table" or type(previous.session) ~= "table" or previous.session.id ~= sessionId then
				return nil -- Never overwrite a profile whose session lock we no longer own.
			end
			return { schema = 1, data = data, session = not release and { id = sessionId, expires = os.time() + LOCK_SECONDS } or nil }
		end)
	end)
	savesInFlight[userId] = nil
	if not ok then
		warn("[Brainrot Bloom] Save failed for user " .. userId .. ": " .. tostring(result))
		return false
	end
	if not result then
		profile.persistent = false
		if profile.player.Parent == Players then profile.player:Kick("Your save session moved to another server. Please rejoin to protect your collection.") end
		return false
	end
	return true
end


-- The guard covers the entire final-save sequence, including retry backoff.
-- savesInFlight alone only protects an individual DataStore request.
local function saveOnDeparture(profile, releaseTicket)
	local userId = profile.player.UserId
	local ticket = releaseTicket or {}
	releasingUsers[userId] = ticket
	for attempt = 1, 3 do
		if save(profile, true) then break end
		if attempt < 3 then task.wait(attempt) end
	end
	if releasingUsers[userId] == ticket then releasingUsers[userId] = nil end
end

local function acquire(player)
	local finalError
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return store:UpdateAsync("Player_" .. player.UserId, function(previous)
				if type(previous) == "table" and type(previous.session) == "table"
					and previous.session.id ~= sessionId and (tonumber(previous.session.expires) or 0) > os.time() then
					return nil
				end
				local data = type(previous) == "table" and previous.data or nil
				return { schema = 1, data = sanitize(data), session = { id = sessionId, expires = os.time() + LOCK_SECONDS } }
			end)
		end)
		if ok then
			if type(result) == "table" and type(result.session) == "table" and result.session.id == sessionId then
				return sanitize(result.data), true
			end
			return nil, false, "Your collection is still open on another server. Wait a moment and rejoin."
		end
		finalError = result
		if attempt < 3 then task.wait(attempt) end
	end
	warn("[Brainrot Bloom] DataStore unavailable: " .. tostring(finalError))
	if RunService:IsStudio() then
		warn("[Brainrot Bloom] Studio uses temporary progress until the experience is published and API Services are enabled. No failed load will be saved.")
		return newData(), false
	end
	return nil, false, "Your collection could not be loaded safely. Please rejoin in a moment."
end

local function rootFor(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return nil end
	return character:FindFirstChild("HumanoidRootPart")
end

local function pitForPosition(position)
	for id, pit in map.pits do
		local relative = position - pit.center
		if math.abs(relative.X) <= pit.size.X / 2 and math.abs(relative.Z) <= pit.size.Z / 2 and math.abs(relative.Y) < 35 then
			return lookup(Config.Worlds, id)
		end
	end
	return nil
end

local function teleport(player, profile, destination)
	local frame = destination == "Garden" and gardens:getSpawnCFrame(player) or type(destination) == "string" and map.destinations[destination]
	if not frame then return false, "That destination does not exist." end
	local world = lookup(Config.Worlds, destination)
	if world and not owned(profile.data.unlockedWorlds, world.id) then return false, "Unlock this world at a World portal first." end
	local root = rootFor(player)
	if not root then return false, "Wait for your character to spawn." end
	profile.scan = nil
	profile.dig = nil
	player.Character:PivotTo(frame)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	profile.world = world and world.id or Config.Worlds[1].id
	return true
end

local function charge(profile, cost)
	if profile.data.coins < cost then return false end
	profile.data.coins -= cost
	return true
end

local function fail(message)
	return { ok = false, message = message }
end

local function rollCreature(world, detector)
	local choices = {}
	local total = 0
	local ceiling = math.min(world.maxRarity, detector.power)
	for index, rarity in Config.Rarities do
		if index <= ceiling then
			local species = {}
			for _, spec in Config.Creatures do
				if spec.rarity == rarity.id then table.insert(species, spec) end
			end
			if #species > 0 then
				local weight = rarity.weight * (1 + math.max(0, detector.power - 1) * (index - 1) * 0.25)
				total += weight
				table.insert(choices, { rarity = rarity, species = species, threshold = total })
			end
		end
	end
	local roll = rng:NextNumber(0, total)
	for _, choice in choices do
		if roll <= choice.threshold then return choice.species[rng:NextInteger(1, #choice.species)], choice.rarity end
	end
	error("No valid creature roll; check world and rarity configuration")
end

local handlers = {}

function handlers.GetState(_player, _profile, _payload)
	return { ok = true }
end

function handlers.Teleport(player, profile, payload)
	local ok, message = teleport(player, profile, payload.destination)
	return { ok = ok, message = message }
end

function handlers.EquipDetector(_player, profile, payload)
	if profile.scan then return fail("Wait for your current search to finish.") end
	if not lookup(Config.Detectors, payload.id) or not owned(profile.data.ownedDetectors, payload.id) then return fail("You do not own that detector.") end
	if profile.dig and profile.dig.deadline > os.clock() then return fail("Finish your current capture first.") end
	profile.data.detector = payload.id
	DetectorTool.equip(profile.player, lookup(Config.Detectors, payload.id))
	return { ok = true, message = "Detector equipped." }
end

function handlers.BuyDetector(_player, profile, payload)
	if profile.scan then return fail("Wait for your current search to finish.") end
	local spec = lookup(Config.Detectors, payload.id)
	if not spec then return fail("Unknown detector.") end
	if profile.dig and profile.dig.deadline > os.clock() then return fail("Finish your current capture first.") end
	if owned(profile.data.ownedDetectors, spec.id) then return fail("You already own this detector.") end
	if not owned(profile.data.unlockedWorlds, spec.world) then return fail("Unlock " .. spec.world .. " before buying this detector.") end
	if not charge(profile, spec.price) then return fail("You need more coins for this detector.") end
	table.insert(profile.data.ownedDetectors, spec.id)
	profile.data.detector = spec.id
	DetectorTool.equip(profile.player, spec)
	return { ok = true, message = spec.name .. " purchased and equipped!" }
end

function handlers.BuyFood(_player, profile, payload)
	ensureStock(profile)
	local food = lookup(Config.Foods, payload.id)
	if not food then return fail("Unknown food.") end
	if not table.find(rotation, food) then return fail("This food is not in the current rotation.") end
	local quantity = integer(payload.quantity, 1, 100, 1)
	local remaining = food.stock - (profile.purchased[food.id] or 0)
	if quantity > remaining then return fail("There is not enough stock left in this rotation.") end
	if (profile.data.foods[food.id] or 0) + quantity > 9999 then return fail("Your pantry is full of this food.") end
	if not charge(profile, food.price * quantity) then return fail("You need more coins for this food.") end
	profile.data.foods[food.id] = (profile.data.foods[food.id] or 0) + quantity
	profile.purchased[food.id] = (profile.purchased[food.id] or 0) + quantity
	return { ok = true, message = "Bought " .. quantity .. " × " .. food.name .. "." }
end

function handlers.Feed(_player, profile, payload)
	local brainrot = findBrainrot(profile, payload.uid)
	local food = lookup(Config.Foods, payload.foodId)
	if not brainrot or not food then return fail("Choose a brainrot and food from your inventory.") end
	if brainrot.level >= Config.MaxLevel then return fail("This brainrot has reached the maximum level.") end
	local quantity = integer(payload.quantity, 1, 100, 1)
	if quantity > (profile.data.foods[food.id] or 0) then return fail("You do not have enough of this food.") end
	profile.data.foods[food.id] -= quantity
	local previousLevel = brainrot.level
	brainrot.xp += food.xp * quantity * (brainrot.growthBoostUntil > os.time() and 2 or 1)
	while brainrot.level < Config.MaxLevel and brainrot.xp >= Config.xpNeeded(brainrot.level) do
		brainrot.xp -= Config.xpNeeded(brainrot.level)
		brainrot.level += 1
	end
	if brainrot.level == Config.MaxLevel then brainrot.xp = 0 end
	if profile.data.activeBrainrot == brainrot.uid then updateCompanion(profile) end
	gardens:sync(profile.player, profile.data.brainrots, profile.data.gardenSlots)
	local gained = brainrot.level - previousLevel
	return { ok = true, message = gained > 0 and ("Grew " .. gained .. " level" .. (gained == 1 and "!" or "s!")) or "Yum! Growth XP added." }
end

function handlers.EquipBrainrot(_player, profile, payload)
	if not findBrainrot(profile, payload.uid) then return fail("You do not own that brainrot.") end
	profile.data.activeBrainrot = payload.uid
	updateCompanion(profile)
	return { ok = true, message = "Your companion is ready. All collected brainrots still earn income!" }
end

function handlers.Sell(_player, profile, payload)
	local brainrot, index = findBrainrot(profile, payload.uid)
	if not brainrot then return fail("Choose a brainrot to sell.") end
	local value = Config.sellValue(brainrot.specId, brainrot.level)
	table.remove(profile.data.brainrots, index)
	profile.data.coins = math.min(MAX_COINS, profile.data.coins + value)
	for slot = 1, Config.GardenSlots do
		if profile.data.gardenSlots[slot] == brainrot.uid then profile.data.gardenSlots[slot] = "" end
	end
	gardens:sync(profile.player, profile.data.brainrots, profile.data.gardenSlots)
	if profile.data.activeBrainrot == brainrot.uid then
		profile.data.activeBrainrot = profile.data.brainrots[1] and profile.data.brainrots[1].uid or nil
		updateCompanion(profile)
	end
	return { ok = true, message = "Brainrot sold for $" .. tostring(value) .. "." }
end

-- Garden actions refer only to the caller's reserved plot. Clients cannot
-- choose an owner/garden id or move creatures they do not own.
local function gardenSlot(value)
	if type(value) ~= "number" or value ~= value or value % 1 ~= 0 or value < 1 or value > Config.GardenSlots then return nil end
	return value
end

function handlers.GardenAssign(player, profile, payload)
	local slot = gardenSlot(payload.slot)
	if not slot then return fail("Choose a garden slot from 1 to " .. Config.GardenSlots .. ".") end
	if not findBrainrot(profile, payload.uid) then return fail("Choose a brainrot you own to display in your garden.") end
	for previous = 1, Config.GardenSlots do
		if profile.data.gardenSlots[previous] == payload.uid then profile.data.gardenSlots[previous] = "" end
	end
	profile.data.gardenSlots[slot] = payload.uid
	gardens:sync(player, profile.data.brainrots, profile.data.gardenSlots)
	return {ok = true, message = "Brainrot placed in garden slot " .. slot .. "."}
end

function handlers.GardenClear(player, profile, payload)
	local slot = gardenSlot(payload.slot)
	if not slot then return fail("Choose a valid garden slot.") end
	profile.data.gardenSlots[slot] = ""
	gardens:sync(player, profile.data.brainrots, profile.data.gardenSlots)
	return {ok = true, message = "Garden display cleared. Your brainrot stays in your collection."}
end

function handlers.BuyBoost(_player, profile, payload)
	if payload.kind ~= "Growth" and payload.kind ~= "Income" then return fail("Choose a growth or income boost.") end
	local brainrot = findBrainrot(profile, payload.uid)
	local boost = Config.Boosts[payload.kind]
	if not brainrot then return fail("Choose the brainrot you want to boost.") end
	local field = payload.kind == "Growth" and "growthBoostUntil" or "incomeBoostUntil"
	if brainrot[field] > os.time() then return fail("This boost is already active. Wait for it to finish.") end
	if payload.kind == "Growth" and brainrot.level >= Config.MaxLevel then return fail("This brainrot is already at maximum level.") end
	if not charge(profile, boost.price) then return fail("You need more coins for this boost.") end
	brainrot[field] = os.time() + boost.duration
	if profile.data.activeBrainrot == brainrot.uid then updateCompanion(profile) end
	return { ok = true, message = "2× " .. string.lower(payload.kind) .. " active for five minutes!" }
end

function handlers.UnlockWorld(player, profile, payload)
	local world = lookup(Config.Worlds, payload.id)
	if not world then return fail("Unknown world.") end
	if owned(profile.data.unlockedWorlds, world.id) then return fail("You have already unlocked this world.") end
	local index = table.find(Config.Worlds, world)
	if index > 1 and not owned(profile.data.unlockedWorlds, Config.Worlds[index - 1].id) then return fail("Unlock the previous world first.") end
	if not charge(profile, world.unlockCost) then return fail("You need more coins to unlock " .. world.name .. ".") end
	table.insert(profile.data.unlockedWorlds, world.id)
	teleport(player, profile, world.id)
	return { ok = true, message = world.name .. " unlocked! New detectors are available in the gear shop." }
end

function handlers.StartDig(player, profile, _payload)
	local root = rootFor(player)
	if not root then return fail("Wait for your character to spawn.") end
	local world = pitForPosition(root.Position)
	if not world then return fail("Stand inside a sand pit to search for brainrots.") end
	if not owned(profile.data.unlockedWorlds, world.id) then return fail("Unlock this world before digging here.") end
	local detector = lookup(Config.Detectors, profile.data.detector)
	if detector.power < world.minPower then return fail("This pit needs a stronger detector. Visit the gear shop.") end
	if #profile.data.brainrots >= Config.MaxBrainrots then return fail("Your collection is full. Sell a brainrot first.") end
	if profile.scan then return fail("Your detector is already searching. Give it a moment.") end
	if profile.dig and os.clock() < profile.dig.deadline then return fail("A capture is already in progress.") end
	if os.clock() < profile.nextDig then return fail(string.format("Detector recharging… %.1fs", profile.nextDig - os.clock())) end

	-- Reserve the search before yielding. Neither repeated clicks nor canceling
	-- a scan can skip the wait, run parallel rolls, or refund the cooldown.
	local scan = {character = player.Character, root = root, world = world.id, detector = detector.id}
	profile.scan = scan
	profile.dig = nil
	profile.world = world.id
	profile.nextDig = os.clock() + Config.SearchSeconds + detector.speed
	task.wait(Config.SearchSeconds)

	-- Teleporting, respawning and leaving invalidate the original scan. Never
	-- clear another search's token when this delayed request resumes.
	if profile.scan ~= scan then return fail("Search canceled. Try again from the sand pit.") end
	profile.scan = nil
	if closing or profiles[player] ~= profile or player.Parent ~= Players then return fail("Search canceled.") end
	local currentRoot = rootFor(player)
	local currentWorld = currentRoot and pitForPosition(currentRoot.Position)
	if player.Character ~= scan.character or currentRoot ~= scan.root or not currentWorld or currentWorld.id ~= scan.world then
		return fail("Stay in the sand pit while your detector searches.")
	end
	if profile.data.detector ~= scan.detector or not owned(profile.data.unlockedWorlds, scan.world) then
		return fail("Your equipment or world changed. Start a new search.")
	end
	if #profile.data.brainrots >= Config.MaxBrainrots then return fail("Your collection is full. Sell a brainrot first.") end
	if rng:NextNumber(0, 1) >= Config.FindChance then
		return {ok = true, found = false, message = "No signal this time. Try another spot in the sand."}
	end

	local spec, rarity = rollCreature(world, detector)
	local duration = Config.DigDuration
	profile.dig = {
		id = HttpService:GenerateGUID(false), specId = spec.id, required = rarity.taps,
		count = 0, deadline = os.clock() + duration, lastTap = 0, world = world.id,
	}
	return { ok = true, found = true, dig = { id = profile.dig.id, required = rarity.taps, duration = duration, specId = spec.id, rarity = rarity.id, name = spec.name } }
end

function handlers.TapDig(player, profile, payload)
	local dig = profile.dig
	if not dig or payload.sessionId ~= dig.id then return fail("No active capture. Search the sand again.") end
	if os.clock() > dig.deadline then profile.dig = nil; return fail("It escaped! Try digging again.") end
	local root = rootFor(player)
	local currentWorld = root and pitForPosition(root.Position)
	if not currentWorld or currentWorld.id ~= dig.world then profile.dig = nil; return fail("Stay in the sand pit during a capture.") end
	if os.clock() - dig.lastTap < 0.045 then return { ok = true, count = dig.count, taps = dig.count } end
	dig.lastTap = os.clock()
	dig.count += 1
	if dig.count < dig.required then return { ok = true, count = dig.count, taps = dig.count } end
	profile.dig = nil -- Clear the session before awarding; replayed requests cannot grant another creature.
	if #profile.data.brainrots >= Config.MaxBrainrots then return fail("Your collection is full.") end
	local brainrot = { uid = HttpService:GenerateGUID(false), specId = dig.specId, level = 1, xp = 0, growthBoostUntil = 0, incomeBoostUntil = 0 }
	table.insert(profile.data.brainrots, brainrot)
	profile.data.discoveryCount += 1
	profile.data.discovered[brainrot.specId] = true
	for slot = 1, Config.GardenSlots do
		if profile.data.gardenSlots[slot] == "" then profile.data.gardenSlots[slot] = brainrot.uid; break end
	end
	gardens:sync(player, profile.data.brainrots, profile.data.gardenSlots)
	if not profile.data.activeBrainrot then profile.data.activeBrainrot = brainrot.uid; updateCompanion(profile) end
	local spec = lookup(Config.Creatures, brainrot.specId)
	return { ok = true, complete = true, message = "Captured " .. spec.name .. "! It now earns coins every second." }
end

Action.OnServerInvoke = function(player, action, payload)
	local profile = profiles[player]
	if not profile then return fail("Your collection is loading. Try again in a moment.") end
	if closing then return fail("The server is closing. Your collection is being saved.") end
	if type(action) ~= "string" or not handlers[action] then return fail("Unknown action.") end
	if payload ~= nil and type(payload) ~= "table" then return fail("Invalid request.") end
	-- Token bucket permits rapid capture taps while bounding every other action.
	local now = os.clock()
	profile.tokens = math.min(45, profile.tokens + (now - profile.tokenAt) * 28)
	profile.tokenAt = now
	local cost = action == "TapDig" and 1 or 4
	if profile.tokens < cost then return fail("Please slow down for a moment.") end
	profile.tokens -= cost
	local ok, result = pcall(handlers[action], player, profile, payload or {})
	if not ok then
		warn("[Brainrot Bloom] Action " .. action .. " failed: " .. tostring(result))
		return fail("That action could not finish. Please try again.")
	end
	-- A state snapshot accompanies meaningful actions; individual taps only return progress.
	if action ~= "TapDig" or result.complete then
		result.state = publicState(profile)
		push(player, profile)
	end
	return result
end

local function onPlayerAdded(player)
	if profiles[player] or joining[player] then return end
	if player.Parent ~= Players or closing then return end
	if joiningUsers[player.UserId] or releasingUsers[player.UserId] or savesInFlight[player.UserId] then
		player:Kick("Your collection is still loading or saving. Please rejoin in a moment.")
		return
	end
	-- Reserve a real plot before the potentially yielding DataStore load. A
	-- seventh player never starts a profile session or displaces another garden.
	local gardenId = gardens:claim(player)
	if not gardenId then
		player:Kick("This server's six gardens are occupied. Please join another server.")
		return
	end
	local ticket = {}
	joining[player] = ticket
	joiningUsers[player.UserId] = ticket
	local data, persistent, message = acquire(player)
	local profile = data and {
		player = player, data = data, persistent = persistent, world = Config.Worlds[1].id,
		gardenId = gardenId, nextDig = 0, tokens = 45, tokenAt = os.clock(), stockEpoch = -1, purchased = {},
	} or nil
	if joining[player] ~= ticket or player.Parent ~= Players or closing then
		if joining[player] == ticket then joining[player] = nil; gardens:release(player) end
		if profile then saveOnDeparture(profile) end
		if joiningUsers[player.UserId] == ticket then joiningUsers[player.UserId] = nil end
		return
	end
	joining[player] = nil
	joiningUsers[player.UserId] = nil
	if not profile then
		gardens:release(player)
		player:Kick(message)
		return
	end
	profiles[player] = profile
	gardens:sync(player, data.brainrots, data.gardenSlots)
	local function spawnCharacter(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and profiles[player] == profile and player.Character == character then
			character:PivotTo(gardens:getSpawnCFrame(player) or map.spawnCFrame)
			profile.world = Config.Worlds[1].id
			profile.scan = nil
			profile.dig = nil
			DetectorTool.equip(player, lookup(Config.Detectors, profile.data.detector))
			updateCompanion(profile)
			push(player, profile)
		end
	end
	player.CharacterAdded:Connect(spawnCharacter)
	if player.Character then task.spawn(spawnCharacter, player.Character) end
	push(player, profile)
	if not persistent then
		task.delay(5, function()
			if player.Parent == Players then Notify:FireClient(player, "Studio session: progress is temporary. Publish and enable API Services to test saving.", "warning") end
		end)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do task.spawn(onPlayerAdded, player) end
Players.PlayerRemoving:Connect(function(player)
	local profile = profiles[player]
	local releaseTicket = profile and {} or nil
	-- Set this before cleanup or any possible yield. Rejected rejoin attempts
	-- have no profile, so their removal cannot clear the original player's guard.
	if releaseTicket then releasingUsers[player.UserId] = releaseTicket end
	joining[player] = nil
	gardens:release(player)
	profiles[player] = nil
	if profile then
		profile.scan = nil
		if profile.companion then profile.companion:Destroy() end
		saveOnDeparture(profile, releaseTicket)
	end
end)

-- Map ProximityPrompt UI is handled by the client; all resulting actions still pass these server checks.
task.spawn(function()
	local elapsed = 0
	while not closing do
		task.wait(1)
		elapsed += 1
		for player, profile in profiles do
			profile.data.coins = math.min(MAX_COINS, profile.data.coins + totalIncome(profile))
			if profile.dig and os.clock() > profile.dig.deadline then profile.dig = nil end
			if elapsed % 2 == 0 then push(player, profile) end
			if elapsed % 60 == 0 then task.spawn(save, profile, false) end
			if elapsed % 5 == 0 and profile.companion then
				local brainrot = findBrainrot(profile, profile.data.activeBrainrot)
				local primary = profile.companion.PrimaryPart
				local label = primary and primary:FindFirstChild("CompanionLabel")
				local text = label and label:FindFirstChild("Text")
				if brainrot and text then
					local spec = lookup(Config.Creatures, brainrot.specId)
					text.Text = string.format("%s  •  Lv.%d\n$%s / sec", spec.name, brainrot.level, tostring(brainrotIncome(brainrot)))
				end
			end
		end
	end
end)

local companionTime = 0
RunService.Heartbeat:Connect(function(delta)
	companionTime += delta
	if companionTime < 0.1 then return end
	companionTime = 0
	for player, profile in profiles do
		local root = rootFor(player)
		if root and profile.companion and profile.companion.PrimaryPart then
			local target = root.CFrame * CFrame.new(3.8, -1 + math.sin(os.clock() * 3) * 0.2, 2.5)
			profile.companion:PivotTo(target)
		end
	end
end)

game:BindToClose(function()
	closing = true
	local remaining = 0
	for _, profile in profiles do
		remaining += 1
		task.spawn(function()
			for attempt = 1, 3 do
				if save(profile, true) then break end
				if attempt < 3 then task.wait(attempt) end
			end
			remaining -= 1
		end)
	end
	local deadline = os.clock() + 25
	while remaining > 0 and os.clock() < deadline do task.wait(0.1) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">PortalFactory</string>
          <string name="Source"><![CDATA[-- Original stone travel gates. Static geometry remains visible in edit mode;
-- PortalEffects animates only the marked decorative pieces on each client.
local PortalFactory = {}
local V = Vector3.new
local rgb = Color3.fromRGB

function PortalFactory.create(parent, entrance, worldId, tint)
	local gate=Instance.new("Folder")
	gate.Name="WorldTravelPortal"
	gate:SetAttribute("PortalVFX",true)
	gate:SetAttribute("WorldId",worldId)
	local center=entrance+V(0,12,0)
	local stone=rgb(151,167,158)
	local pale=rgb(228,239,218)
	local glow=tint:Lerp(rgb(112,235,219),0.6)
	local function piece(name,size,position,color,material,rotation,collide,shape)
		local p=Instance.new("Part")
		p.Name=name; p.Size=size; p.Position=position
		p.Color=color; p.Material=material or Enum.Material.SmoothPlastic
		p.Anchored=true; p.CanCollide=collide==true; p.CanTouch=false; p.CanQuery=false
		p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
		if shape then p.Shape=shape end
		p.CFrame=CFrame.new(position)*(rotation or CFrame.new())
		p.Parent=gate
		return p
	end
	local function animate(p,speed,pulse)
		p:SetAttribute("PortalCenter",center)
		p:SetAttribute("PortalBase",p.CFrame)
		p:SetAttribute("PortalSpin",speed)
		p:SetAttribute("PortalPulse",pulse or 0)
		p:SetAttribute("PortalAlpha",p.Transparency)
	end
	local function segment(name,a,b,width,color,speed)
		local delta=b-a
		local length=delta.Magnitude
		local up=math.abs(delta.Y/length)>0.98 and V(0,0,1) or V(0,1,0)
		local p=piece(name,V(width,width,length+0.08),(a+b)*0.5,color,Enum.Material.Neon,CFrame.lookAt(Vector3.zero,delta,up))
		p.Transparency=0.2
		animate(p,speed,0.055)
		return p
	end
	piece("PortalCourt",V(44,0.3,32),entrance+V(0,0.45,0),stone,Enum.Material.Cobblestone,nil,true)
	piece("CourtInlay",V(38,0.045,26),entrance+V(0,0.625,0),rgb(102,131,126),Enum.Material.Slate)
	for _,side in {-1,1} do
		piece("GateButtress",V(3.5,16,4.6),entrance+V(side*14,8,0),stone,Enum.Material.Slate,nil,true)
		piece("ButtressFoot",V(5.2,1.0,6),entrance+V(side*14,0.8,0),pale,Enum.Material.Marble,nil,true)
		local crystal=piece("PortalBeaconCrystal",V(2,4.6,2),entrance+V(side*14,18,0),glow,Enum.Material.Neon,CFrame.Angles(0,math.pi/4,0))
		crystal.Transparency=0.2
		local light=Instance.new("PointLight"); light.Color=glow;light.Range=35;light.Brightness=0.9;light.Parent=crystal
		for _,face in {-1,1} do piece("ButtressRune",V(0.45,8,0.08),entrance+V(side*14,9,face*2.34),glow,Enum.Material.Neon) end
	end
	for j=0,19 do
		local angle=j*math.pi/10
		local pos=center+V(math.sin(angle)*10.8,math.cos(angle)*10.8,0)
		piece("ArchStone",V(3.45,1.6,2.3),pos,stone:Lerp(pale,(j%3)*0.055),Enum.Material.Slate,CFrame.Angles(0,0,-angle))
		if j%2==0 then
			for _,face in {-1,1} do piece("RingRune",V(0.48,0.85,0.08),pos+V(0,0,face*1.2),glow,Enum.Material.Neon,CFrame.Angles(0,0,-angle)) end
		end
	end
	-- Three spiral arms form a complete vortex rather than a rotating flat disc.
	for arm=0,2 do
		for j=1,12 do
			local function at(t)
				local radius=0.9+7.25*t
				local angle=arm*math.pi*2/3+t*math.pi*1.55
				return center+V(math.cos(angle)*radius,math.sin(angle)*radius,0)
			end
			segment("SwirlingRibbon",at((j-1)/12),at(j/12),0.25+j*0.018,arm==1 and pale or glow,0.62)
		end
	end
	for j=1,6 do
		local a=j*math.pi/3
		local mote=piece("OrbitingSpark",V(0.52,0.52,0.52),center+V(math.cos(a)*8.8,math.sin(a)*8.8,0.55),pale,Enum.Material.Neon,nil,false,Enum.PartType.Ball)
		mote.Transparency=0.22
		animate(mote,-0.43,0.08)
	end
	local core=piece("VortexHeart",V(1.6,1.6,0.7),center,glow,Enum.Material.Neon,nil,false,Enum.PartType.Ball)
	core.Transparency=0.18
	animate(core,0,0.09)
	local veil=piece("PortalVeil",V(18,18,0.1),center,glow,Enum.Material.Glass,nil,false,Enum.PartType.Ball)
	veil.Transparency=0.94
	local target=piece("WorldPortal",V(2,2,1),entrance+V(0,4.5,0),glow)
	target.Transparency=1
	target:SetAttribute("WorldId",worldId)
	local prompt=Instance.new("ProximityPrompt")
	prompt.ActionText="Choose a world";prompt.ObjectText="World portal"
	prompt.KeyboardKeyCode=Enum.KeyCode.F;prompt.HoldDuration=0;prompt.MaxActivationDistance=18;prompt.RequiresLineOfSight=false
	prompt:SetAttribute("WorldTravel",true);prompt.Parent=target
	local board=piece("PortalHeader",V(29,3.6,0.6),entrance+V(0,26,0),rgb(37,68,61),Enum.Material.Wood)
	for _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do
		local gui=Instance.new("SurfaceGui");gui.Name="PortalWayfinding";gui.Face=face;gui.CanvasSize=Vector2.new(720,100)
		gui.LightInfluence=0.15;gui.MaxDistance=160;gui.Parent=board
		local title=Instance.new("TextLabel")
		title.Size=UDim2.fromScale(1,0.6);title.BackgroundTransparency=1;title.Font=Enum.Font.BuilderSansBold;title.TextSize=36
		title.TextColor3=pale;title.Text="WORLD PORTAL";title.Parent=gui
		local subtitle=title:Clone();subtitle.Position=UDim2.fromScale(0,0.6);subtitle.Size=UDim2.fromScale(1,0.4)
		subtitle.Font=Enum.Font.BuilderSans;subtitle.TextSize=20;subtitle.TextColor3=glow;subtitle.Text="F / tap  ·  Travel to another world";subtitle.Parent=gui
	end
	gate.Parent=parent
	return gate
end

return PortalFactory
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Sprint</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Fixed movement speeds are chosen by the server, never supplied by clients.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WALK_SPEED = 16
local SPRINT_SPEED = 26
local START_INTERVAL = 0.12
local states = {}
local remote = Instance.new("RemoteEvent")
remote.Name = "BrainrotSprint"
remote.Parent = ReplicatedStorage

local function stop(state)
	if state.humanoid then state.humanoid.WalkSpeed = WALK_SPEED end
	if state.character then state.character:SetAttribute("Sprinting", false) end
end

local function watchPlayer(player)
	if states[player] then return end
	local state = {lastStart = -math.huge}
	states[player] = state
	local function characterAdded(character)
		stop(state)
		if state.death then state.death:Disconnect(); state.death = nil end
		state.character, state.humanoid = character, nil
		state.lastStart = -math.huge
		character:SetAttribute("Sprinting", false)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") or states[player] ~= state or player.Character ~= character or state.character ~= character then return end
		state.humanoid = humanoid
		humanoid.WalkSpeed = WALK_SPEED
		state.death = humanoid.Died:Connect(function() stop(state) end)
	end
	player.CharacterAdded:Connect(characterAdded)
	player.CharacterRemoving:Connect(function(character)
		if state.character ~= character then return end
		stop(state)
		if state.death then state.death:Disconnect(); state.death = nil end
		state.character, state.humanoid = nil, nil
	end)
	if player.Character then task.spawn(characterAdded, player.Character) end
end

remote.OnServerEvent:Connect(function(player, enabled)
	if type(enabled) ~= "boolean" then return end
	local state = states[player]
	if not state or player.Parent ~= Players then return end
	-- Releases are always accepted, even directly after a start or during spam.
	if not enabled then stop(state); return end
	local character, humanoid = state.character, state.humanoid
	if player.Character ~= character or not character or not humanoid or humanoid.Health <= 0 or humanoid.Sit then return end
	local now = os.clock()
	if now - state.lastStart < START_INTERVAL then return end
	state.lastStart = now
	humanoid.WalkSpeed = SPRINT_SPEED
	character:SetAttribute("Sprinting", true)
end)

Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(function(player)
	local state = states[player]
	if not state then return end
	stop(state)
	if state.death then state.death:Disconnect() end
	states[player] = nil
end)
for _, player in Players:GetPlayers() do watchPlayer(player) end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">StationKeeper</string>
          <string name="Source"><![CDATA[-- Original, static shop attendants. These models only present existing shop
-- prompts; all purchases, trades and sales remain in the authoritative server.
local StationKeeper = {}
local V = Vector3.new
local A = CFrame.Angles
local rgb = Color3.fromRGB
local INK = rgb(43,55,50)
local IVORY = rgb(252,245,224)
local SKIN = rgb(218,168,123)
local HAIR = rgb(86,62,47)
local BRASS = rgb(201,162,88)
local ROLES = {
	Food = {name="Chef Pip",coat=rgb(238,226,198),accent=rgb(160,191,139),trousers=rgb(104,121,88),action="Browse food"},
	Gear = {name="Milo the Mechanic",coat=rgb(85,134,151),accent=rgb(220,173,98),trousers=rgb(67,88,94),action="Browse gear"},
	Sell = {name="Tessa the Trader",coat=rgb(134,112,154),accent=rgb(211,171,110),trousers=rgb(77,83,94),action="Review a sale"},
}

function StationKeeper.create(parent,frame,role)
	local spec=assert(ROLES[role],"Unknown station keeper role: "..tostring(role))
	local model=Instance.new("Model")
	model.Name="StationKeeper"
	model:SetAttribute("ShopRole",role)
	model:SetAttribute("KeeperName",spec.name)
	local function piece(name,size,position,color,material,shape,rotation)
		local object=Instance.new("Part")
		object.Name=name;object.Size=size
		object.CFrame=frame*CFrame.new(position)*(rotation or CFrame.new())
		object.Color=color;object.Material=material or Enum.Material.SmoothPlastic
		object.Anchored=true;object.CanCollide=false;object.CanTouch=false;object.CanQuery=false
		object.TopSurface=Enum.SurfaceType.Smooth;object.BottomSurface=Enum.SurfaceType.Smooth
		if shape then object.Shape=shape end
		object.Parent=model
		return object
	end
	local function orb(name,size,position,color,material,rotation)
		return piece(name,size,position,color,material,Enum.PartType.Ball,rotation)
	end
	local root=piece("Root",V(0.15,0.15,0.15),Vector3.zero,INK)
	root.Transparency=1;model.PrimaryPart=root
	piece("Torso",V(2.05,2.2,1.1),V(0,3.65,0),spec.coat,Enum.Material.Fabric)
	piece("CoatHem",V(2.09,0.18,1.13),V(0,2.64,0),spec.coat:Lerp(INK,0.12),Enum.Material.Fabric)
	piece("Neck",V(1.04,0.45,0.85),V(0,4.86,0),SKIN)
	piece("Head",V(1.9,1.85,1.65),V(0,5.67,0),SKIN)
	for _,side in {-1,1} do
		piece(side<0 and "LeftLeg" or "RightLeg",V(0.85,1.75,0.88),V(side*0.52,1.38,0),spec.trousers,Enum.Material.Fabric)
		piece("Boot",V(1.0,0.55,1.22),V(side*0.52,0.29,-0.17),INK)
		orb("BootToe",V(0.98,0.45,0.70),V(side*0.52,0.30,-0.59),INK)
		piece("BootSole",V(1.02,0.12,1.48),V(side*0.52,0.09,-0.21),rgb(67,69,59))
		piece(side<0 and "LeftArm" or "RightArm",V(0.72,1.85,0.86),V(side*1.42,3.66,0),spec.coat,Enum.Material.Fabric,nil,A(0,0,side*0.1))
		orb("SleeveShoulder",V(0.81,0.91,0.95),V(side*1.32,4.31,0.015),spec.coat,Enum.Material.Fabric)
		orb("Hand",V(0.74,0.72,0.78),V(side*1.52,2.54,-0.03),SKIN)
		orb("Thumb",V(0.29,0.42,0.35),V(side*1.23,2.49,-0.25),SKIN)
		piece("Cuff",V(0.76,0.25,0.9),V(side*1.5,2.99,0),spec.accent,Enum.Material.Fabric,nil,A(0,0,side*0.1))
		orb("Ear",V(0.3,0.55,0.5),V(side*0.99,5.64,0),SKIN)
		orb("InnerEar",V(0.09,0.30,0.27),V(side*1.115,5.64,-0.04),SKIN:Lerp(rgb(199,122,104),0.28))
		piece("ShirtCollar",V(0.47,0.48,0.12),V(side*0.28,4.54,-0.6),IVORY,Enum.Material.Fabric,nil,A(0,0,side*0.37))
		orb("EyeWhite",V(0.3,0.36,0.12),V(side*0.42,5.86,-0.85),IVORY)
		orb("EyeIris",V(0.215,0.275,0.07),V(side*0.42,5.85,-0.93),spec.coat:Lerp(INK,0.48))
		orb("EyePupil",V(0.115,0.20,0.07),V(side*0.42,5.85,-0.979),INK)
		orb("EyeGlint",V(0.052,0.062,0.04),V(side*0.42-0.036,5.92,-1.022),IVORY)
		piece("Eyebrow",V(0.35,0.08,0.08),V(side*0.42,6.15,-0.88),HAIR,nil,nil,A(0,0,side*-0.1))
		orb("Cheek",V(0.25,0.13,0.06),V(side*0.59,5.56,-0.85),rgb(234,147,126))
		piece("SmileCorner",V(0.16,0.055,0.065),V(side*0.12,5.32,-0.88),INK,nil,nil,A(0,0,side*0.35))
		piece("Sideburn",V(0.18,0.65,0.42),V(side*0.92,6.08,-0.13),HAIR,nil,nil,A(0,0,side*-0.06))
	end
	orb("Nose",V(0.22,0.24,0.19),V(0,5.62,-0.9),SKIN:Lerp(IVORY,0.13))
	piece("Smile",V(0.16,0.055,0.065),V(0,5.295,-0.88),INK)
	orb("HairCap",V(2.03,0.63,1.78),V(0,6.48,0.03),HAIR)
	for j=1,3 do orb("HairLock",V(0.65,0.31,0.32),V((j-2)*0.51,6.35,-0.76),HAIR,nil,A(0,0,(j-2)*0.15)) end
	if role=="Food" then
		piece("ChefApron",V(1.5,1.72,0.12),V(0,3.38,-0.62),spec.accent,Enum.Material.Fabric)
		piece("ApronPocket",V(0.85,0.46,0.08),V(0,3.11,-0.72),IVORY,Enum.Material.Fabric)
		piece("ApronWaistTie",V(2.12,0.15,1.14),V(0,3.56,0),IVORY,Enum.Material.Fabric)
		piece("ChefHatBand",V(1.99,0.36,1.76),V(0,6.69,0.02),IVORY,Enum.Material.Fabric)
		for j=1,3 do orb("ChefHatPuff",V(1.03,0.97,1.72),V((j-2)*0.59,7.19+(j==2 and 0.12 or 0),0.02),IVORY,Enum.Material.Fabric) end
		for j=1,3 do piece("ChefHatPleat",V(0.055,0.48,0.045),V((j-2)*0.59,7.23,-0.841),IVORY:Lerp(BRASS,0.13),Enum.Material.Fabric) end
	elseif role=="Gear" then
		piece("WorkshopCap",V(2.12,0.32,1.85),V(0,6.66,0.03),spec.coat,Enum.Material.Fabric)
		piece("CapVisor",V(2.08,0.13,0.75),V(0,6.52,-0.86),spec.accent,Enum.Material.Fabric)
		piece("GoggleStrap",V(1.9,0.18,0.11),V(0,6.35,-0.87),INK,Enum.Material.Fabric)
		for _,side in {-1,1} do
			orb("GoggleRim",V(0.64,0.47,0.22),V(side*0.41,6.36,-0.96),BRASS,Enum.Material.Metal)
			local lens=orb("GoggleLens",V(0.45,0.29,0.08),V(side*0.41,6.36,-1.08),rgb(159,211,209),Enum.Material.Glass)
			lens.Transparency=0.2
			local shine=orb("GoggleReflection",V(0.07,0.14,0.025),V(side*0.41-0.10,6.40,-1.13),IVORY)
			shine.Transparency=0.24
		end
		piece("ToolBelt",V(2.14,0.28,1.18),V(0,2.8,0),HAIR,Enum.Material.Fabric)
		piece("ToolBuckle",V(0.4,0.3,0.1),V(0,2.8,-0.66),BRASS,Enum.Material.Metal)
		piece("ToolPocket",V(0.61,0.73,0.18),V(0.68,2.62,-0.68),spec.accent,Enum.Material.Fabric)
		piece("SpannerHandle",V(0.15,0.63,0.13),V(0.69,3.07,-0.8),rgb(179,190,184),Enum.Material.Metal,nil,A(0,0,-0.13))
		for _,side in {-1,1} do piece("SpannerJaw",V(0.13,0.24,0.13),V(0.69+side*0.11,3.42,-0.8),rgb(179,190,184),Enum.Material.Metal,nil,A(0,0,side*-0.25)) end
	else
		orb("TraderHairBun",V(1.4,1.15,1.1),V(0.10,6.42,0.90),HAIR)
		orb("HairBunRibbon",V(0.91,0.18,1.21),V(0.10,6.43,0.96),spec.accent,Enum.Material.Fabric)
		for _,side in {-1,1} do piece("TraderLapel",V(0.42,1.13,0.12),V(side*0.61,3.88,-0.62),spec.accent,Enum.Material.Fabric,nil,A(0,0,side*-0.23)) end
		piece("TraderScarf",V(0.95,0.3,1.19),V(0,4.61,-0.03),rgb(226,184,132),Enum.Material.Fabric)
		piece("ScarfTail",V(0.42,0.8,0.12),V(-0.45,4.06,-0.7),rgb(226,184,132),Enum.Material.Fabric)
		piece("LedgerCover",V(0.96,1.15,0.18),V(-1.55,2.76,-0.5),rgb(80,111,94),Enum.Material.Fabric,nil,A(0,0,-0.16))
		piece("LedgerPages",V(0.8,0.98,0.08),V(-1.55,2.76,-0.62),IVORY,nil,nil,A(0,0,-0.16))
		piece("LedgerClasp",V(0.22,0.25,0.13),V(-1.14,2.76,-0.67),BRASS,Enum.Material.Metal)
		for j=1,3 do piece("CoatButton",V(0.13,0.13,0.09),V(-0.21,2.86+j*0.36,-0.65),BRASS,Enum.Material.Metal) end
	end
	-- A fitted pin follows the coat instead of covering both arms like a sign.
	-- The trader's narrower badge leaves the scarf tail completely clear.
	local badgeWidth=role=="Sell" and 1.15 or 1.62
	local badgeX=role=="Sell" and 0.43 or 0
	piece("NameBadgeFrame",V(badgeWidth+0.12,0.51,0.08),V(badgeX,4.03,-0.71),BRASS,Enum.Material.Metal)
	local badge=piece("KeeperNamePlaque",V(badgeWidth,0.40,0.045),V(badgeX,4.03,-0.775),INK,Enum.Material.SmoothPlastic)
	local surface=Instance.new("SurfaceGui")
	surface.Name="KeeperIdentification";surface.Face=Enum.NormalId.Front;surface.CanvasSize=Vector2.new(480,96)
	surface.LightInfluence=0.2;surface.MaxDistance=38;surface.Parent=badge
	local label=Instance.new("TextLabel")
	label.Name="KeeperName";label.Size=UDim2.new(1,-20,1,-6);label.Position=UDim2.fromOffset(10,3)
	label.BackgroundTransparency=1;label.TextColor3=IVORY;label.Font=Enum.Font.BuilderSansMedium;label.TextSize=32
	label.Text=spec.name;label.TextTruncate=Enum.TextTruncate.AtEnd;label.Parent=surface
	local prompt=Instance.new("ProximityPrompt")
	prompt.Name="KeeperShopPrompt";prompt.ActionText=spec.action;prompt.ObjectText=spec.name
	prompt.KeyboardKeyCode=Enum.KeyCode.F;prompt.MaxActivationDistance=15;prompt.HoldDuration=0;prompt.RequiresLineOfSight=false
	prompt:SetAttribute("Shop",role);prompt.Parent=badge
	model.Parent=parent
	return model
end

return StationKeeper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Hand-built procedural scenery. Gameplay reads only the returned pit geometry
-- and destination frames; scenery never grants rewards or changes progression.
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local GardenService = require(script.Parent:WaitForChild("GardenService"))
local PortalFactory = require(script.Parent:WaitForChild("PortalFactory"))
local StationKeeper = require(script.Parent:WaitForChild("StationKeeper"))

local World = {}
local cycleStarted = false
local V = Vector3.new
local rgb = Color3.fromRGB
local P = {
	wood=rgb(128,91,59), darkWood=rgb(78,62,46), lightWood=rgb(184,145,94),
	stone=rgb(161,166,145), darkStone=rgb(105,117,105), cream=rgb(240,228,194),
	leaf=rgb(91,150,88), ink=rgb(39,59,49), brass=rgb(199,164,93),
}

local function folder(parent, name)
	local item=Instance.new("Folder"); item.Name=name; item.Parent=parent; return item
end

local function part(parent, name, size, position, tint, material, shape, rotation)
	local item=Instance.new(shape=="Wedge" and "WedgePart" or "Part")
	item.Name=name; item.Size=size; item.Position=position; item.Color=tint
	item.Material=material or Enum.Material.SmoothPlastic
	item.Anchored=true; item.TopSurface=Enum.SurfaceType.Smooth; item.BottomSurface=Enum.SurfaceType.Smooth
	if shape and shape~="Wedge" then item.Shape=shape end
	if rotation then item.CFrame=CFrame.new(position)*rotation end
	item.Parent=parent
	return item
end

local function detail(parent, name, size, position, tint, material, shape, rotation)
	local item=part(parent,name,size,position,tint,material,shape,rotation)
	item.CanCollide=false; item.CanTouch=false
	return item
end

local function disk(parent,name,position,radius,height,tint,material)
	return part(parent,name,V(height,radius*2,radius*2),position,tint,material,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
end

local function plaque(parent, position, title, subtitle, tint, width)
	local board=part(parent,"PhysicalSign",V(width or 16,3.4,0.35),position,P.ink,Enum.Material.Wood)
	board.CanCollide=false
	local gui=Instance.new("SurfaceGui")
	gui.Name="Wayfinding"; gui.Face=Enum.NormalId.Front; gui.CanvasSize=Vector2.new(600,140)
	gui.LightInfluence=0.3; gui.MaxDistance=90; gui.Parent=board
	local text=Instance.new("TextLabel")
	text.Size=UDim2.new(1,-28,subtitle and 0.57 or 1,0); text.Position=UDim2.fromOffset(14,0)
	text.BackgroundTransparency=1; text.Font=Enum.Font.BuilderSansBold; text.TextSize=31
	text.TextColor3=tint or P.cream; text.Text=title; text.TextTruncate=Enum.TextTruncate.AtEnd; text.Parent=gui
	if subtitle then
		local sub=text:Clone(); sub.Size=UDim2.new(1,-28,0.43,0); sub.Position=UDim2.new(0,14,0.57,-3)
		sub.Font=Enum.Font.BuilderSans; sub.TextSize=19; sub.TextColor3=rgb(193,209,190); sub.Text=subtitle; sub.Parent=gui
	end
	return board
end

local function prompt(target,action,name,key,value)
	local object=Instance.new("ProximityPrompt")
	object.ActionText=action; object.ObjectText=name; object.HoldDuration=0
	object.KeyboardKeyCode=Enum.KeyCode.F; object.MaxActivationDistance=15; object.RequiresLineOfSight=false
	object:SetAttribute(key,value); object.Parent=target
end

local function lamp(parent,position,tint,short)
	local h=short and 4 or 10
	part(parent,"LanternPost",V(0.6,h,0.6),position+V(0,h/2,0),P.darkWood,Enum.Material.Wood)
	part(parent,"LanternBracket",V(2.6,0.35,0.5),position+V(0,h,0),P.darkWood)
	part(parent,"LanternCap",V(2.2,0.35,2.2),position+V(0,h+0.4,0),P.brass,Enum.Material.Metal)
	local glow=detail(parent,"LanternGlass",V(1.4,1.8,1.4),position+V(0,h-0.7,0),tint,Enum.Material.Neon)
	glow.Transparency=0.22
	local light=Instance.new("PointLight"); light.Color=tint; light.Brightness=1.1; light.Range=34; light.Parent=glow
end

local function crate(parent,position,scale)
	scale=scale or 1
	part(parent,"CrateBody",V(4,3.6,3.6)*scale,position+V(0,1.8*scale,0),P.lightWood,Enum.Material.WoodPlanks)
	for _,x in {-1.7,1.7} do detail(parent,"CrateIronCorner",V(0.3,3.8,3.8)*scale,position+V(x,1.8,0)*scale,P.darkWood) end
	detail(parent,"CrateBrace",V(4.5,0.3,0.2)*scale,position+V(0,1.8,-1.9)*scale,P.wood,nil,nil,CFrame.Angles(0,0,0.62))
end

local function barrel(parent,position)
	part(parent,"BarrelStaves",V(3.2,4.1,3.2),position+V(0,2.05,0),P.wood,Enum.Material.Wood,Enum.PartType.Ball)
	for _,h in {0.8,3.2} do disk(parent,"BarrelBand",position+V(0,h,0),1.56,0.23,P.darkWood,Enum.Material.Metal) end
	disk(parent,"BarrelLid",position+V(0,4,0),1.22,0.18,P.lightWood,Enum.Material.WoodPlanks)
end

local function bench(parent,position)
	for j=-1,1 do part(parent,"SeatSlat",V(10,0.3,0.65),position+V(0,2.0,j*0.8),P.lightWood,Enum.Material.WoodPlanks) end
	for h=0,1 do part(parent,"BackrestSlat",V(10,0.6,0.3),position+V(0,3+h*0.8,1.05),P.lightWood,Enum.Material.WoodPlanks) end
	for _,x in {-3.8,3.8} do
		part(parent,"BenchLeg",V(0.5,2,2.8),position+V(x,1,0),P.darkWood,Enum.Material.Metal)
		part(parent,"BackrestPost",V(0.4,3,0.4),position+V(x,2.5,1.05),P.darkWood)
	end
end

local function flowerCluster(parent,position,tint)
	for i=1,3 do
		local x,z=(i-2)*0.8,(i%2)*0.65
		detail(parent,"FlowerStem",V(0.12,1.0,0.12),position+V(x,0.55,z),rgb(74,126,67))
		detail(parent,"FlowerPetals",V(0.85,0.32,0.85),position+V(x,1.1,z),tint,nil,Enum.PartType.Ball)
		detail(parent,"FlowerHeart",V(0.27,0.18,0.27),position+V(x,1.26,z),P.cream,nil,Enum.PartType.Ball)
	end
end

local function tree(parent,position,scale,kind,tint,yaw)
	local treeFolder=folder(parent,kind==2 and "PalmTree" or kind==3 and "MoonPine" or "CloverOak")
	local brown=kind==3 and rgb(90,92,111) or P.wood
	if kind==2 then
		for j=0,4 do
			part(treeFolder,"PalmTrunkSegment",V(2.2-j*0.15,4.2,2.2-j*0.15)*scale,position+V(j*0.6,2+j*3.3,0)*scale,brown,Enum.Material.Wood,nil,CFrame.Angles(0,0,-0.14))
		end
		local crown=position+V(2.5,17,0)*scale
		for j=1,7 do
			local a=j*math.pi*2/7+yaw
			detail(treeFolder,"PalmFrond",V(3,0.6,15)*scale,crown+V(math.sin(a)*5.7,-0.5,math.cos(a)*5.7)*scale,tint,Enum.Material.Grass,"Wedge",CFrame.Angles(0,a,0)*CFrame.Angles(-0.12,0,0))
		end
		for j=1,3 do detail(treeFolder,"Coconut",V(1.4,1.7,1.4)*scale,crown+V((j-2)*0.9,-1.1,-0.8)*scale,P.darkWood,nil,Enum.PartType.Ball) end
	else
		part(treeFolder,"TaperedTrunk",V(2.6,13,2.6)*scale,position+V(0,6.5,0)*scale,brown,Enum.Material.Wood)
		for j=1,3 do
			local a=j*math.pi*2/3+yaw
			detail(treeFolder,"TreeRoot",V(1.0,1.5,5)*scale,position+V(math.sin(a)*1.8,0.65,math.cos(a)*1.8)*scale,brown,Enum.Material.Wood,nil,CFrame.Angles(0,a,0))
		end
		if kind==3 then
			for tier=1,3 do
				local w=(17-tier*3.4)*scale
				for side=0,3 do
					detail(treeFolder,"PineBough",V(w,7*scale,w/2),position+V(0,8+tier*4,0)*scale,tint:Lerp(P.cream,tier*0.035),Enum.Material.Grass,"Wedge",CFrame.Angles(0,side*math.pi/2+yaw,0))
				end
			end
		else
			for j=1,2 do part(treeFolder,"OakFork",V(1.5,8,1.5)*scale,position+V((j==1 and -1 or 1)*2.1,12,0)*scale,brown,Enum.Material.Wood,nil,CFrame.Angles(0,0,j==1 and 0.5 or -0.5)) end
			for j=1,4 do
				local a=j*math.pi/2+yaw
				detail(treeFolder,"LayeredCanopy",V(15,11,14)*scale,position+V(math.sin(a)*4.2,15+(j%2)*3,math.cos(a)*3.8)*scale,tint:Lerp(P.cream,(j%3)*0.035),Enum.Material.Grass,Enum.PartType.Ball)
			end
		end
	end
end

local function shoreline(parent,offset,index)
	local cliffs=folder(parent,"TerracedShore")
	local stone=index==3 and rgb(89,137,151) or index==2 and rgb(155,108,77) or rgb(130,148,116)
	part(cliffs,"IslandStone",V(684,18,644),offset+V(0,-16,0),stone,Enum.Material.Slate)
	part(cliffs,"LowerIslandShelf",V(655,12,615),offset+V(0,-29,0),stone:Lerp(P.darkStone,0.18),Enum.Material.Rock)
	for j=1,20 do
		local horizontal=j%2==0
		local d=-312+math.floor((j-1)/2)*69
		for _,side in {-1,1} do
			local pos=horizontal and V(d,-8-(j%3),side*323) or V(side*343,-8-(j%3),d)
			local rock=detail(cliffs,"ShorelineOutcrop",V(42+(j%4)*5,15+(j%3)*3,29),offset+pos,stone:Lerp(P.cream,(j%3)*0.035),Enum.Material.Rock,Enum.PartType.Ball,CFrame.Angles(0,j*0.37,0))
			rock.CanCollide=true
		end
	end
end

-- Continuous collision lives inside sculpted strata. Overlapping stone cores
-- keep every edge closed while the visible faces read as natural escarpments.
local function cliffSegment(parent,position,width,depth,height,index,seed,yaw,inward)
	local tones={rgb(153,166,143),rgb(169,111,77),rgb(91,139,151)}
	local tint=tones[index]:Lerp(P.cream,(seed%5)*0.018)
	part(parent,"CliffCore",V(width+0.8,height,depth),position+V(0,height/2-5,0),tint,Enum.Material.Rock,nil,CFrame.Angles(0,yaw,0))
	-- Large, overlapping weathered masses cover the straight collision cores.
	-- Varied summits break their silhouette instead of repeating flat wall caps.
	part(parent,"WeatheredRockButtress",V(width*1.5,height*(1.35+(seed%3)*0.04),depth*2),position+inward*(depth*0.08)+V(0,height*0.40,0),tint:Lerp(P.cream,0.035+(seed%3)*0.03),index==2 and Enum.Material.Sandstone or Enum.Material.Rock,Enum.PartType.Ball,CFrame.Angles(0,yaw,0))
	local along=V(math.cos(yaw),0,-math.sin(yaw))
	part(parent,"BrokenRockSummit",V(width*(0.64+(seed%3)*0.08),height*(0.60+(seed%2)*0.12),depth*1.7),position+along*((seed%3-1)*width*0.12)+V(0,height*(0.81+(seed%3)*0.035),0),tint:Lerp(P.darkStone,0.05+(seed%3)*0.045),Enum.Material.Rock,"Wedge",CFrame.Angles(0,yaw+(seed%2)*math.pi,0)*CFrame.Angles((seed%3-1)*0.13,0,(seed%2==0 and -1 or 1)*0.12))
	detail(parent,"FracturedMineralPlate",V(width*0.72,height*0.37,depth*0.63),position+inward*(depth*0.73)+along*(width*0.12)+V(0,height*0.31,0),tint:Lerp(P.cream,index==2 and 0.20 or 0.12),index==2 and Enum.Material.Sandstone or Enum.Material.Slate,"Wedge",CFrame.Angles(0,yaw+(seed%2)*math.pi,0)*CFrame.Angles(0.1,0,(seed%2==0 and -0.1 or 0.15)))
	local toe=part(parent,"WeatheredCliffFoot",V(width*0.64,12+(seed%3)*2,depth*1.12),position+inward*(depth*0.46)+V(0,2,0),tint:Lerp(P.darkStone,0.12),Enum.Material.Rock,Enum.PartType.Ball,CFrame.Angles(0,yaw+seed*0.13,0))
	toe.CanTouch=false
	if index==1 and seed%3==0 then
		detail(parent,"ClingingCliffMoss",V(width*0.46,7,depth*0.8),position+inward*(depth*0.64)+V(0,height*0.68,0),rgb(113,143,99),Enum.Material.Grass,Enum.PartType.Ball,CFrame.Angles(0,yaw,0.14))
	elseif index==3 and seed%2==0 then
		detail(parent,"ExposedQuartzVein",V(width*0.28,height*0.38,0.4),position+inward*(depth*0.98)+V(0,height*0.53,0),rgb(154,217,213),Enum.Material.Glass,"Wedge",CFrame.Angles(0,yaw,0.26))
	end
end

local function cliffEdge(parent,offset,index,startPoint,endPoint,inward,count,seedBase)
	local delta=endPoint-startPoint
	local length=delta.Magnitude
	local width=length/count
	local along=delta*(1/length)
	local yaw=math.abs(along.X)>0.5 and 0 or math.pi/2
	for j=1,count do
		local center=offset+startPoint+along*((j-0.5)*width)
		cliffSegment(parent,center,width,28,57+((j+seedBase)%4)*5,index,j+seedBase,yaw,inward)
	end
end

local function naturalBoundary(parent,offset,index)
	local rim=folder(parent,"NaturalBoundary")
	cliffEdge(rim,offset,index,V(-356,0,-336),V(-356,0,336),V(1,0,0),11,1)
	cliffEdge(rim,offset,index,V(356,0,-336),V(356,0,336),V(-1,0,0),11,7)
	cliffEdge(rim,offset,index,V(-356,0,336),V(356,0,336),V(0,0,-1),12,4)
	if index==1 then
		-- The only opening leads into an enclosed, walkable garden corridor.
		cliffEdge(rim,offset,index,V(-356,0,-336),V(-24,0,-336),V(0,0,1),6,2)
		cliffEdge(rim,offset,index,V(24,0,-336),V(356,0,-336),V(0,0,1),6,8)
	else
		cliffEdge(rim,offset,index,V(-356,0,-336),V(356,0,-336),V(0,0,1),12,2)
	end
	return rim
end

local function gardenBoundary(neighborhood)
	local rim=folder(neighborhood,"GardenEscarpment")
	local zero=V(0,0,0)
	cliffEdge(rim,zero,1,V(-244,0,-801),V(-244,0,-382),V(1,0,0),7,1)
	cliffEdge(rim,zero,1,V(244,0,-801),V(244,0,-382),V(-1,0,0),7,7)
	cliffEdge(rim,zero,1,V(-244,0,-801),V(244,0,-801),V(0,0,1),8,3)
	cliffEdge(rim,zero,1,V(-244,0,-382),V(-24,0,-382),V(0,0,-1),4,4)
	cliffEdge(rim,zero,1,V(24,0,-382),V(244,0,-382),V(0,0,-1),4,8)
	for _,side in {-1,1} do
		cliffSegment(rim,V(side*34,0,-359),46,16,44,1,3,math.pi/2,V(-side,0,0))
	end
	-- A high stone lintel frames the open bridge without obstructing R6 rigs.
	part(rim,"GardenRockArch",V(61,10,24),V(0,35,-335),rgb(153,166,143),Enum.Material.Rock,"Wedge",CFrame.Angles(0,0,0))
end

local function digSite(parent,offset,tint,id)
	local dig=folder(parent,"ExcavationSite")
	local center=offset+V(0,0.65,130)
	local size=V(320,3,280)
	local sand=part(dig,"DigZone",size,offset+V(0,-2.6,130),tint,Enum.Material.Sand)
	sand:SetAttribute("WorldId",id)
	for j=0,19 do
		for _,side in {-1,1} do
			part(dig,"RetainingStone",V(3.2,2.2,13.2),offset+V(side*162,0.3,-3+j*14),P.stone,Enum.Material.Slate)
		end
	end
	for j=0,21 do
		local x=-154+j*14.7
		if math.abs(x)>22 then part(dig,"EntranceRetainingStone",V(13.8,2.2,3),offset+V(x,0.3,-11),P.stone,Enum.Material.Slate) end
		part(dig,"RearRetainingStone",V(13.8,2.2,3),offset+V(x,0.3,271),P.stone,Enum.Material.Slate)
	end
	for j=1,4 do
		part(dig,"WideEntranceStep",V(39,0.35,3.0),offset+V(0,0.3-j*0.35,-15+j*3),P.stone,Enum.Material.Slate)
	end
	for row=1,4 do
		for col=1,5 do
			local ripple=detail(dig,"WindBrushedSand",V(38,0.025,15),offset+V(-145+col*49,-1.085,17+row*50),tint:Lerp(P.cream,(row+col)%2==0 and 0.08 or 0.025),Enum.Material.Sand,Enum.PartType.Ball,CFrame.Angles(0,0.08*(col%2),0))
			ripple.CanQuery=false
		end
	end
	for _,x in {-179,179} do
		for j=0,4 do
			part(dig,"RopeFencePost",V(0.7,3.4,0.7),offset+V(x,1.95,4+j*62),P.wood,Enum.Material.Wood)
			if j<4 then detail(dig,"RopeRail",V(0.18,0.18,62),offset+V(x,2.8,35+j*62),P.lightWood) end
		end
	end
	for _,x in {-190,190} do for _,z in {6,132,258} do lamp(dig,offset+V(x,0.3,z),rgb(255,225,164),false) end end
	local supplies=folder(dig,"ExcavationSupplies")
	crate(supplies,offset+V(-197,0.3,-18),1); crate(supplies,offset+V(-202,0.3,-23),0.7)
	barrel(supplies,offset+V(196,0.3,-22))
	local cart=part(supplies,"SurveyCart",V(7,0.5,4),offset+V(200,2,-8),P.lightWood,Enum.Material.WoodPlanks)
	for _,x in {-2.6,2.6} do for _,z in {-1.5,1.5} do
		part(supplies,"CartWheel",V(0.45,2.0,2.0),cart.Position+V(x,-1.1,z),P.darkWood,nil,Enum.PartType.Cylinder)
	end end
	detail(supplies,"SurveyDetector",V(0.3,4.8,0.3),cart.Position+V(0,2.3,0),P.brass,Enum.Material.Metal,nil,CFrame.Angles(0,0,0.45))
	plaque(dig,offset+V(-38,4.0,-25),"The dig grounds","Search the sand · capture the signal",P.cream,23)
	return center,size
end

local function fountain(parent,position,tint)
	local court=folder(parent,"GardenFountain")
	disk(court,"FountainPaving",position+V(0,0.1,0),16,0.35,P.stone,Enum.Material.Cobblestone)
	disk(court,"FountainBasin",position+V(0,1.1,0),10.5,1.9,P.cream,Enum.Material.Marble)
	local water=disk(court,"FountainWater",position+V(0,2.1,0),9.4,0.18,tint,Enum.Material.Glass); water.CanCollide=false; water.Transparency=0.16
	disk(court,"FountainPedestal",position+V(0,3.4,0),2.7,4,P.cream,Enum.Material.Marble)
	disk(court,"UpperFountainBowl",position+V(0,5.4,0),4.5,0.6,P.cream,Enum.Material.Marble)
	for j=1,8 do
		local a=j*math.pi/4
		local jet=detail(court,"WaterRibbon",V(0.14,3.7,0.18),position+V(math.sin(a)*3.5,3.6,math.cos(a)*3.5),tint,Enum.Material.Glass,nil,CFrame.Angles(math.sin(a)*0.26,0,math.cos(a)*0.26))
		jet.Transparency=0.25
	end
	detail(court,"FountainFinial",V(2.0,2.8,2.0),position+V(0,7.1,0),tint,Enum.Material.Glass,Enum.PartType.Ball)
end

local function shop(parent,position,food)
	local building=folder(parent,food and "FoodMarket" or "GearWorkshop")
	local color=food and rgb(210,126,97) or rgb(93,137,158)
	part(building,"FoundationTrim",V(40,0.5,29),position+V(0,0.55,0),P.stone,Enum.Material.Slate)
	part(building,"ShopFloor",V(37,0.4,26),position+V(0,0.95,0),P.lightWood,Enum.Material.WoodPlanks)
	for _,x in {-17,17} do for _,z in {-11,11} do part(building,"CarvedTimberPost",V(1.3,11.5,1.3),position+V(x,6.5,z),P.wood,Enum.Material.Wood) end end
	part(building,"PlasterBackWall",V(35,8,0.8),position+V(0,5.2,11),P.cream,Enum.Material.Concrete)
	for _,x in {-11,11} do
		part(building,"BackWindowFrame",V(7.3,5,0.2),position+V(x,6.3,10.45),P.wood,Enum.Material.Wood)
		detail(building,"BackWindowPane",V(6.4,4.1,0.15),position+V(x,6.3,10.25),rgb(171,213,202),Enum.Material.Glass)
		part(building,"WindowMullion",V(0.25,4.4,0.3),position+V(x,6.3,10.05),P.lightWood)
	end
	for _,side in {-1,1} do
		part(building,"GabledRoof",V(23,0.8,31),position+V(side*10,14.0,0),color,Enum.Material.WoodPlanks,nil,CFrame.Angles(0,0,side*-0.31))
		part(building,"RoofFascia",V(23,0.45,0.7),position+V(side*10,14.05,-15.5),P.cream,nil,nil,CFrame.Angles(0,0,side*-0.31))
	end
	part(building,"RoofRidge",V(0.8,0.8,32),position+V(0,17.4,0),P.darkWood)
	local counter=part(building,"ShopCounter",V(31,3.4,3.6),position+V(0,3.0,-6.5),P.wood,Enum.Material.WoodPlanks)
	part(building,"CounterTop",V(32,0.35,4.0),position+V(0,4.9,-6.5),P.lightWood,Enum.Material.Wood)
	for _,x in {-10,10} do part(building,"CabinetInset",V(7.8,2.3,0.1),position+V(x,3.1,-8.36),color) end
	part(building,"CashRegister",V(2.1,1.3,1.8),position+V(11,5.7,-6.2),P.darkStone,Enum.Material.Metal)
	detail(building,"RegisterScreen",V(1.4,0.8,0.1),position+V(11,5.9,-7.14),rgb(169,219,171),Enum.Material.Neon)
	for _,h in {4.5,7.4} do part(building,"BackShelf",V(29,0.35,2.4),position+V(0,h,8.6),P.wood,Enum.Material.Wood) end
	for j=1,7 do
		local x=-12+(j-1)*4
		if food then
			part(building,"ProduceBasket",V(3.3,0.9,2.6),position+V(x,5.3,-6.1),P.lightWood,Enum.Material.Wood)
			for k=1,3 do detail(building,"FreshProduce",V(0.9,0.9,0.9),position+V(x+(k-2)*0.8,6.1,-6.1),j%2==0 and rgb(229,116,93) or rgb(191,202,100),nil,Enum.PartType.Ball) end
			part(building,"FlourJar",V(1.5,2,1.5),position+V(x,5.7,8.5),P.cream,nil,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
		else
			part(building,"EquipmentCase",V(2.8,1.6,1.6),position+V(x,5.9,8.5),j%2==0 and color or P.darkStone,Enum.Material.Metal)
			detail(building,"WorkshopSpareShaft",V(0.22,2.5,0.22),position+V(x,6.5,-6),P.brass,Enum.Material.Metal,nil,CFrame.Angles(0,0,0.25))
			detail(building,"SpareSearchCoil",V(0.12,1.8,1.8),position+V(x,5.3,-6),color,Enum.Material.Metal,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
		end
	end
	for _,x in {-17,17} do lamp(building,position+V(x,1.0,-12),rgb(255,227,172),true) end
	plaque(building,position+V(0,10,-13.3),food and "Food market" or "Gear workshop",food and "Fresh snacks · five-minute rotation" or "Detectors · growth & income boosts",P.cream,27)
	StationKeeper.create(building,CFrame.new(position+V(0,1.15,-1.6)),food and "Food" or "Gear")
	crate(building,position+V(-23,0.3,3),0.9); barrel(building,position+V(23,0.3,7))
end

local function pond(parent,position,palm)
	local grove=folder(parent,palm and "PalmOasis" or "CloverPond")
	local tint=palm and rgb(181,180,126) or rgb(179,188,141)
	detail(grove,"PondShore",V(83,1.2,65),position,tint,Enum.Material.Sand,Enum.PartType.Ball)
	local water=detail(grove,"PondWater",V(71,0.3,53),position+V(0,0.8,0),rgb(93,169,166),Enum.Material.Glass,Enum.PartType.Ball); water.Transparency=0.12
	for j=1,7 do
		local a=j*math.pi*2/7
		detail(grove,"PondReed",V(0.13,3+j%3,0.13),position+V(math.cos(a)*36,2.0,math.sin(a)*26),rgb(99,137,76))
		detail(grove,"ReedHead",V(0.4,1,0.4),position+V(math.cos(a)*36,3.5,math.sin(a)*26),P.wood,nil,Enum.PartType.Ball)
	end
	for j=1,5 do detail(grove,"LilyPad",V(4.2,0.15,3.8),position+V(-27+j*7,1.1,8+(j%2)*6),rgb(117,161,95),nil,Enum.PartType.Ball) end
	if not palm then
		for j=-8,8 do
			part(grove,"ArchedBridgePlank",V(14,0.45,3.1),position+V(0,1.6+math.cos(j*math.pi/18)*1.6,j*3.1),P.lightWood,Enum.Material.WoodPlanks)
			if j%3==0 then for _,x in {-7,7} do part(grove,"BridgePost",V(0.5,4.0,0.5),position+V(x,3.4,j*3.1),P.wood) end end
		end
		for _,x in {-7,7} do part(grove,"BridgeHandrail",V(0.45,0.45,50),position+V(x,5.2,0),P.wood) end
		local tablePos=position+V(51,0,12)
		part(grove,"PicnicTableTop",V(11,0.45,6),tablePos+V(0,3,0),P.lightWood,Enum.Material.WoodPlanks)
		for _,x in {-3.7,3.7} do part(grove,"PicnicTableLeg",V(0.8,3.0,4),tablePos+V(x,1.5,0),P.wood) end
		for _,z in {-5,5} do part(grove,"PicnicBench",V(11,0.6,2),tablePos+V(0,1.6,z),P.lightWood) end
		part(grove,"PicnicCloth",V(7,0.05,4),tablePos+V(0,3.26,0),rgb(223,158,128))
		detail(grove,"PicnicFruitBowl",V(2.2,0.7,2.2),tablePos+V(0,3.6,0),P.cream,nil,Enum.PartType.Ball)
	end
	return grove
end

local function windmill(parent,position)
	local landmark=folder(parent,"CloverWindmill")
	disk(landmark,"WindmillFoundation",position+V(0,0.3,0),15,0.6,P.stone,Enum.Material.Slate)
	for tier=1,4 do
		disk(landmark,"WindmillTower",position+V(0,4+(tier-1)*7,0),8.3-tier*0.7,7.2,P.cream,Enum.Material.Concrete)
	end
	disk(landmark,"TowerTopRim",position+V(0,29,0),6.5,0.65,P.wood,Enum.Material.Wood)
	part(landmark,"RoofPeak",V(13,6,12),position+V(0,31.6,0),rgb(185,115,94),Enum.Material.WoodPlanks,"Wedge")
	part(landmark,"WindmillDoor",V(4.6,7.1,0.5),position+V(0,3.9,7.8),P.darkWood,Enum.Material.WoodPlanks)
	for _,h in {13,21} do
		part(landmark,"TowerWindowFrame",V(3,4.2,0.3),position+V(0,h,6.4),P.wood)
		detail(landmark,"TowerWindow",V(2.2,3.2,0.2),position+V(0,h,6.65),rgb(145,194,193),Enum.Material.Glass)
	end
	local hub=position+V(0,24,8.5)
	part(landmark,"MillAxle",V(3.4,3.4,2.2),hub,P.wood,nil,Enum.PartType.Cylinder,CFrame.Angles(0,math.pi/2,0))
	for j=0,3 do
		local a=j*math.pi/2+0.32
		local x,y=math.sin(a),math.cos(a)
		part(landmark,"SailSpar",V(1.0,17,0.6),hub+V(x*8.5,y*8.5,0),P.wood,Enum.Material.Wood,nil,CFrame.Angles(0,0,-a))
		part(landmark,"LinenSail",V(4.2,10.8,0.2),hub+V(x*11.2+y*1.4,y*11.2-x*1.4,0.4),P.cream,Enum.Material.Fabric,nil,CFrame.Angles(0,0,-a))
		for rib=-1,1 do detail(landmark,"SailRib",V(4.5,0.16,0.18),hub+V(x*(11.2+rib*3.8)+y*1.4,y*(11.2+rib*3.8)-x*1.4,0.58),P.lightWood,nil,nil,CFrame.Angles(0,0,-a)) end
	end
	for j=1,3 do crate(landmark,position+V(13+j*3.1,0.3,-3+(j%2)*5),0.8) end
	plaque(landmark,position+V(0,4.2,13),"Clover flour mill","Home-grown snacks for hungry discoveries",P.cream,22)
end

local function sunRuins(parent,position)
	local ruins=folder(parent,"SunArchSanctuary")
	local tint=rgb(203,172,121)
	for j=1,3 do part(ruins,"SanctuaryStep",V(77-j*7,0.6,57-j*5),position+V(0,j*0.6,0),tint,Enum.Material.Sandstone) end
	for _,side in {-1,1} do
		local column=position+V(side*17,1.8,0)
		part(ruins,"ColumnFoot",V(9,1.2,9),column+V(0,0.6,0),tint,Enum.Material.Sandstone)
		part(ruins,"FlutedColumn",V(6.2,21,6.2),column+V(0,11.5,0),tint,Enum.Material.Sandstone)
		for j=1,4 do detail(ruins,"ColumnGroove",V(0.18,17,0.2),column+V(-2.3+j*0.9,11.7,-3.15),rgb(167,138,93),Enum.Material.Sandstone) end
		part(ruins,"CarvedCapital",V(9,1.5,9),column+V(0,22.3,0),tint,Enum.Material.Sandstone)
	end
	for j=-3,3 do
		local a=j*0.22
		part(ruins,"ArchVoussoir",V(5.1,5.8,7),position+V(math.sin(a)*26,21+math.cos(a)*9,0),tint:Lerp(P.cream,(j%2)*0.03),Enum.Material.Sandstone,nil,CFrame.Angles(0,0,-a))
	end
	disk(ruins,"SunAltarBase",position+V(0,3,10),7,1,P.brass,Enum.Material.Sandstone)
	detail(ruins,"SunMedallion",V(0.6,8,8),position+V(0,8,10),P.brass,Enum.Material.Metal,Enum.PartType.Cylinder,CFrame.Angles(0,math.pi/2,0))
	for j=1,8 do
		local a=j*math.pi/4
		detail(ruins,"SunRayCarving",V(0.6,2.8,0.5),position+V(math.sin(a)*5,8+math.cos(a)*5,10),P.brass,nil,nil,CFrame.Angles(0,0,-a))
	end
	for j=1,5 do
		local x=-34+(j%2)*68
		part(ruins,"BrokenColumn",V(5,4+j,5),position+V(x,3+j/2,-18+j*7),tint,Enum.Material.Sandstone,nil,CFrame.Angles(0,j,0.12*(j%2)))
	end
	plaque(ruins,position+V(0,5,-22),"The sun archive","An old survey station, reclaimed by sand",P.cream,24)
end

local function crystalCluster(parent,position,scale,tint)
	local cluster=folder(parent,"FacetedCrystalCluster")
	local base=detail(cluster,"CrystalMatrix",V(7.3,1.3,6.6)*scale,position+V(0,0.15,0),rgb(93,127,140),Enum.Material.Slate,Enum.PartType.Ball)
	for j=1,4 do
		local a=j*math.pi/2+0.22
		local h=(j%2==0 and 7 or 4.5)*scale
		local w=1.8*scale
		local pos=position+V(math.sin(a)*1.65*scale,h/2,math.cos(a)*1.65*scale)
		local stem=detail(cluster,"CrystalPrism",V(w,h,w),pos,tint,Enum.Material.Glass,nil,CFrame.Angles(0,a,0))
		stem.Transparency=0.12
		-- Paired sloping planes make a clean mineral termination, rather than a
		-- blunt neon cube. Opaque faces retain color against the pale ground.
		for _,side in {-1,1} do
			detail(cluster,"CutCrystalTip",V(w/2,w*1.05,w),pos+V(math.cos(a)*side*w/4,h/2+w*0.52,-math.sin(a)*side*w/4),tint:Lerp(P.cream,side==1 and 0.2 or 0.05),Enum.Material.SmoothPlastic,"Wedge",CFrame.Angles(0,a+side*math.pi/2,0))
		end
		detail(cluster,"CrystalFaceReflection",V(w*0.12,h*0.76,0.035),pos+V(math.sin(a)*(w/2+0.025),h*0.03,math.cos(a)*(w/2+0.025)),tint:Lerp(P.cream,0.65),Enum.Material.SmoothPlastic,nil,CFrame.Angles(0,a,0))
	end
	return base
end

local function crystalCove(parent,position)
	local cove=folder(parent,"MoonbloomTidalCove")
	detail(cove,"CoveShingle",V(91,1.1,94),position+V(0,0.15,0),rgb(151,190,185),Enum.Material.Pebble,Enum.PartType.Ball)
	local water=detail(cove,"ShelteredCoveWater",V(74,0.24,77),position+V(0,0.85,0),rgb(81,179,188),Enum.Material.Glass,Enum.PartType.Ball)
	water.Transparency=0.19
	for j=1,12 do
		local a=j*math.pi*2/12
		local pos=position+V(math.sin(a)*38,1.0,math.cos(a)*39)
		detail(cove,"CoveShoreBoulder",V(12,6+(j%3),10),pos,rgb(110,155,164),Enum.Material.Slate,Enum.PartType.Ball,CFrame.Angles(0,a,0))
		if j%2==0 then crystalCluster(cove,pos+V(0,2,0),0.8+(j%3)*0.2,j%4==0 and rgb(176,166,220) or rgb(137,218,212)) end
	end
	for j=1,5 do
		local x=-18+j*7
		detail(cove,"SubmergedCrystal",V(3,0.12,4),position+V(x,1.0,8+(j%2)*11),rgb(169,218,211),Enum.Material.Neon,nil,CFrame.Angles(0,j*0.8,0))
	end
	local pier=folder(cove,"CoveViewingPier")
	for j=0,7 do part(pier,"BleachedBoardwalkPlank",V(12,0.35,2.8),position+V(0,1.55,39-j*2.8),rgb(191,198,184),Enum.Material.WoodPlanks) end
	for _,x in {-5.5,5.5} do
		for _,z in {20,38} do part(pier,"PierMooringPost",V(0.65,4.4,0.65),position+V(x,2.0,z),rgb(107,138,136),Enum.Material.Wood) end
		part(pier,"PierHandrail",V(0.3,0.3,19),position+V(x,4.05,29),rgb(191,198,184),Enum.Material.Wood)
	end
	plaque(cove,position+V(-21,4.4,43),"The crystal cove","Moonlit quartz · sheltered turquoise water",P.cream,25)
end

local function observatory(parent,position)
	local place=folder(parent,"MoonwatchObservatory")
	local stone=rgb(132,169,178)
	for j=1,3 do disk(place,"ObservatoryTerrace",position+V(0,j*0.65,0),39-j*3.5,0.65,stone,Enum.Material.Slate) end
	for j=1,8 do
		local a=j*math.pi/4
		local pos=position+V(math.sin(a)*25,8.5,math.cos(a)*25)
		part(place,"ObservatoryColumn",V(2.2,13,2.2),pos,stone,Enum.Material.Marble)
		detail(place,"ColumnInlay",V(0.12,9,0.12),pos+V(-0.8,0,-1.1),rgb(178,213,218),Enum.Material.Neon)
	end
	for j=1,16 do
		local a=j*math.pi*2/16
		part(place,"DomeCornice",V(11.0,1.2,2.8),position+V(math.sin(a)*26.6,15.4,math.cos(a)*26.6),stone,Enum.Material.Marble,nil,CFrame.Angles(0,a,0))
	end
	local dome=detail(place,"ObservatoryGlassDome",V(52,22,52),position+V(0,20,0),rgb(136,195,200),Enum.Material.Glass,Enum.PartType.Ball)
	dome.Transparency=0.6
	for j=1,6 do
		local a=j*math.pi/3
		detail(place,"DomeSpire",V(0.5,12,0.5),position+V(math.sin(a)*23,23,math.cos(a)*23),P.brass,nil,nil,CFrame.Angles(math.sin(a)*0.45,0,math.cos(a)*0.45))
	end
	part(place,"TelescopePedestal",V(3.0,8.2,3.0),position+V(0,6.1,0),stone,Enum.Material.Metal)
	part(place,"TelescopeBarrel",V(19,5.6,5.6),position+V(0,14.5,0),rgb(70,87,117),Enum.Material.Metal,Enum.PartType.Cylinder,CFrame.Angles(0,0,0.35))
	for _,x in {-8,0,8} do
		part(place,"TelescopeBrassRing",V(0.75,6.2,6.2),position+V(math.cos(0.35)*x,14.5+math.sin(0.35)*x,0),P.brass,Enum.Material.Metal,Enum.PartType.Cylinder,CFrame.Angles(0,0,0.35))
	end
	local lens=detail(place,"TelescopeLens",V(0.2,4.7,4.7),position+V(math.cos(0.35)*9.6,14.5+math.sin(0.35)*9.6,0),rgb(165,229,231),Enum.Material.Glass,Enum.PartType.Cylinder,CFrame.Angles(0,0,0.35)); lens.Transparency=0.25
	for j=1,4 do part(place,"ObservatoryEntranceStep",V(18,0.45,5.0),position+V(0,j*0.45,-42+j*4.5),stone,Enum.Material.Slate) end
	plaque(place,position+V(-21,4.5,-29),"Moonwatch observatory","A quiet lookout above the crystal coast",P.cream,23)
end

-- Traversable landforms have flat, supported walking surfaces. Their stair
-- routes rise in small increments instead of asking a classic R6 rig to jump.
local function terrace(parent,name,position,size,top,tint,material,capTint,capMaterial)
	local terrain=folder(parent,name)
	local radius=material==Enum.Material.Sandstone and 8 or math.min(14,size.X*0.18)
	local function roundedLayer(core,height,y,color,surface)
		local first=part(terrain,core and "TerraceCore" or "TerraceTread",V(size.X-radius*2,height,size.Z),position+V(0,y,0),color,surface)
		if not core then first:SetAttribute("WalkableTerrace",true) end
		part(terrain,core and "RoundedTerrainCore" or "RoundedTerrainCap",V(size.X,height,size.Z-radius*2),position+V(0,y,0),color,surface)
		for _,x in {-1,1} do for _,z in {-1,1} do
			part(terrain,core and "RoundedTerrainCore" or "RoundedTerrainCap",V(height,radius*2,radius*2),position+V(x*(size.X/2-radius),y,z*(size.Z/2-radius)),color,surface,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
		end end
	end
	-- The core stops below the half-stud cap. Keeping their upper faces apart
	-- avoids the coplanar flicker that is especially visible on mineral shelves.
	roundedLayer(true,top+3.5,(top-4.5)/2,tint,material)
	roundedLayer(false,0.5,top-0.25,capTint,capMaterial)
	-- Tapered mineral/earth layers give the sides depth without obstructing
	-- the exact walking surface or extending inward over the excavation pit.
	for layer=1,3 do
		local h=top*layer/4
		for _,side in {-1,1} do
			detail(terrain,"ExposedEarthStratum",V(0.7,0.8,size.Z*(0.29+layer*0.09)),position+V(side*(size.X/2+0.05),h,(layer-2)*size.Z*0.14),tint:Lerp(P.cream,0.06+layer*0.045),material,nil,CFrame.Angles(0,0,side*(layer-2)*0.035))
		end
	end
	for j=1,4 do
		local z=-size.Z/2+size.Z*(j-0.5)/4
		for _,side in {-1,1} do
			detail(terrain,"ErodedTerraceFace",V(7,math.max(4,top*0.69),size.Z/4.6),position+V(side*(size.X/2-1.5),top*0.34,z),tint:Lerp(P.darkStone,(j%3)*0.045),material,Enum.PartType.Ball,CFrame.Angles(0,0,(j%2==0 and 1 or -1)*0.08))
		end
	end
	-- An asymmetric rounded lip and matching weathered mass break the front
	-- outline while leaving the stair approach on the other side unobstructed.
	local side=material==Enum.Material.Sandstone and -1 or 1
	local lipRadius=math.min(18,size.X*0.18)
	local lipX=side*size.X*0.38
	part(terrain,"NaturalShelfLip",V(0.5,lipRadius*2,lipRadius*2),position+V(lipX,top-0.25,-size.Z/2+3),capTint,capMaterial,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
	part(terrain,"WeatheredShelfPromontory",V(lipRadius*2,math.max(5,top*1.12),lipRadius*2),position+V(lipX,top*0.43,-size.Z/2+4),tint:Lerp(P.darkStone,0.05),material,Enum.PartType.Ball)
	return terrain
end

local function terraceSteps(parent,name,offset,x,startZ,endZ,startTop,endTop,count,tint,material,wood)
	local route=folder(parent,name)
	route:SetAttribute("StartHeight",startTop)
	route:SetAttribute("EndHeight",endTop)
	local rise=(endTop-startTop)/count
	local run=(endZ-startZ)/count
	for j=1,count do
		local top=startTop+rise*j
		local tread=part(route,"TerrainStep",V(16,top-startTop,run+0.025),offset+V(x,(top+startTop)/2,startZ+(j-0.5)*run),tint,material)
		tread:SetAttribute("TerrainStep",true)
		tread:SetAttribute("StepIndex",j)
		if j==1 or j==count or j%5==0 then
			for _,side in {-1,1} do
				part(route,"TrailRailPost",V(0.5,3.6,0.5),offset+V(x+side*8.5,top+1.8,startZ+(j-0.5)*run),wood and P.darkWood or tint:Lerp(P.darkStone,0.2),wood and Enum.Material.Wood or material)
			end
		end
	end
	local length=math.sqrt((endZ-startZ)^2+(endTop-startTop)^2)
	for _,side in {-1,1} do
		local rail=part(route,"TrailHandrail",V(0.3,0.3,length),offset+V(x+side*8.5,(startTop+endTop)/2+3.4,(startZ+endZ)/2),wood and P.lightWood or tint:Lerp(P.cream,0.26),wood and Enum.Material.Wood or material,nil,CFrame.Angles(-math.atan((endTop-startTop)/(endZ-startZ)),0,0))
		rail.CanTouch=false
	end
	return route
end

local function cascade(parent,name,position,top,bottom,width,tint)
	local fall=folder(parent,name)
	local rock=part(fall,"WaterfallRockLip",V(6,2,width+5),position+V(0,top-0.7,0),rgb(100,124,121),Enum.Material.Slate,Enum.PartType.Ball)
	rock.CanCollide=false
	local curtain=detail(fall,"FallingWater",V(0.28,top-bottom,width),position+V(-2.4,(top+bottom)/2,0),tint,Enum.Material.Glass)
	curtain.Transparency=0.24
	for stripe=1,3 do
		local stream=detail(fall,"WaterfallHighlight",V(0.045,top-bottom,0.16),position+V(-2.57,(top+bottom)/2,(stripe-2)*width*0.28),rgb(201,237,227),Enum.Material.Glass)
		stream.Transparency=0.45
	end
	local pool=detail(fall,"CascadePool",V(18,0.28,width+15),position+V(-8,bottom+0.15,0),tint,Enum.Material.Glass,Enum.PartType.Ball)
	pool.Transparency=0.15
	for j=1,3 do
		local foam=detail(fall,"WaterfallFoam",V(3.8,0.15,1.8),position+V(-3.8-j*2,bottom+0.3,(j%2-0.5)*width*0.34),P.cream,Enum.Material.Glass,Enum.PartType.Ball)
		foam.Transparency=0.38
	end
	return fall
end

local function layeredBiomes(parent,offset,index)
	local biome=folder(parent,"LayeredBiome")
	if index==1 then
		local hills=folder(biome,"CloverHighlands")
		local earth=rgb(120,106,79)
		local grass=rgb(117,159,103)
		terrace(hills,"LowOrchardTerrace",offset+V(255,0,154),V(122,0,252),8.3,earth,Enum.Material.Ground,grass,Enum.Material.Grass)
		terrace(hills,"BrookTerrace",offset+V(260,0,180),V(92,0,180),20.3,earth:Lerp(P.stone,0.15),Enum.Material.Ground,grass:Lerp(P.cream,0.05),Enum.Material.Grass)
		terrace(hills,"CloverLookoutTerrace",offset+V(267,0,214),V(66,0,108),36.3,earth:Lerp(P.stone,0.3),Enum.Material.Rock,grass:Lerp(P.cream,0.1),Enum.Material.Grass)
		terraceSteps(hills,"OrchardApproach",offset,228,-8,28,0.3,8.3,12,P.lightWood,Enum.Material.WoodPlanks,true)
		terraceSteps(hills,"BrookClimb",offset,246,45,90,8.3,20.3,18,P.lightWood,Enum.Material.WoodPlanks,true)
		terraceSteps(hills,"LookoutClimb",offset,268,104,160,20.3,36.3,24,P.lightWood,Enum.Material.WoodPlanks,true)
		for j=1,4 do
			local x=j==1 and 263 or j==3 and 294 or 297
			local pos=offset+V(x,j<=2 and 8.3 or 20.3,j<=2 and 44+j*11 or 100+j*12)
			tree(hills,pos,0.95+(j%2)*0.2,1,rgb(94,145,91),j)
			flowerCluster(hills,pos+V(-7,0,3),rgb(236,205,155))
		end
		tree(hills,offset+V(297,36.3,242),1.1,1,rgb(113,158,98),0.5)
		bench(hills,offset+V(276,36.3,252))
		plaque(hills,offset+V(283,40.5,257),"Clover highlands","Follow the timber trail to the valley lookout",P.cream,25)
		cascade(hills,"UpperBrookCascade",offset+V(215,0,195),20.3,8.3,12,rgb(111,183,180))
		cascade(hills,"LowerBrookCascade",offset+V(194,0,202),8.3,0.3,15,rgb(111,183,180))
		local stream=detail(hills,"MeanderingBrook",V(10,0.2,61),offset+V(204,8.46,184),rgb(111,183,180),Enum.Material.Glass)
		stream.Transparency=0.18
		for j=1,8 do
			local pos=offset+V(197+(j%2)*13,8.5,158+j*6)
			detail(hills,"BrookBankStone",V(3.5,1.6,3.0),pos,rgb(151,164,143),Enum.Material.Slate,Enum.PartType.Ball)
		end
		-- A small timber crossing sits over shallow water on the lower shelf.
		for j=0,6 do part(hills,"BrookBridgePlank",V(18,0.25,2),offset+V(204,9,171+j*1.9),P.lightWood,Enum.Material.WoodPlanks) end
		for j=1,3 do part(hills,"BrookBridgeStep",V(18,0.22,1.5),offset+V(204,8.35+j*0.22,168+j*1.5),P.lightWood,Enum.Material.WoodPlanks) end
		for _,x in {195,213} do lamp(hills,offset+V(x,8.3,188),rgb(255,232,179),true) end
	elseif index==2 then
		local mesas=folder(biome,"SandstoneMesas")
		local stone=rgb(165,103,71)
		local cap=rgb(221,168,114)
		terrace(mesas,"LowerCanyonBench",offset+V(-260,0,151),V(112,0,254),10.3,stone,Enum.Material.Sandstone,cap,Enum.Material.Sandstone)
		terrace(mesas,"ArchiveMesaBench",offset+V(-270,0,185),V(92,0,170),24.3,stone:Lerp(rgb(127,73,58),0.18),Enum.Material.Sandstone,cap:Lerp(P.cream,0.12),Enum.Material.Sandstone)
		terrace(mesas,"SunArchSummit",offset+V(-283,0,225),V(66,0,86),39.3,stone:Lerp(rgb(127,73,58),0.3),Enum.Material.Sandstone,cap:Lerp(P.cream,0.22),Enum.Material.Sandstone)
		terraceSteps(mesas,"CanyonApproach",offset,-228,-21,24,0.3,10.3,15,cap,Enum.Material.Sandstone,false)
		terraceSteps(mesas,"MesaSwitchback",offset,-246,47.5,100,10.3,24.3,21,cap,Enum.Material.Sandstone,false)
		terraceSteps(mesas,"SunSummitClimb",offset,-280,124.5,182,24.3,39.3,23,cap,Enum.Material.Sandstone,false)
		local arch=folder(mesas,"WeatheredMesaArch")
		for _,side in {-1,1} do
			part(arch,"ArchStoneLeg",V(6.2,19,9),offset+V(-283+side*13,48.8,229),stone,Enum.Material.Sandstone,nil,CFrame.Angles(0,side*0.08,side*0.07))
			detail(arch,"ArchErosionLayer",V(7.4,1.4,10),offset+V(-283+side*13,47.3,229),cap,Enum.Material.Sandstone)
			part(arch,"ArchUpperShoulder",V(11,8.5,10),offset+V(-283+side*9,59,229),stone:Lerp(P.cream,0.08),Enum.Material.Sandstone,"Wedge",CFrame.Angles(0,side<0 and 0 or math.pi,side*0.15))
		end
		part(arch,"ArchKeystone",V(12,6.5,10),offset+V(-283,61.8,229),cap,Enum.Material.Sandstone,nil,CFrame.Angles(0,0,0.07))
		plaque(mesas,offset+V(-283,43.3,258),"The red mesa","Ancient layers · a trail above the canyon",P.cream,26)
		for _,pos in {V(-300,10.3,47),V(-286,24.3,117),V(-302,39.3,252)} do
			part(mesas,"MesaCactusStem",V(2.2,7,2.2),offset+pos+V(0,3.5,0),rgb(111,143,98),Enum.Material.Grass,Enum.PartType.Ball)
			for _,side in {-1,1} do part(mesas,"MesaCactusArm",V(2.2,3,1.7),offset+pos+V(side*1.6,3.6+side,0),rgb(111,143,98),Enum.Material.Grass,Enum.PartType.Ball,CFrame.Angles(0,0,side*-0.5)) end
		end
		local camp=folder(biome,"CanyonMiningCamp")
		local p=offset+V(260,0.3,93)
		part(camp,"CanvasCampFloor",V(42,0.22,41),p+V(0,0.12,0),rgb(198,147,101),Enum.Material.Ground)
		for _,side in {-1,1} do
			part(camp,"CanvasTentWing",V(17,0.55,25),p+V(side*7,8,0),rgb(198,151,103),Enum.Material.Fabric,nil,CFrame.Angles(0,0,side*-0.66))
			part(camp,"TentSupport",V(0.6,12.8,0.6),p+V(0,6.4,side*11),P.darkWood,Enum.Material.Wood)
		end
		for j=1,10 do
			part(camp,"MineRailSleeper",V(9,0.32,1.0),p+V(0,0.35,25+j*4),P.darkWood,Enum.Material.WoodPlanks)
		end
		for _,x in {-2.9,2.9} do part(camp,"MineRail",V(0.28,0.45,44),p+V(x,0.5,47),rgb(98,91,81),Enum.Material.Metal) end
		part(camp,"OreCartBed",V(8,2.5,7),p+V(0,3.5,43),rgb(114,103,89),Enum.Material.Metal)
		for _,x in {-4,4} do for _,z in {40.5,45.5} do part(camp,"OreCartWheel",V(0.6,2.2,2.2),p+V(x,1.9,z),P.darkWood,Enum.Material.Metal,Enum.PartType.Cylinder) end end
		for j=1,5 do detail(camp,"ExposedCopperOre",V(2.5,2.2,2.5),p+V((j%3-1)*2,5.4,(j%2)*2+42),rgb(173,125,88),Enum.Material.Rock,Enum.PartType.Ball) end
		crate(camp,p+V(-16,0,-7),1.1);barrel(camp,p+V(16,0,-5))
		plaque(camp,p+V(0,5,-18),"The survey camp","Copper tracks beneath the red mesas",P.cream,24)
	else
		local grotto=folder(biome,"GeodeGrotto")
		local rock=rgb(93,135,151)
		local cap=rgb(160,194,197)
		terrace(grotto,"TidalRockShelf",offset+V(260,0,155),V(112,0,250),6.3,rock,Enum.Material.Slate,cap,Enum.Material.Slate)
		terrace(grotto,"QuartzWaterfallShelf",offset+V(276,0,180),V(68,0,180),18.3,rock:Lerp(rgb(115,104,159),0.22),Enum.Material.Slate,cap:Lerp(P.cream,0.1),Enum.Material.Slate)
		terrace(grotto,"GeodeCaveShelf",offset+V(283,0,229),V(66,0,78),32.3,rock:Lerp(rgb(115,104,159),0.4),Enum.Material.Slate,cap:Lerp(P.cream,0.2),Enum.Material.Slate)
		terraceSteps(grotto,"TidalApproach",offset,228,6,30,0.3,6.3,12,cap,Enum.Material.Slate,false)
		terraceSteps(grotto,"QuartzClimb",offset,264,45,90,6.3,18.3,18,cap,Enum.Material.Slate,false)
		terraceSteps(grotto,"GeodeClimb",offset,280,107.5,160,18.3,32.3,21,cap,Enum.Material.Slate,false)
		local skyBridge=folder(grotto,"GrottoSkyBridge")
		local bridge=part(skyBridge,"BridgeLanding",V(16,0.5,34),offset+V(280,32.05,177),P.lightWood,Enum.Material.WoodPlanks)
		bridge:SetAttribute("WalkableLanding",true)
		for j=1,10 do detail(skyBridge,"SkyBridgeDeckSeam",V(16,0.035,0.12),offset+V(280,32.32,160+j*3),P.darkWood,Enum.Material.Wood) end
		for _,x in {271.5,288.5} do
			part(skyBridge,"SkyBridgeHandrail",V(0.4,0.4,34),offset+V(x,35.7,177),P.lightWood,Enum.Material.Wood)
			for _,z in {161,177,193} do part(skyBridge,"SkyBridgePost",V(0.6,3.4,0.6),offset+V(x,34, z),P.darkWood,Enum.Material.Wood) end
		end
		local cave=folder(grotto,"WalkInCrystalCave")
		for j=1,4 do
			for _,side in {-1,1} do
				part(cave,"GeodeCaveButtress",V(10,25+(j%2)*3,15),offset+V(283+side*26,44.8,190+j*14),rock:Lerp(rgb(123,109,164),(j%3)*0.12),Enum.Material.Rock,Enum.PartType.Ball)
			end
		end
		part(cave,"GeodeBackWall",V(52,30,11),offset+V(283,47.3,252),rock,Enum.Material.Rock,Enum.PartType.Ball)
		for j=1,5 do
			part(cave,"GeodeCaveRoof",V(16,13+(j%2)*3,58),offset+V(249+j*11,61+(j%3)*1.5,223),rock:Lerp(rgb(123,109,164),(j%3)*0.12),Enum.Material.Rock,Enum.PartType.Ball,CFrame.Angles(0,0,(j-3)*0.13))
		end
		for j=1,9 do
			local pos=offset+V(j%2==0 and 263 or 303,32.3,185+j*6)
			crystalCluster(cave,pos,0.75+(j%3)*0.24,j%2==0 and rgb(178,164,222) or rgb(127,216,213))
		end
		local mirror=detail(cave,"GeodeMirrorPool",V(25,0.18,25),offset+V(283,32.48,228),rgb(103,193,202),Enum.Material.Glass,Enum.PartType.Ball)
		mirror.Transparency=0.15
		local heart=detail(cave,"GeodeHeart",V(4,8,4),offset+V(283,39.3,244),rgb(179,163,227),Enum.Material.Neon,"Wedge")
		local light=Instance.new("PointLight");light.Color=rgb(163,207,228);light.Brightness=1.2;light.Range=39;light.Parent=heart
		plaque(grotto,offset+V(283,36.5,175),"The geode grotto","Climb into the heart of the crystal coast",P.cream,27)
		cascade(grotto,"UpperQuartzFalls",offset+V(243,0,201),18.3,6.3,15,rgb(100,193,201))
		cascade(grotto,"LowerQuartzFalls",offset+V(204,0,207),6.3,0.3,18,rgb(100,193,201))
		for _,pos in {V(293,6.3,49),V(300,6.3,75),V(302,18.3,114),V(260,18.3,135),V(301,18.3,151)} do crystalCluster(grotto,offset+pos,1.3,rgb(158,210,221)) end
		for j=1,8 do part(grotto,"MineralViewingDeck",V(21,0.25,2.5),offset+V(213,6.8,227+j*2.4),rgb(192,202,193),Enum.Material.WoodPlanks) end
		for j=1,2 do part(grotto,"ViewingDeckStep",V(21,0.24,2),offset+V(213,6.3+j*0.24,224+j*2),rgb(192,202,193),Enum.Material.WoodPlanks) end
		for _,x in {202.5,223.5} do
			part(grotto,"ViewingDeckRail",V(0.4,0.4,22),offset+V(x,10.1,238),P.cream,Enum.Material.Wood)
			for _,z in {228,248} do part(grotto,"ViewingDeckPost",V(0.6,3.4,0.6),offset+V(x,8.4,z),P.cream,Enum.Material.Wood) end
		end
	end
	return biome
end

local function landscapes(parent,offset,index,rng)
	local vegetation=folder(parent,index==3 and "CrystalGroves" or "Woodland")
	local tints={rgb(99,148,99),rgb(137,155,102),rgb(129,210,205)}
	local function grove(point,scale,seed)
		if index==3 then
			local tint=seed%3==0 and rgb(181,168,220) or seed%3==1 and rgb(130,207,208) or rgb(161,214,224)
			crystalCluster(vegetation,point,scale*2.25,tint)
		else
			tree(vegetation,point,scale,index,tints[index],seed*0.9)
		end
	end
	for j=1,23 do
		local side=j%2==0 and -1 or 1
		local x=side*rng:NextNumber(218,302)
		local z=rng:NextNumber(-298,286)
		if z< -105 then z=60+(j%4)*56 end
		local scale=rng:NextNumber(0.85,1.25)
		-- Raised biomes supply their own vegetation at the correct heights.
		-- Avoid burying random ground-level trees/crystals inside the shelves.
		local onRaisedBiome=z> -25 and ((index==2 and x< -195) or (index~=2 and x>195))
		local inMiningCamp=index==2 and x>220 and x<300 and z>48 and z<178
		if not onRaisedBiome and not inMiningCamp then grove(offset+V(x,0.3,z),scale,j) end
	end
	for j=1,10 do
		local x=-166+(j-1)*37
		local z=-291+(j%3)*5
		-- The personal-garden approach remains open through the meadow rim.
		if index~=1 or math.abs(x)>26 then grove(offset+V(x,0.3,z),0.92+(j%4)*0.095,j+23) end
	end
	for j=1,9 do
		grove(offset+V(-276+(j-1)*69,0.3,302+(j%2)*4),0.91+(j%3)*0.12,j+33)
	end
	local groundMaterial=index==1 and Enum.Material.Grass or index==2 and Enum.Material.Sandstone or Enum.Material.Slate
	for _,x in {-265,-109,111,267} do
		local z=math.abs(x)>200 and 295 or -294
		part(vegetation,"SculptedLandscapeMound",V(57,17,39),offset+V(x,-4.4,z),tints[index]:Lerp(P.darkStone,index==3 and 0.26 or 0.07),groundMaterial,Enum.PartType.Ball)
	end
	for j=1,9 do
		local x=-168+(j-1)*42
		local z=j%2==0 and -264 or 289
		if index~=1 or math.abs(x)>25 then
			for k=-1,1 do
				if index==3 then
					detail(vegetation,"QuartzShingle",V(7,2.6+(k%2)*1.1,6),offset+V(x+k*3.6,0.5,z+(k%2)*2.5),rgb(131,164,175):Lerp(P.cream,(j%3)*0.06),Enum.Material.Slate,Enum.PartType.Ball,CFrame.Angles(0,j*0.7,0))
				else
					detail(vegetation,"WoodlandShrub",V(7,5.4+(k%2)*1.3,7),offset+V(x+k*3.6,1.5,z+(k%2)*2.5),tints[index]:Lerp(P.ink,0.12+(j%2)*0.05),Enum.Material.Grass,Enum.PartType.Ball)
				end
			end
		end
	end
	for j=1,28 do
		local side=j%2==0 and -1 or 1
		local point=offset+V(side*rng:NextNumber(222,315),0.35,rng:NextNumber(-290,290))
		if index==3 then
			for pebble=1,3 do
				detail(vegetation,"PolishedCovePebble",V(1.7,0.7,1.2),point+V((pebble-2)*1.6,0.2,(pebble%2)*1.3),rgb(169,195,197):Lerp(P.cream,(j%3)*0.08),Enum.Material.Pebble,Enum.PartType.Ball,CFrame.Angles(0,j,0))
			end
		else
			for blade=1,3 do
				detail(vegetation,"GrassTuft",V(0.3,1.6+(blade%2)*0.4,1.1),point+V((blade-2)*0.45,0.6,0),tints[index]:Lerp(P.cream,0.12),Enum.Material.Grass,"Wedge",CFrame.Angles(0,j,0.1*(blade-2)))
			end
			if j%3==0 then flowerCluster(vegetation,point,index==1 and rgb(229,202,155) or rgb(220,164,119)) end
		end
	end
	for _,side in {-1,1} do
		part(vegetation,"LandscapedMound",V(64,19,57),offset+V(side*294,-4,-285),tints[index]:Lerp(P.darkStone,index==3 and 0.25 or 0),groundMaterial,Enum.PartType.Ball)
		bench(vegetation,offset+V(side*126,0.3,-171))
		for j=1,12 do
			if side<0 or index==3 or j<12 then part(vegetation,"GardenTrailPaver",V(13.0,0.15,8),offset+V(side*(32+j*14),0.42,-171),P.stone,Enum.Material.Slate,nil,CFrame.Angles(0,(j%2)*0.045,0)) end
		end
		for j=1,3 do
			if side<0 or index==3 then part(vegetation,"LandmarkApproachPaver",V(13,0.15,8),offset+V(side*(200+j*13),0.42,-171),P.stone,Enum.Material.Slate) end
		end
	end
	local trails=folder(vegetation,"LandmarkTrails")
	if index==1 then
		-- The bridge runs along Z; approach its open near end instead of the
		-- midpoint of the pond. Small stairs meet the raised wooden decking.
		for j=1,3 do part(trails,"PondApproachPaver",V(9,0.16,11),offset+V(192,0.44,-171+j*10),P.stone,Enum.Material.Slate) end
		for j=1,3 do part(trails,"BridgeApproachPaver",V(13,0.16,8),offset+V(193+j*14,0.44,-138),P.stone,Enum.Material.Slate) end
		for j=1,4 do part(trails,"BridgeEntranceStep",V(14,0.48,2.5),offset+V(235,0.38+j*0.48,-136-j*2.5),P.lightWood,Enum.Material.WoodPlanks) end
	elseif index==2 then
		for j=1,3 do part(trails,"ArchiveApproachPaver",V(10,0.16,11),offset+V(-239,0.43,-171-j*9),P.stone,Enum.Material.Slate) end
		for j=1,4 do part(trails,"OasisShorePaver",V(11,0.16,9),offset+V(194,0.43,-171-j*10),P.stone,Enum.Material.Slate) end
		for j=1,6 do part(trails,"OasisCanopyPaver",V(12,0.16,8),offset+V(194+j*14,0.43,-214),P.stone,Enum.Material.Slate) end
	else
		for j=1,5 do part(trails,"ObservatorySidePaver",V(10,0.16,11),offset+V(-196,0.44,-171-j*10),P.stone,Enum.Material.Slate) end
		for j=1,3 do part(trails,"ObservatoryEntrancePaver",V(13,0.16,9),offset+V(-196-j*14,0.44,-222),P.stone,Enum.Material.Slate) end
		for j=1,3 do part(trails,"CoveApproachPaver",V(11,0.16,9),offset+V(198+j*12,0.44,-164),P.stone,Enum.Material.Slate) end
		for j=1,3 do part(trails,"CovePierEntranceStep",V(12,0.4,2.7),offset+V(235,0.45+j*0.36,-160-j*2.7),rgb(191,198,184),Enum.Material.WoodPlanks) end
	end
	local landmarks=folder(parent,"Landmarks")
	if index==1 then
		windmill(landmarks,offset+V(-246,0.3,-186))
		pond(landmarks,offset+V(235,0.4,-171),false)
	elseif index==2 then
		sunRuins(landmarks,offset+V(-240,0.3,-190))
		local oasis=pond(landmarks,offset+V(232,0.4,-174),true)
		for j=1,5 do
			local a=j*math.pi*2/5
			tree(oasis,offset+V(232+math.sin(a)*47,0.3,-174+math.cos(a)*34),1.0,2,tints[index],a)
		end
		part(oasis,"OasisCanopy",V(20,0.45,14),offset+V(287,10,-207),rgb(202,154,109),Enum.Material.Fabric)
		for _,x in {279,295} do part(oasis,"CanopyPost",V(0.7,10,0.7),offset+V(x,5,-207),P.wood) end
	else
		observatory(landmarks,offset+V(-240,0.3,-190))
		crystalCove(landmarks,offset+V(235,0.3,-203))
	end
end

local function centralHub(parent,result)
	local hub=folder(parent,"CloverVillage")
	part(hub,"VillagePlaza",V(200,0.2,104),V(0,0.42,-129),rgb(190,191,158),Enum.Material.Cobblestone)
	part(hub,"PlazaInlay",V(192,0.04,96),V(0,0.54,-129),rgb(210,207,175),Enum.Material.Slate)
	part(hub,"CentralWalkway",V(22,0.2,150),V(0,0.44,-76),rgb(218,211,180),Enum.Material.Cobblestone)
	for _,side in {-1,1} do
		part(hub,"ShopApproach",V(70,0.18,16),V(side*43,0.45,-88),rgb(218,211,180),Enum.Material.Cobblestone)
		for j=1,5 do detail(hub,"WalkwayInset",V(0.6,0.06,6),V(side*11,0.57,-132+j*25),rgb(177,172,138)) end
		lamp(hub,V(side*105,0.3,-97),rgb(255,229,179),false)
		lamp(hub,V(side*105,0.3,-159),rgb(255,229,179),false)
		flowerCluster(hub,V(side*93,0.55,-113),rgb(236,192,143))
	end
	fountain(hub,V(0,0.55,-150),rgb(114,183,178))
	shop(hub,V(-64,0,-66),true); shop(hub,V(64,0,-66),false)
	local sell=folder(hub,"TradingStation")
	local sellPad=part(sell,"SellArea",V(30,0.3,20),V(-64,0.65,-118),rgb(196,174,114),Enum.Material.Slate)
	part(sell,"TradingCounter",V(17,2.3,4),V(-64,2,-124),P.wood,Enum.Material.WoodPlanks)
	disk(sell,"TradingScalePan",V(-64,3.7,-124),2.1,0.2,P.brass,Enum.Material.Metal)
	part(sell,"ScaleBalance",V(0.4,4.0,0.4),V(-64,5.3,-124),P.brass,Enum.Material.Metal)
	part(sell,"ScaleBeam",V(7,0.3,0.3),V(-64,7.2,-124),P.brass,Enum.Material.Metal)
	plaque(sell,V(-64,6,-130),"Trading post","Review your creature before selling",P.cream,25)
	crate(sell,V(-84,0.3,-118),0.85)
	StationKeeper.create(sell,CFrame.new(-69,0.3,-128.5)*CFrame.Angles(0,math.pi,0),"Sell")
	local home=part(hub,"HomePad",V(24,0.25,19),V(0,0.66,-106),rgb(164,194,143),Enum.Material.Slate)
	plaque(hub,V(0,5.3,-112),"Brainrot Bloom","Find it · feed it · watch it flourish",P.cream,24)
	result.spawnCFrame=CFrame.new(0,5,-91)*CFrame.Angles(0,math.pi,0)
	result.destinations.Home=result.spawnCFrame
	result.destinations.Food=CFrame.new(-64,5,-86)*CFrame.Angles(0,math.pi,0)
	result.destinations.Gear=CFrame.new(64,5,-86)*CFrame.Angles(0,math.pi,0)
	result.destinations.Sell=CFrame.new(-64,5,-113)
	local spawn=Instance.new("SpawnLocation"); spawn.Name="GardenSpawn"; spawn.Size=V(8,0.2,8)
	spawn.CFrame=CFrame.new(0,0.85,-91); spawn.Anchored=true; spawn.Transparency=1; spawn.CanCollide=false; spawn.Neutral=true; spawn.Duration=0; spawn.Parent=hub
	-- The old rarity showcase is now an open village green, with a clear route
	-- from the shops through the rock arch to the personal gardens.
	local green=folder(hub,"VillageGreen")
	part(green,"GardenNeighborhoodPath",V(18,0.18,148),V(0,0.43,-255),rgb(212,207,175),Enum.Material.Cobblestone)
	for _,side in {-1,1} do
		part(green,"GreenSidePath",V(89,0.15,12),V(side*49,0.42,-225),rgb(212,207,175),Enum.Material.Cobblestone)
		lamp(green,V(side*16,0.3,-260),rgb(255,229,179),false)
		for j=1,4 do flowerCluster(green,V(side*(28+j*16),0.4,-198),rgb(233,205,158)) end
	end
	part(green,"PortalDirectionPost",V(0.6,5.7,0.6),V(17,3.15,-278),P.darkWood,Enum.Material.Wood)
	plaque(green,V(17,6.6,-278.4),"WORLD PORTAL  ↑","Through the village · follow the turquoise trail",rgb(164,237,224),26)
	local gazebo=folder(green,"CloverGazebo")
	local center=V(-68,0.3,-237)
	disk(gazebo,"GazeboStoneBase",center+V(0,0.3,0),19,0.6,P.stone,Enum.Material.Cobblestone)
	disk(gazebo,"GazeboDeck",center+V(0,0.67,0),17.6,0.2,P.lightWood,Enum.Material.WoodPlanks)
	for j=1,6 do
		local a=j*math.pi/3
		part(gazebo,"GazeboColumn",V(0.7,11.6,0.7),center+V(math.sin(a)*15.6,6.4,math.cos(a)*15.6),P.darkWood,Enum.Material.Wood)
	end
	for _,side in {-1,1} do
		part(gazebo,"GazeboRoofSlope",V(22,0.6,38),center+V(side*8.8,14.4,0),rgb(126,157,124),Enum.Material.WoodPlanks,nil,CFrame.Angles(0,0,side*-0.33))
	end
	part(gazebo,"GazeboRidge",V(0.8,0.8,40),center+V(0,17.9,0),P.darkWood,Enum.Material.Wood)
	for j=1,2 do part(gazebo,"GazeboEntryStep",V(15,0.25,2.5),center+V(0,j*0.25,-20+j*2),P.lightWood,Enum.Material.WoodPlanks) end
	bench(gazebo,center+V(-7,0.8,5));bench(gazebo,center+V(5,0.8,5))
	local brook=detail(green,"VillageBrook",V(15,0.22,72),V(68,0.49,-240),rgb(112,179,174),Enum.Material.Glass)
	brook.Transparency=0.2
	for j=1,10 do
		local z=-272+j*6.5
		for _,side in {-1,1} do detail(green,"BrookEdgeStone",V(4,1.3,4.5),V(68+side*8.1,0.65,z),rgb(151,164,143),Enum.Material.Slate,Enum.PartType.Ball) end
	end
	for j=0,12 do part(green,"VillageBrookCrossing",V(2.6,0.25,12),V(51+j*2.7,0.88,-225),P.lightWood,Enum.Material.WoodPlanks) end
	for _,z in {-231.3,-218.7} do
		part(green,"BrookCrossingRail",V(37,0.3,0.3),V(68,3.6,z),P.darkWood,Enum.Material.Wood)
		for _,x in {51,68,85} do part(green,"BrookCrossingPost",V(0.4,2.8,0.4),V(x,2.2,z),P.darkWood,Enum.Material.Wood) end
	end
end

function World.startDayNight()
	if cycleStarted then return end
	cycleStarted=true
	Lighting.ClockTime=9; Lighting.Brightness=2.1; Lighting.GlobalShadows=true
	Lighting.Ambient=rgb(102,113,141); Lighting.OutdoorAmbient=rgb(138,151,164)
	local atmosphere=Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density=0.19; atmosphere.Color=rgb(205,232,255); atmosphere.Decay=rgb(161,186,211); atmosphere.Parent=Lighting
	task.spawn(function()
		local start=os.clock()
		while true do Lighting.ClockTime=(9+(os.clock()-start)/30)%24;task.wait(0.5) end
	end)
end

function World.build(config)
	local old=Workspace:FindFirstChild("BrainrotWorld"); if old then old:Destroy() end
	local scene=folder(Workspace,"BrainrotWorld")
	-- FallenPartsDestroyHeight is intentionally configured in the place file:
	-- normal server scripts lack the PluginOrOpenCloud capability to set it.
	local ocean=detail(scene,"Ocean",V(4000,3,1600),V(1040,-20,0),rgb(67,137,157),Enum.Material.Glass)
	ocean.Transparency=0.16
	local result={destinations={},pits={}}
	local ids={"Meadow","Dunes","Cosmic"}
	local grass={rgb(117,158,106),rgb(190,145,102),rgb(126,171,174)}
	local sand={rgb(225,211,173),rgb(224,174,119),rgb(195,216,215)}
	local rng=Random.new(74119)
	for index,id in ids do
		local island=Instance.new("Model"); island.Name=id; island.Parent=scene
		local offset=V((index-1)*1040,0,0)
		shoreline(island,offset,index)
		naturalBoundary(island,offset,index)
		local groundMaterial=index==1 and Enum.Material.Grass or index==2 and Enum.Material.Sandstone or Enum.Material.Slate
		-- A lower full-size base plus four surrounding lawns leaves a real
		-- recessed sand basin instead of laying the sand on top of the grass.
		part(island,"Grass",V(700,6,660),offset+V(0,-7,0),grass[index],groundMaterial)
		part(island,"NorthernLawn",V(700,6,320),offset+V(0,-2.7,-170),grass[index],groundMaterial)
		part(island,"SouthernLawn",V(700,6,60),offset+V(0,-2.7,300),grass[index],groundMaterial)
		for _,side in {-1,1} do part(island,"SideLawn",V(190,6,280),offset+V(side*255,-2.7,130),grass[index],groundMaterial) end
		local center,size=digSite(island,offset,sand[index],id)
		result.pits[id]={center=center,size=size}
		result.destinations[id]=CFrame.new(offset+V(0,4,7))*CFrame.Angles(0,math.pi,0)
		part(island,"ExpeditionWalkway",V(22,0.18,146),offset+V(0,0.44,-91),rgb(207,203,170),Enum.Material.Cobblestone)
		local name=config.Worlds[index] and config.Worlds[index].name or id
		plaque(island,offset+V(39,4.3,-26),name,"Choose Dig while standing in the sand",P.cream,24)
		landscapes(island,offset,index,rng)
		layeredBiomes(island,offset,index)
		-- The travel landmark sits directly on the main avenue between the
		-- village and pit, with a trail visible from either approach.
		PortalFactory.create(island,offset+V(0,0,-35),id,config.Worlds[index].color)
		local trail=folder(island,"PortalWayfinding")
		for _,z in {-103,-80,-57} do
			for _,side in {-1,1} do
				local marker=detail(trail,"PortalTrailChevron",V(0.45,0.035,3.5),offset+V(side*1.05,0.56,z),rgb(107,207,193),Enum.Material.Neon,nil,CFrame.Angles(0,-side*0.65,0))
				marker.CanQuery=false
			end
		end
	end
	centralHub(scene,result)
	result.gardens=GardenService.build(scene,config)
	gardenBoundary(scene:FindFirstChild("GardenNeighborhood"))
	World.startDayNight()
	return result
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="16">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="17">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="EnableMouseLockOption">false</bool>
      <token name="GameSettingsAvatar">0</token>
    </Properties>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">BrainrotClient</string>
        </Properties>
        <Item class="LocalScript" referent="20">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client presentation only. Inventory, purchases, digging, and rewards are server-owned.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("BrainrotShared")
local Config = require(shared:WaitForChild("Config"))
local CreatureFactory = require(shared:WaitForChild("CreatureFactory"))
local remotes = ReplicatedStorage:WaitForChild("BrainrotRemotes")
local Action = remotes:WaitForChild("Action")
local State = remotes:WaitForChild("State")
local Notify = remotes:WaitForChild("Notify")

-- Soft paper, deep evergreen and restrained brass keep the scenery in focus.
local C = {
	bg = Color3.fromRGB(25, 43, 39), panel = Color3.fromRGB(246, 247, 240),
	card = Color3.fromRGB(255, 255, 250), light = Color3.fromRGB(232, 238, 227),
	text = Color3.fromRGB(34, 52, 45), muted = Color3.fromRGB(94, 112, 102),
	lime = Color3.fromRGB(195, 221, 175), green = Color3.fromRGB(65, 111, 85),
	gold = Color3.fromRGB(139, 98, 42), red = Color3.fromRGB(168, 75, 65),
	paper = Color3.fromRGB(255, 254, 246), honey = Color3.fromRGB(238, 206, 141),
	line = Color3.fromRGB(210, 221, 207), alert = Color3.fromRGB(243, 161, 153),
}

local state = nil
local activePage = nil
local selectedUid = nil
local gearTab = "Detectors"
local chosenQuantity = 1
local collectionSort = "Income"
local collectionFilter = "All"
local collectionQuery = ""
local collectionPageIndex = 1
local collectionPageSize = 12
local indexRarityFilter = "All"
local selectedGardenSlot = 1
local selectedGardenUid = nil
local panelRestPosition = UDim2.fromScale(0.5, 0.49)
local busy = false
local capture = nil
local capturePending = false
local viewports = {}
local renderPage
local resize
local renderedSignature = nil
local request
local openPage
local startDig
local tapDig

local screen = Instance.new("ScreenGui")
screen.Name = "BrainrotBloom"
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.DisplayOrder = 10
screen.Parent = player:WaitForChild("PlayerGui")
screen:SetAttribute("MenuOpen", false)
screen:SetAttribute("Capturing", false)
screen:SetAttribute("Scanning", false)

local function make(class, props, parent)
	local obj = Instance.new(class)
	for key, value in pairs(props or {}) do obj[key] = value end
	obj.Parent = parent
	return obj
end
local function corner(obj, radius)
	make("UICorner", {CornerRadius = UDim.new(0, radius or 12)}, obj)
end
local function stroke(obj, color, transparency)
	return make("UIStroke", {Color = color or C.line, Transparency = transparency or 0, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, obj)
end
local function label(parent, text, size, color, props)
	local p = {
		BackgroundTransparency = 1, Text = text, TextColor3 = color or C.text,
		Font = Enum.Font.BuilderSans, TextSize = math.max(13, size or 16),
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
	}
	for key, value in pairs(props or {}) do p[key] = value end
	return make("TextLabel", p, parent)
end
local function button(parent, text, onClick, props)
	local p = {
		Text = text, Font = Enum.Font.BuilderSansMedium, TextSize = 14,
		TextColor3 = C.text, BackgroundColor3 = C.light, BorderSizePixel = 0,
		Size = UDim2.new(0, 140, 0, 44), AutoButtonColor = false,
	}
	for key, value in pairs(props or {}) do p[key] = value end
	if p.Size.Y.Scale==0 and p.Size.Y.Offset<44 then p.Size=UDim2.new(p.Size.X.Scale,p.Size.X.Offset,0,44) end
	local b = make("TextButton", p, parent)
	corner(b, 12)
	local border=stroke(b,C.green,0.9)
	border.Name="InteractionBorder"
	local hovering=false
	local function outline(alpha)
		TweenService:Create(border,TweenInfo.new(0.12),{Transparency=alpha}):Play()
	end
	b.MouseEnter:Connect(function() hovering=true;outline(0.52) end)
	b.MouseLeave:Connect(function() hovering=false;outline(0.9) end)
	b.MouseButton1Down:Connect(function() outline(0.15) end)
	b.MouseButton1Up:Connect(function() outline(hovering and 0.52 or 0.9) end)
	if onClick then b.Activated:Connect(onClick) end
	return b
end
local function padding(parent, amount)
	make("UIPadding", {PaddingLeft = UDim.new(0, amount), PaddingRight = UDim.new(0, amount),
		PaddingTop = UDim.new(0, amount), PaddingBottom = UDim.new(0, amount)}, parent)
end
local function vertical(parent, gap)
	return make("UIListLayout", {Padding = UDim.new(0, gap or 10), SortOrder = Enum.SortOrder.LayoutOrder}, parent)
end
local function row(parent, height)
	return make("Frame", {Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1}, parent)
end
local function card(parent, height)
	local frame = make("Frame", {Name="ContentCard",Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = C.card, BorderSizePixel = 0}, parent)
	corner(frame, 14)
	local border=stroke(frame,C.line,0.35)
	border.Name="CardBorder"
	return frame
end
local function cardColumns()
	-- Comfortable name/stat widths matter more than squeezing tiny cards onto
	-- portrait phones. Larger viewports still show two or three at a time.
	return math.clamp(math.floor((screen.AbsoluteSize.X*0.94-28)/190),1,3)
end
local function readable(tint)
	return tint:Lerp(C.text,0.64)
end
local function badge(parent, text, tint, position, size)
	local field=label(parent,text,13,readable(tint),{Position=position,Size=size,
		BackgroundColor3=tint:Lerp(C.paper,0.82),TextXAlignment=Enum.TextXAlignment.Center,
		Font=Enum.Font.BuilderSansMedium})
	corner(field,8)
	return field
end
local function icon(parent, kind, tint, position, size)
	local root=make("Frame",{Position=position,Size=size,BackgroundTransparency=1},parent)
	local function mark(x,y,w,h,round,rotation)
		local bit=make("Frame",{Position=UDim2.fromScale(x,y),Size=UDim2.fromScale(w,h),
			BackgroundColor3=tint,BorderSizePixel=0,Rotation=rotation or 0},root)
		bit:SetAttribute("TintIcon",true)
		if round then corner(bit,round) end
		return bit
	end
	if kind=="Collection" then
		mark(0.18,0.28,0.64,0.63,4);mark(0.32,0.08,0.36,0.12,3)
	elseif kind=="Food" then
		mark(0.2,0.32,0.62,0.6,8);mark(0.52,0.09,0.12,0.26,2,-20);mark(0.65,0.09,0.24,0.13,4,-24)
	elseif kind=="Sell" then
		mark(0.12,0.64,0.76,0.19,5);mark(0.2,0.39,0.6,0.18,5);mark(0.31,0.14,0.39,0.18,5)
	elseif kind=="Index" then
		mark(0.08,0.14,0.37,0.72,3,-3);mark(0.55,0.14,0.37,0.72,3,3)
		mark(0.47,0.13,0.06,0.76,1)
	elseif kind=="Garden" then
		mark(0.25,0.52,0.53,0.36,4);mark(0.2,0.49,0.63,0.1,3)
		mark(0.48,0.18,0.09,0.38,2);mark(0.2,0.19,0.29,0.16,5,22);mark(0.57,0.1,0.28,0.16,5,-22)
	elseif kind=="Gear" then
		mark(0.46,0.07,0.12,0.6,3,-28);mark(0.17,0.65,0.64,0.2,8);mark(0.54,0.1,0.25,0.12,2,-28)
	else
		mark(0.19,0.19,0.62,0.62,10);mark(0.42,0.04,0.16,0.25,2);mark(0.42,0.71,0.16,0.25,2)
	end
	return root
end
local function previewStage(parent,tint,position,size)
	local stage=make("Frame",{Name="SculptureStage",Position=position,Size=size,BackgroundColor3=tint:Lerp(C.paper,0.9),BorderSizePixel=0,ClipsDescendants=true},parent)
	corner(stage,12)
