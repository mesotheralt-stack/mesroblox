          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- All economy and content tuning lives here. No paid products or external assets.
local Config = {}
Config.StartCoins = 150
Config.MaxBrainrots = 50
Config.MaxPlayers = 6
Config.GardenSlots = 6
Config.MaxLevel = 100
Config.RotationSeconds = 300
Config.DigDuration = 10
Config.SearchSeconds = 1
Config.FindChance = 0.5

Config.Rarities = {
	{id = "Common", name = "Common", color = Color3.fromRGB(177, 191, 180), weight = 5800, multiplier = 1, taps = 6},
	{id = "Uncommon", name = "Uncommon", color = Color3.fromRGB(131, 227, 108), weight = 2600, multiplier = 2.5, taps = 9},
	{id = "Rare", name = "Rare", color = Color3.fromRGB(84, 180, 255), weight = 1100, multiplier = 7, taps = 12},
	{id = "Epic", name = "Epic", color = Color3.fromRGB(193, 133, 255), weight = 380, multiplier = 20, taps = 16},
	{id = "Legendary", name = "Legendary", color = Color3.fromRGB(255, 200, 74), weight = 100, multiplier = 60, taps = 20},
	{id = "Mythic", name = "Mythic", color = Color3.fromRGB(255, 112, 157), weight = 19, multiplier = 160, taps = 25},
	{id = "Secret", name = "Secret", color = Color3.fromRGB(131, 255, 237), weight = 1, multiplier = 500, taps = 30},
}

Config.Worlds = {
	{id = "Meadow", name = "Clover Commons", unlockCost = 0, minPower = 1, maxRarity = 4, color = Color3.fromRGB(139, 183, 127), description = "A sheltered clover valley beneath mossy chalk cliffs. Common through Epic discoveries."},
	{id = "Dunes", name = "Sunset Sands", unlockCost = 8000, minPower = 4, maxRarity = 6, color = Color3.fromRGB(219, 165, 111), description = "Warm sandstone canyons and a quiet oasis. Mythic creatures hide beneath the sand."},
	{id = "Cosmic", name = "Moonbloom Cove", unlockCost = 125000, minPower = 6, maxRarity = 7, color = Color3.fromRGB(137, 209, 206), description = "Turquoise tidal pools and lilac crystal groves. A tiny chance of a Secret discovery."},
}

Config.Detectors = {
	{id = "twig", name = "Tin Twig", power = 2, speed = 4, price = 0, world = "Meadow", color = Color3.fromRGB(163, 177, 159)},
	{id = "copper", name = "Copper Chirper", power = 3, speed = 3.5, price = 650, world = "Meadow", color = Color3.fromRGB(230, 160, 107)},
	{id = "clover", name = "Clover Scanner", power = 4, speed = 3, price = 4200, world = "Meadow", color = Color3.fromRGB(162, 237, 124)},
	{id = "sunbeam", name = "Sunbeam Seeker", power = 5, speed = 2.5, price = 16000, world = "Dunes", color = Color3.fromRGB(255, 208, 102)},
	{id = "prism", name = "Prism Pulse", power = 6, speed = 2, price = 70000, world = "Dunes", color = Color3.fromRGB(255, 143, 183)},
	{id = "moon", name = "Moonbeam Array", power = 7, speed = 1.4, price = 240000, world = "Cosmic", color = Color3.fromRGB(180, 156, 255)},
	{id = "void", name = "Void Whisperer", power = 7, speed = 0.8, price = 800000, world = "Cosmic", color = Color3.fromRGB(129, 255, 230)},
}

Config.Foods = {
	{id = "crumb", name = "Suspicious Crumb", emoji = "🍞", xp = 25, price = 15, stock = 24},
	{id = "carrot", name = "Crunchy Carrot", emoji = "🥕", xp = 60, price = 40, stock = 20},
	{id = "apple", name = "Wobble Apple", emoji = "🍎", xp = 110, price = 80, stock = 18},
	{id = "banana", name = "Bonkers Banana", emoji = "🍌", xp = 180, price = 150, stock = 16},
	{id = "cookie", name = "Chaos Cookie", emoji = "🍪", xp = 300, price = 280, stock = 14},
	{id = "taco", name = "Turbo Taco", emoji = "🌮", xp = 500, price = 500, stock = 12},
	{id = "donut", name = "Disco Donut", emoji = "🍩", xp = 800, price = 900, stock = 10},
	{id = "pizza", name = "Party Pizza", emoji = "🍕", xp = 1250, price = 1600, stock = 9},
	{id = "sushi", name = "Silly Sushi", emoji = "🍣", xp = 2000, price = 2800, stock = 8},
	{id = "burger", name = "Galaxy Burger", emoji = "🍔", xp = 3200, price = 5000, stock = 7},
	{id = "cake", name = "Cloud Cake", emoji = "🍰", xp = 5000, price = 8500, stock = 6},
	{id = "melon", name = "Meteor Melon", emoji = "🍉", xp = 7500, price = 14000, stock = 5},
	{id = "honey", name = "Mythic Honey", emoji = "🍯", xp = 11000, price = 23000, stock = 4},
	{id = "star", name = "Stardust Sorbet", emoji = "🍨", xp = 16000, price = 36000, stock = 3},
	{id = "feast", name = "Secret Midnight Feast", emoji = "🍱", xp = 24000, price = 60000, stock = 2},
}

Config.Boosts = {
	Growth = {name = "Growth Juice", price = 500, duration = 300},
	Income = {name = "Golden Hour", price = 1000, duration = 300},
}

-- Original names and procedural silhouettes; every species has its own palette.
Config.Creatures = {
	{id = "sprout", name = "Sproutini Spaghetti", rarity = "Common", color = Color3.fromRGB(144, 211, 113), accent = Color3.fromRGB(255, 226, 135), shape = "sprout"},
	{id = "toast", name = "Toasto Bamboozlo", rarity = "Common", color = Color3.fromRGB(231, 171, 109), accent = Color3.fromRGB(255, 230, 168), shape = "toast"},
	{id = "pebble", name = "Pebblino Wobblino", rarity = "Common", color = Color3.fromRGB(172, 185, 201), accent = Color3.fromRGB(249, 176, 188), shape = "rock"},
	{id = "croissant", name = "Croissantino Butterbello", rarity = "Common", color = Color3.fromRGB(224, 164, 95), accent = Color3.fromRGB(255, 224, 163), shape = "croissant"},
	{id = "frog", name = "Froggolini Ravioli", rarity = "Uncommon", color = Color3.fromRGB(111, 211, 127), accent = Color3.fromRGB(255, 226, 130), shape = "frog"},
	{id = "mushroom", name = "Mushmello Jellino", rarity = "Uncommon", color = Color3.fromRGB(255, 174, 199), accent = Color3.fromRGB(255, 246, 217), shape = "mushroom"},
	{id = "bee", name = "Buzzetti Confetti", rarity = "Uncommon", color = Color3.fromRGB(255, 207, 92), accent = Color3.fromRGB(97, 76, 63), shape = "bee"},
	{id = "snail", name = "Snailini Pistachio", rarity = "Uncommon", color = Color3.fromRGB(171, 205, 139), accent = Color3.fromRGB(238, 177, 139), shape = "snail"},
	{id = "shark", name = "Sharkuccino Slippers", rarity = "Rare", color = Color3.fromRGB(111, 181, 236), accent = Color3.fromRGB(255, 210, 129), shape = "shark"},
	{id = "cactus", name = "Cactini Linguini", rarity = "Rare", color = Color3.fromRGB(94, 195, 161), accent = Color3.fromRGB(255, 145, 197), shape = "cactus"},
	{id = "cloud", name = "Cloudolini Macaroni", rarity = "Rare", color = Color3.fromRGB(188, 225, 255), accent = Color3.fromRGB(140, 150, 245), shape = "cloud"},
	{id = "teapot", name = "Teapotelli Chamomillo", rarity = "Rare", color = Color3.fromRGB(153, 202, 214), accent = Color3.fromRGB(249, 211, 139), shape = "teapot"},
	{id = "octopus", name = "Octopesto Presto", rarity = "Epic", color = Color3.fromRGB(189, 138, 242), accent = Color3.fromRGB(255, 208, 143), shape = "octopus"},
	{id = "disco", name = "Disco Dodo Deluxe", rarity = "Epic", color = Color3.fromRGB(239, 133, 220), accent = Color3.fromRGB(139, 245, 219), shape = "bird"},
	{id = "wizard", name = "Wizzaroni Pepperoni", rarity = "Epic", color = Color3.fromRGB(160, 142, 240), accent = Color3.fromRGB(255, 210, 109), shape = "wizard"},
	{id = "turtle", name = "Turtellini Terrarium", rarity = "Epic", color = Color3.fromRGB(109, 190, 172), accent = Color3.fromRGB(215, 169, 238), shape = "turtle"},
	{id = "lion", name = "Lionardo Lemonardo", rarity = "Legendary", color = Color3.fromRGB(255, 208, 98), accent = Color3.fromRGB(224, 131, 76), shape = "lion"},
	{id = "dragon", name = "Dragolato Gelato", rarity = "Legendary", color = Color3.fromRGB(255, 164, 116), accent = Color3.fromRGB(158, 242, 195), shape = "dragon"},
	{id = "sun", name = "Solini Gnocchini", rarity = "Legendary", color = Color3.fromRGB(255, 227, 115), accent = Color3.fromRGB(255, 157, 110), shape = "sun"},
	{id = "koi", name = "Koiramisu Goldentino", rarity = "Legendary", color = Color3.fromRGB(250, 213, 132), accent = Color3.fromRGB(232, 131, 113), shape = "koi"},
	{id = "phoenix", name = "Phoeniccini Fettuccine", rarity = "Mythic", color = Color3.fromRGB(255, 116, 151), accent = Color3.fromRGB(255, 216, 126), shape = "phoenix"},
	{id = "moon", name = "Lunatici Mochi", rarity = "Mythic", color = Color3.fromRGB(202, 166, 255), accent = Color3.fromRGB(255, 194, 233), shape = "moon"},
	{id = "jelly", name = "Jellybean Astronautini", rarity = "Mythic", color = Color3.fromRGB(255, 160, 218), accent = Color3.fromRGB(164, 244, 255), shape = "jelly"},
	{id = "clock", name = "Ticktockini Eternelli", rarity = "Mythic", color = Color3.fromRGB(178, 161, 227), accent = Color3.fromRGB(246, 209, 138), shape = "clock"},
	{id = "void", name = "Voidolini Neveroni", rarity = "Secret", color = Color3.fromRGB(73, 62, 117), accent = Color3.fromRGB(130, 255, 224), shape = "void"},
	{id = "cosmic", name = "Cosmic Capybaroni", rarity = "Secret", color = Color3.fromRGB(153, 230, 218), accent = Color3.fromRGB(255, 220, 151), shape = "capybara"},
	{id = "crown", name = "Emperor Noodlestar", rarity = "Secret", color = Color3.fromRGB(220, 202, 255), accent = Color3.fromRGB(255, 218, 113), shape = "crown"},
	{id = "manta", name = "Mantaroni Nebulini", rarity = "Secret", color = Color3.fromRGB(100, 126, 195), accent = Color3.fromRGB(154, 245, 224), shape = "manta"},
}

function Config.get(list, id)
	for _, item in ipairs(list) do
		if item.id == id then return item end
	end
	return nil
end

function Config.xpNeeded(level: number): number
	return math.floor(40 + 18 * level ^ 1.2)
end

function Config.income(specId: string, level: number): number
	local spec = Config.get(Config.Creatures, specId)
	if not spec then return 0 end
	local rarity = Config.get(Config.Rarities, spec.rarity)
	local growth = math.clamp(level, 1, Config.MaxLevel) - 1
	return math.floor(2 * rarity.multiplier * (1 + growth * 0.24) ^ 1.15) + growth
end

function Config.sellValue(specId: string, level: number): number
	return Config.income(specId, level) * 45
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CreatureFactory</string>
          <string name="Source"><![CDATA[-- Original collectible sculptures. Every species has its own anatomy, proportions,
-- and face placement. Anchored geometry is shared by companions and ViewportFrames.
local CreatureFactory = {}
local V = Vector3.new
local A = CFrame.Angles
local ballShape = Enum.PartType.Ball

local function part(model, name, size, position, color, shape, rotation)
	local object = Instance.new(shape == "Wedge" and "WedgePart" or "Part")
	object.Name = name
	object.Size = size
	object.CFrame = CFrame.new(position) * (rotation or CFrame.new())
	object.Color = color
	object.Material = Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	if shape and shape ~= "Wedge" then object.Shape = shape end
	object.Parent = model
	return object
end

function CreatureFactory.create(spec, scale)
	local model = Instance.new("Model")
	model.Name = spec.name or "Brainrot"
	local base = spec.color or Color3.fromRGB(156, 215, 133)
	local trim = spec.accent or Color3.fromRGB(255, 217, 132)
	local ivory = Color3.fromRGB(255, 248, 226)
	local ink = Color3.fromRGB(30, 39, 43)
	local blush = Color3.fromRGB(247, 153, 147)
	local pale = base:Lerp(ivory, 0.43)
	local dark = base:Lerp(ink, 0.28)
	local shape = string.lower(spec.shape or "sprout")
	local function piece(name, size, position, color, kind, rotation)
		return part(model,name,size,position,color or base,kind,rotation)
	end
	local function orb(name, size, position, color, rotation)
		return piece(name,size,position,color,ballShape,rotation)
	end
	local function dot(name, position, radius, color)
		return orb(name,V(radius,radius,radius),position,color)
	end
	local function rod(name, a, b, width, color)
		local delta = b-a
		local length = delta.Magnitude
		if length < 0.001 then return dot(name,a,width,color) end
		-- A vertical segment needs a different up vector; a parallel default
		-- up vector produces a degenerate basis in CFrame implementations.
		local up = math.abs(delta.Y / length) > 0.98 and V(0,0,1) or V(0,1,0)
		return piece(name,V(width,width,length), (a+b)/2,color,nil,CFrame.lookAt(Vector3.zero,delta,up))
	end
	local function tube(name, points, width, color)
		for i=1,#points-1 do
			local thickness=width*(1-(i-1)/#points*0.52)
			rod(name,points[i],points[i+1],thickness,color)
			dot(name.."Joint",points[i],thickness*1.12,color)
		end
		dot(name.."Tip",points[#points],width*0.38,color)
	end
	local function ring(name, center, radius, thickness, color, plane, count)
		count = count or 12
		for i=1,count do
			local function at(t)
				if plane=="front" then return center+V(math.cos(t)*radius,math.sin(t)*radius,0) end
				return center+V(math.cos(t)*radius,0,math.sin(t)*radius)
			end
			rod(name,at((i-1)*math.pi*2/count),at(i*math.pi*2/count),thickness,color)
		end
	end
	local function flatTriangle(name,a,b,c,depth,color)
		-- Two right-triangle prisms fill a planar triangle exactly. Used for the
		-- moon's continuous crescent surface, with no scalloped overlapping balls.
		local ab=(b-a).Magnitude
		if (c-b).Magnitude>ab and (c-b).Magnitude>(c-a).Magnitude then a,b,c=b,c,a
		elseif (c-a).Magnitude>ab then a,b,c=c,a,b end
		local edge=b-a
		local length=edge.Magnitude
		if length<0.001 then return end
		local ux,uy=edge.X/length,edge.Y/length
		local projection=(c.X-a.X)*ux+(c.Y-a.Y)*uy
		local p=V(a.X+projection*ux,a.Y+projection*uy,a.Z)
		local height=(c-p).Magnitude
		if height<0.001 then return end
		local y=V((c.X-p.X)/height,(c.Y-p.Y)/height,0)
		for _,tip in {a,b} do
			local width=(p-tip).Magnitude
			if width>0.001 then
				local z=V((p.X-tip.X)/width,(p.Y-tip.Y)/width,0)
				local x=V(0,0,y.X*z.Y-y.Y*z.X)
				local center=p+y*(height/2)-z*(width/2)
				piece(name,V(depth,height,width),center,color,"Wedge",CFrame.fromMatrix(Vector3.zero,x,y,z))
			end
		end
	end
	local function eye(name, position, size, color)
		orb(name.."White",V(size,size*1.14,size*0.48),position,ivory)
		-- A coloured iris stays distinct from the pupil at collection-card sizes.
		local iris=orb(name.."Iris",V(size*0.62,size*0.73,size*0.17),position+V(0.025,-0.01,-size*0.25),color or base:Lerp(ink,0.58))
		iris.Material=Enum.Material.Glass
		iris.Reflectance=0.06
		orb(name.."Pupil",V(size*0.28,size*0.49,size*0.11),position+V(0.035,-0.01,-size*0.33),ink)
		dot(name.."Catchlight",position+V(-size*0.08,size*0.17,-size*0.4),size*0.17,ivory)
		-- A soft upper rim and second reflection add depth without changing
		-- the species' face placement or adding expensive effects.
		orb(name.."UpperLid",V(size*1.08,size*0.16,size*0.27),position+V(0,size*0.49,size*0.06),dark)
		dot(name.."SoftReflection",position+V(size*0.15,-size*0.17,-size*0.4),size*0.075,ivory)
	end
	local function face(position, separation, size, happy)
		for _,side in {-1,1} do
			eye(side<0 and "LeftEye" or "RightEye",position+V(side*separation,0,0),size)
			orb("Cheek",V(size*0.48,size*0.21,0.1),position+V(side*(separation+size*0.32),-size*0.54,0.05),blush)
		end
		if happy then
			orb("HappyMouth",V(size*0.48,size*0.35,0.15),position+V(0,-size*0.65,-0.1),ink)
			orb("Tongue",V(size*0.3,size*0.11,0.07),position+V(0,-size*0.74,-0.19),blush)
		else
			orb("Smile",V(size*0.5,0.09,0.12),position+V(0,-size*0.65,-0.1),ink)
		end
	end
	local function foot(position, size, color, claws)
		orb("Paw",size,position,color or trim)
		orb("PawSole",V(size.X*0.94,size.Y*0.24,size.Z*0.96),position+V(0,-size.Y*0.32,0), (color or trim):Lerp(ink,0.17))
		if claws then
			for i=-1,1 do
				orb("Toe",V(size.X*0.19,size.Y*0.32,size.Z*0.3),position+V(i*size.X*0.24,-size.Y*0.12,-size.Z*0.37),ivory)
			end
		end
	end
	local root=piece("Root",V(0.15,0.15,0.15),Vector3.zero,base)
	root.Transparency=1
	model.PrimaryPart=root

	if shape=="toast" then
		-- A broad bread slice, with a true double-lobed crust and inset crumb.
		local crust=Color3.fromRGB(171,108,57)
		piece("CrustSlice",V(3.0,2.8,0.82),V(0,2.1,0),crust)
		for _,side in {-1,1} do
			orb("CrustLobe",V(1.75,1.25,0.84),V(side*0.67,3.42,0),crust)
			orb("BreadLobe",V(1.47,1.0,0.12),V(side*0.64,3.4,-0.47),ivory:Lerp(trim,0.16))
			foot(V(side*0.75,0.4,-0.08),V(0.87,0.5,1.15),trim,false)
			orb("Mitten",V(0.55,0.7,0.5),V(side*1.7,1.9,-0.05),trim)
		end
		piece("SoftCrumb",V(2.62,2.65,0.14),V(0,2.11,-0.48),ivory:Lerp(trim,0.15))
		for i=1,9 do
			local x=((i*5)%11-5)*0.22
			dot("ToastPore",V(x,1.1+(i%4)*0.61,-0.58),0.08+(i%2)*0.04,crust:Lerp(ivory,0.39))
		end
		face(V(0,2.55,-0.61),0.58,0.55,true)
		piece("ButterPat",V(0.87,0.19,0.64),V(0.38,3.96,0),trim,nil,A(0,0.18,0.06))
		orb("MeltedButter",V(0.5,0.65,0.11),V(0.75,3.5,-0.6),trim)
		for i=1,3 do rod("BreadScoring",V(-0.93+(i-1)*0.31,3.35,-0.56),V(-0.72+(i-1)*0.31,3.6,-0.56),0.055,crust:Lerp(ivory,0.7)) end
	elseif shape=="sprout" then
		-- A ceramic pasta planter carrying a leaf-headed noodle creature.
		local pot=Color3.fromRGB(197,132,91)
		piece("PlanterBase",V(1.65,0.27,1.65),V(0,0.24,0),pot)
		piece("PlanterBowl",V(1.95,1.02,1.75),V(0,0.85,0),pot)
		piece("PlanterRim",V(2.2,0.23,1.98),V(0,1.41,0),pot:Lerp(ivory,0.15))
		piece("PotSoil",V(1.78,0.12,1.5),V(0,1.56,0),Color3.fromRGB(93,73,49))
		for i=1,7 do
			local a=i*math.pi*2/7
			tube("PastaCurl",{V(math.cos(a)*0.6,1.65,math.sin(a)*0.5),V(math.cos(a)*0.78,2.05,math.sin(a)*0.62),V(math.cos(a)*0.44,2.45,math.sin(a)*0.42)},0.2,trim)
		end
		orb("SproutHead",V(1.8,1.6,1.3),V(0,2.87,0),base)
		face(V(0,3.05,-0.64),0.38,0.47,false)
		tube("SproutStalk",{V(0,3.52,0),V(-0.12,4.0,0.05),V(0.07,4.4,0)},0.17,dark)
		for _,side in {-1,1} do
			orb("LeafBlade",V(1.65,0.34,0.88),V(side*0.72,4.32,0),base,nil)
			rod("LeafVein",V(side*0.1,4.5,-0.02),V(side*1.35,4.48,-0.02),0.05,pale)
			orb("PlanterHandle",V(0.34,0.65,0.55),V(side*1.12,1.05,0),pot)
		end
		piece("PotLabel",V(0.66,0.38,0.09),V(0,0.85,-0.91),ivory)
	elseif shape=="rock" then
		orb("LowStone",V(2.8,1.15,2.1),V(0,0.69,0),dark,A(0,0.12,0.1))
