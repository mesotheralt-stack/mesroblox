{
  "name": "Brainrot Bloom",
  "tree": {
    "$className": "DataModel",
    "Players": { "$properties": { "MaxPlayersInternal": 6 } },
    "ReplicatedStorage": {
      "BrainrotShared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "BrainrotServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": { "CameraMaxZoomDistance": 60, "CameraMinZoomDistance": 8 },
      "StarterPlayerScripts": { "BrainrotClient": { "$path": "src/client" } }
    },
    "Workspace": {
      "$properties": { "Gravity": 196.2, "StreamingEnabled": false, "FallenPartsDestroyHeight": -100 }
    },
    "Lighting": {
      "$properties": { "Brightness": 2, "ClockTime": 10, "GlobalShadows": true }
    },
    "SoundService": { "$properties": { "RespectFilteringEnabled": true } }
  }
}
